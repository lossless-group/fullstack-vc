# build output
dist/
.astro/

# secrets
private/
*.pem

# Working files with PII (registrant CSVs, personal-contact notes).
# Anything under context-v/extra/ stays local-only — public repo, real emails.
context-v/extra/
context-v/extra/*

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment
.env
.env.production
.env.local

# macOS
.DS_Store

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# build artifacts
.vercel/
.netlify/

# Astro DB bundler temp artifacts
db.timestamp-*.mjs

# Affinity Designer / Photo / Publisher lock files — created while file is open in the editor
*~lock~

# Processed image staging — CDN is the source of truth for served bytes
.image-staging/
