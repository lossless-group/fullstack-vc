---
// SSR (not prerendered) so DB-only OAuth signups get a working profile page.
// Signup no longer commits a participant markdown file (that flow was removed —
// see lib/user-record.ts), so a curated markdown file may not exist. We render
// from the file when present (source of truth) and fall back to the Turso
// User + Stack tables otherwise. This is the fix for Bug 3 in
// context-v/issue-resolutions/Auth-Identity-System-Worked-but-UX-Failed-Silent-Bounces.md
// (the route used to 404 for everyone without a markdown file).
export const prerender = false;

import { getCollection } from 'astro:content';
import { db, User, Stack, eq, asc } from 'astro:db';
import BaseThemeLayout from '../../layouts/BaseThemeLayout.astro';
import ParticipantStackView from '../../components/stack/ParticipantStackView.astro';
import { verifySession, SESSION_COOKIE_NAME } from '../../lib/session';

interface ProfileData {
  handle: string;
  name: string;
  firm?: string;
  role?: string;
  kauffman_class?: number | null;
  github?: string;
  github_avatar?: string;
  headshot?: string;
  linkedin?: string;
  publish: boolean;
  current_stack: Array<{ tool: string; added?: Date; notes?: string }>;
  aspirational_stack: Array<{ tool: string; intent?: string }>;
  abandoned_stack: Array<{ tool: string; abandoned?: Date; reason?: string }>;
}

const { handle } = Astro.params;
if (!handle) return new Response('Not found', { status: 404 });

let p: ProfileData | null = null;

// 1. Curated markdown profile — source of truth when it exists.
const participants = await getCollection('participants');
const entry = participants.find(e => e.data.handle === handle);
if (entry) {
  const d = entry.data;
  p = {
    handle: d.handle,
    name: d.name,
    firm: d.firm,
    role: d.role,
    kauffman_class: d.kauffman_class,
    github: (d as any).github,
    github_avatar: d.github_avatar,
    headshot: d.headshot,
    linkedin: d.linkedin,
    publish: d.publish,
    current_stack: d.current_stack ?? [],
    aspirational_stack: d.aspirational_stack ?? [],
    abandoned_stack: d.abandoned_stack ?? [],
  };
} else {
  // 2. DB fallback — a User row whose github_handle matches this handle, with
  //    its Stack rows. Anonymous traffic for known markdown handles never
  //    reaches this branch, so the common path stays DB-free.
  try {
    const userRow = await db.select().from(User).where(eq(User.github_handle, handle)).get();
    if (userRow) {
      const rows = await db.select().from(Stack)
        .where(eq(Stack.handle, handle))
        .orderBy(asc(Stack.position))
        .all();
      p = {
        handle,
        name: userRow.name ?? handle,
        firm: userRow.firm ?? undefined,
        kauffman_class: userRow.kauffman_class,
        github: `https://github.com/${handle}`,
        github_avatar: userRow.avatar ?? `https://github.com/${handle}.png`,
        // No publish column on User yet, so DB-only profiles default to private:
        // the owner sees their own stack (below), the public sees the stub. Once
        // the editor's "make public" toggle is wired to persist, gate on that.
        publish: false,
        current_stack: rows.filter(r => r.bucket === 'current')
          .map(r => ({ tool: r.tool, added: r.added ?? undefined, notes: r.notes ?? undefined })),
        aspirational_stack: rows.filter(r => r.bucket === 'aspirational')
          .map(r => ({ tool: r.tool, intent: r.intent ?? undefined })),
        abandoned_stack: rows.filter(r => r.bucket === 'abandoned')
          .map(r => ({ tool: r.tool, abandoned: r.abandoned ?? undefined, reason: r.reason ?? undefined })),
      };
    }
  } catch (err) {
    // Turso unreachable — 404 rather than 500. A known markdown handle would
    // have rendered above without touching the DB.
    console.error('[people/[handle]] DB fallback failed:', err);
  }
}

if (!p) return new Response('Not found', { status: 404 });

// Owner detection — only when the profile isn't public, so an owner viewing
// their own unpublished profile sees their stack instead of the private stub.
// Anonymous viewers (no session cookie) skip this entirely.
let isOwner = false;
if (!p.publish) {
  const session = await verifySession(Astro.cookies.get(SESSION_COOKIE_NAME)?.value);
  if (session) {
    let viewerHandle: string | null = null;
    try {
      let row;
      if (session.provider === 'github') {
        row = await db.select().from(User).where(eq(User.github_handle, session.subject)).get();
      } else if (session.provider === 'linkedin') {
        row = await db.select().from(User).where(eq(User.linkedin_sub, session.subject)).get();
      } else if (session.provider === 'google') {
        row = await db.select().from(User).where(eq(User.google_sub, session.subject)).get();
      }
      viewerHandle = row?.github_handle ?? (session.provider === 'github' ? session.subject : null);
    } catch {
      viewerHandle = session.provider === 'github' ? session.subject : null;
    }
    isOwner = !!viewerHandle && viewerHandle.toLowerCase() === handle.toLowerCase();
  }
}

const showStack = p.publish || isOwner;
---

<BaseThemeLayout
  title={`${p.name} · FullStack VC`}
  description={p.firm ? `${p.name} (${p.firm}) — current, aspirational, and abandoned tools.` : `${p.name}'s public profile and tool stack.`}
  containerClass="px-6 py-12 max-w-5xl mx-auto"
>
  <a href="/people" class="back-link">← All people</a>

  <header class="participant-head">
    {(p.headshot ?? p.github_avatar) ? (
      <img class="participant-head__avatar" src={p.headshot ?? p.github_avatar} alt="" loading="eager" decoding="async" />
    ) : (
      <span class="participant-head__avatar participant-head__avatar--initials" aria-hidden="true">
        {p.name.split(/\s+/).slice(0, 2).map(n => n[0]?.toUpperCase()).join('')}
      </span>
    )}
    <div class="participant-head__id">
      <p class="participant-head__eyebrow">
        {p.kauffman_class && <span>Kauffman {p.kauffman_class}</span>}
        {p.kauffman_class && p.role && <span class="participant-head__sep">·</span>}
        {p.role && <span>{p.role}</span>}
      </p>
      <h1 class="participant-head__name">{p.name}</h1>
      {p.firm && <p class="participant-head__firm">{p.firm}</p>}
      <p class="participant-head__links">
        {p.github && <a href={p.github} target="_blank" rel="noopener noreferrer">GitHub</a>}
        {p.linkedin && <a href={p.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>}
      </p>
    </div>

    {/* Owner-only Edit CTA — hidden by default, revealed when /api/me
        reports the viewer's handle matches this profile. */}
    <a class="participant-head__edit" href={`/people/${p.handle}/stack/edit`} data-owner-edit hidden>
      Edit profile →
    </a>
  </header>

  {showStack ? (
    <ParticipantStackView
      currentStack={p.current_stack}
      aspirationalStack={p.aspirational_stack}
      abandonedStack={p.abandoned_stack}
      handle={p.handle}
    />
  ) : (
    <section class="private-stub">
      <h2>This profile is private</h2>
      <p>
        {p.name} hasn't opted in to a public stack page yet. Members can flip
        <code>publish: true</code> in their participant entry to share their stack with the community.
      </p>
    </section>
  )}
</BaseThemeLayout>

<style>
  .back-link {
    display: inline-block;
    font-family: var(--font-code);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color 150ms ease;
  }
  .back-link:hover { color: var(--color-primary); }

  .participant-head {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }
  .participant-head__avatar {
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-surface);
    border: 2px solid var(--color-primary);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primary) 14%, transparent);
    flex: 0 0 auto;
  }
  .participant-head__avatar--initials {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
  }
  .participant-head__id { min-width: 0; }
  .participant-head__eyebrow {
    margin: 0 0 0.375rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4375rem;
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }
  .participant-head__sep { opacity: 0.5; }
  .participant-head__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .participant-head__firm {
    margin: 0.3125rem 0 0;
    color: var(--color-primary);
    font-family: var(--font-code);
    font-size: 0.875rem;
  }
  .participant-head__links {
    margin: 0.625rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    font-family: var(--font-code);
    font-size: 0.8125rem;
  }
  .participant-head__links a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    transition: color 150ms ease;
  }
  .participant-head__links a:hover { color: var(--color-primary); }

  .private-stub {
    padding: 2rem;
    border-radius: 0.875rem;
    background: var(--fx-card-bg);
    border: 1px dashed var(--color-border);
    color: var(--color-text);
  }
  .private-stub h2 {
    margin: 0 0 0.625rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .private-stub p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.55;
  }
  .private-stub code {
    font-family: var(--font-code);
    font-size: 0.875em;
    padding: 0.125em 0.375em;
    border-radius: 0.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .participant-head__edit {
    margin-left: auto;
    align-self: flex-start;
    font-family: var(--font-code);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    text-decoration: none;
    padding: 0.4375rem 0.875rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 45%, transparent);
    border-radius: 0.5rem;
    transition: background-color 150ms ease, border-color 150ms ease;
  }
  .participant-head__edit:hover {
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    border-color: var(--color-primary);
  }
  .participant-head__edit[hidden] { display: none; }

  @media (max-width: 600px) {
    .participant-head { flex-direction: column; align-items: flex-start; }
    .participant-head__name { font-size: 1.625rem; }
    .participant-head__edit { margin-left: 0; }
  }
</style>

<script is:inline define:vars={{ pageHandle: p.handle }}>
  // Owner-only Edit affordances — page is prerendered, so we can't read the
  // session cookie at build time. After hydrate, hit /api/me and reveal every
  // [data-owner-edit] element on the page if the viewer's handle matches.
  (async () => {
    try {
      const res = await fetch('/api/me', { credentials: 'same-origin' });
      if (!res.ok) return;
      const data = await res.json();
      if (!data.loggedIn || !data.handle) return;
      if (data.handle.toLowerCase() !== String(pageHandle).toLowerCase()) return;
      for (const el of document.querySelectorAll('[data-owner-edit]')) {
        el.removeAttribute('hidden');
      }
    } catch {
      // /api/me unavailable — leave Edit hidden. Worst case: owner doesn't
      // see the inline shortcut; the header tooltip's stack card still links
      // them to the editor.
    }
  })();
</script>
