---
// Server-rendered. Auth gate. Hosts the StackBuilder Svelte island.
//
// The user must be logged in AND the URL handle must match their session subject.
// On match, we prefill the form from their existing participants/{handle}.md
// content collection entry (if any).

import { getCollection } from 'astro:content';
import { db, User, Stack, eq, asc } from 'astro:db';
import BaseThemeLayout from '../../../../layouts/BaseThemeLayout.astro';
import StackBuilder from '../../../../components/stack/StackBuilder.svelte';
import { verifySession, SESSION_COOKIE_NAME } from '../../../../lib/session';
import { matchesRoster } from '../../../../lib/oauth-roster';

export const prerender = false;

const { handle } = Astro.params;
if (!handle) return Astro.redirect('/people', 302);

const session = await verifySession(Astro.cookies.get(SESSION_COOKIE_NAME)?.value);
if (!session) {
  // Not logged in — bounce to login, then redirect back here after.
  return Astro.redirect(`/login?next=${encodeURIComponent(`/people/${handle}/stack/edit`)}`, 302);
}

// Only the owner can edit their own profile. The URL handle is a GitHub
// username (participant slug convention), so the gate is: "the User row
// reachable from this session has a github_handle matching the URL." Any
// provider sign-in works as long as that's true — Google/LinkedIn-only
// sessions can still edit if they've linked their GitHub via the
// link-while-logged-in flow.
let ownerRow;
try {
  if (session.provider === 'github') {
    ownerRow = await db.select().from(User).where(eq(User.github_handle, session.subject)).get();
  } else if (session.provider === 'linkedin') {
    ownerRow = await db.select().from(User).where(eq(User.linkedin_sub, session.subject)).get();
  } else if (session.provider === 'google') {
    ownerRow = await db.select().from(User).where(eq(User.google_sub, session.subject)).get();
  }
} catch {
  // DB unreachable — fall back to the legacy strict gate so a DB hiccup
  // doesn't lock everyone out, but still keeps non-github sessions out.
  if (session.provider !== 'github' || session.subject.toLowerCase() !== handle.toLowerCase()) {
    return Astro.redirect(`/people/${handle}`, 302);
  }
}
const ownerGithubHandle = ownerRow?.github_handle
  ?? (session.provider === 'github' ? session.subject : null);
if (!ownerGithubHandle || ownerGithubHandle.toLowerCase() !== handle.toLowerCase()) {
  return Astro.redirect(`/people/${handle}`, 302);
}

const rosterEntry = matchesRoster(session);
if (!rosterEntry) {
  return Astro.redirect(`/login/not-on-roster?provider=${session.provider}`, 302);
}

// Profile fields still come from the participant markdown — that hasn't moved.
// Stack data now comes from Turso (authoritative); the markdown gets refreshed
// by scripts/sync-stacks.ts on the operator's cadence and is what public
// /people/<handle> pages render.
const allParticipants = await getCollection('participants');
const existing = allParticipants.find(p => p.data.handle === handle);

const initialName        = existing?.data.name ?? rosterEntry.name ?? session.name ?? '';
const initialFirm        = existing?.data.firm ?? rosterEntry.firm ?? '';
const initialPublic      = existing?.data.publish ?? false;
const avatar = existing?.data.headshot ?? existing?.data.github_avatar ?? session.avatar;

// Hydrate stack buckets from Turso so the editor reflects in-progress edits
// (the markdown may be stale until the next sync).
let initialCurrent: Array<{ tool: string; added?: string; notes?: string }> = [];
let initialAspirational: Array<{ tool: string; intent?: string }> = [];
let initialAbandoned: Array<{ tool: string; abandoned?: string; reason?: string }> = [];
try {
  const stackRows = await db.select().from(Stack)
    .where(eq(Stack.handle, handle))
    .orderBy(asc(Stack.bucket), asc(Stack.position))
    .all();
  for (const r of stackRows) {
    if (r.bucket === 'current') {
      initialCurrent.push({
        tool: r.tool,
        added: r.added ? new Date(r.added).toISOString().slice(0, 10) : undefined,
        notes: r.notes ?? undefined,
      });
    } else if (r.bucket === 'aspirational') {
      initialAspirational.push({
        tool: r.tool,
        intent: r.intent ?? undefined,
      });
    } else if (r.bucket === 'abandoned') {
      initialAbandoned.push({
        tool: r.tool,
        abandoned: r.abandoned ? new Date(r.abandoned).toISOString().slice(0, 10) : undefined,
        reason: r.reason ?? undefined,
      });
    }
  }
} catch {
  // Turso unreachable or table not pushed — fall back to markdown so the
  // editor still works. Loses unsynced edits, which is the expected behavior
  // when the DB is gone.
  initialCurrent = (existing?.data.current_stack ?? []).map(s => ({
    tool: s.tool,
    added: s.added ? new Date(s.added).toISOString().slice(0, 10) : undefined,
    notes: s.notes,
  }));
  initialAspirational = (existing?.data.aspirational_stack ?? []).map(s => ({
    tool: s.tool,
    intent: (s as any).intent,
  }));
  initialAbandoned = (existing?.data.abandoned_stack ?? []).map(s => ({
    tool: s.tool,
    abandoned: (s as any).abandoned ? new Date((s as any).abandoned).toISOString().slice(0, 10) : undefined,
    reason: (s as any).reason,
  }));
}

// Linked-provider lookup — reuse the ownerRow already loaded by the gate
// (it's looked up by whichever provider sub the active session has, so it's
// correct regardless of which provider you're currently signed in via).
const providers = {
  github: !!ownerRow?.github_handle,
  linkedin: !!ownerRow?.linkedin_sub,
  google: !!ownerRow?.google_sub,
};
// Fallback: if ownerRow is missing (gate took the legacy strict path on DB
// hiccup), at least flag the active provider as connected so the panel
// doesn't show everything as disconnected.
if (!ownerRow) {
  providers[session.provider] = true;
}
---

<BaseThemeLayout
  title="Edit your stack · FullStack VC"
  description="Edit the tools you use, your firm, and your public profile."
  noindex={true}
  containerClass="px-6 py-12 max-w-3xl mx-auto"
>
  <a href={`/people/${handle}`} class="back-link">← View public profile</a>

  <StackBuilder
    client:load
    handle={handle}
    initialName={initialName}
    initialFirm={initialFirm}
    initialPublic={initialPublic}
    initialCurrent={initialCurrent}
    initialAspirational={initialAspirational}
    initialAbandoned={initialAbandoned}
    avatar={avatar}
  />

  <section class="auth-connections">
    <h2 class="auth-connections__title">Linked accounts</h2>
    <p class="auth-connections__lede">
      We get different signal from each — GitHub for what you build, LinkedIn for how the LP world sees you, Google for your firm domain.
      Connect more for richer Dojo discovery.
    </p>
    <ul class="auth-connections__list">
      <li class={`auth-connection ${providers.github ? 'is-linked' : ''}`}>
        <span class="auth-connection__name">GitHub</span>
        {providers.github ? (
          <span class="auth-connection__status">Connected</span>
        ) : (
          <a class="auth-connection__cta" href="/api/auth/github/login">Connect</a>
        )}
      </li>
      <li class={`auth-connection ${providers.linkedin ? 'is-linked' : ''}`}>
        <span class="auth-connection__name">LinkedIn</span>
        {providers.linkedin ? (
          <span class="auth-connection__status">Connected</span>
        ) : (
          <a class="auth-connection__cta" href="/api/auth/linkedin/login">Connect</a>
        )}
      </li>
      <li class={`auth-connection ${providers.google ? 'is-linked' : ''}`}>
        <span class="auth-connection__name">Google</span>
        {providers.google ? (
          <span class="auth-connection__status">Connected</span>
        ) : (
          <a class="auth-connection__cta" href="/api/auth/google/login">Connect</a>
        )}
      </li>
    </ul>
  </section>

  <p class="logout-row">
    <a class="logout-link" href="/api/auth/logout">Log out</a>
  </p>
</BaseThemeLayout>

<style>
  .back-link {
    display: inline-block;
    font-family: var(--font-code);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color 150ms ease;
  }
  .back-link:hover { color: var(--color-primary); }

  .auth-connections {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--fx-card-bg, transparent);
  }
  .auth-connections__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .auth-connections__lede {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .auth-connections__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .auth-connection {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    transition: border-color 150ms ease;
  }
  .auth-connection.is-linked {
    border-color: color-mix(in srgb, rgb(34, 197, 94) 40%, var(--color-border));
  }
  .auth-connection__name {
    font-family: var(--font-code);
    font-size: 0.875rem;
    color: var(--color-text);
  }
  .auth-connection__status {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgb(34, 197, 94);
  }
  .auth-connection__cta {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgb(245, 158, 11);
    text-decoration: none;
    padding: 0.25rem 0.625rem;
    border: 1px solid rgb(245, 158, 11);
    border-radius: 0.375rem;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .auth-connection__cta:hover {
    background: rgb(245, 158, 11);
    color: var(--color-background);
  }

  .logout-row {
    margin-top: 2rem;
  }
  .logout-link {
    color: var(--color-text-muted);
    font-family: var(--font-code);
    font-size: 0.8125rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .logout-link:hover { color: var(--color-primary); }
</style>
