// Backward-compat redirector. Old OAuth callback target — kept so existing
// bookmarks still work. Routing logic now lives in /me, which inspects the
// User row (not just the current cookie's provider) and routes accordingly.
import { verifySession, SESSION_COOKIE_NAME } from '../../lib/session';

const session = await verifySession(Astro.cookies.get(SESSION_COOKIE_NAME)?.value);
if (!session) return Astro.redirect('/login', 302);
return Astro.redirect('/me', 302);
