---
// Agents at Work · Nov 19, 2026. Prerendered: no live polls this time.
// The month-by-month slides read src/data/claude-chatgpt-timeline-2026.json,
// the same file behind /release-timeline, so the deck and the
// page can't disagree. This deck is itself the "decks as code" example from
// segment 1: HTML, CSS and a little JS, on a link.
export const prerender = true;

// Surfaces the deck on /slides via the index page's auto-discovery.
export const presentation = {
  title: "Monthly All-Hands · Nov 19, 2026 · Agents at Work",
  description: "What's new in Claude and ChatGPT and how to use it in a fund, what fellows have learned from personal agents, and how to build a home connector.",
  date: "2026-11-19",
  author: "Michael Staton",
  tags: ["All-Hands", "Agentic-VC-Dojo", "Claude", "ChatGPT"],
  featured: false,
  // A ready-made PDF; regenerate with `pnpm deck:pdf 2026-11-19_monthly-all-hands`.
  pdf: "/decks/2026-11-19_monthly-all-hands.pdf",
};

import PageAsDeckWrapper from "../../../layouts/PageAsDeckWrapper.astro";
import timeline from "../../../data/claude-chatgpt-timeline-2026.json";
import { getCollection } from "astro:content";
import ToolCard from "../../../components/stack/ToolCard.astro";

// Our own code-first work product, shown on the "decks as code" slide.
const allTools = await getCollection("tools");
const codeFirst = ["dididecks-ai", "memopop-ai"]
  .map((slug) => allTools.find((t) => t.id === slug))
  .filter(Boolean) as typeof allTools;
// What we run on the connector pattern today, shown on the "not a someday idea" slide.
const ourConnectors = ["lossless-at", "event-hog", "hope-ai", "kay-os"]
  .map((slug) => allTools.find((t) => t.id === slug))
  .filter(Boolean) as typeof allTools;

const TITLE = "Monthly All-Hands · Nov 19, 2026 · Agents at Work";
const DESCRIPTION = "What's new in Claude and ChatGPT for VCs, personal agents in practice, and building a home connector.";

type Item = { date: string; vendor: string; track: string; title: string; importance: number; verified: boolean; prior?: boolean };
const items = (timeline as Item[]).filter((i) => i.verified && !i.prior && i.importance >= 2).sort((a, b) => a.date.localeCompare(b.date));
const months = [...new Set(items.map((i) => i.date.slice(0, 7)))].map((k) => ({
  key: k,
  label: new Intl.DateTimeFormat("en-US", { month: "long", timeZone: "UTC" }).format(new Date(`${k}-01T00:00:00Z`)),
  anthropic: items.filter((i) => i.date.startsWith(k) && i.vendor === "Anthropic"),
  openai: items.filter((i) => i.date.startsWith(k) && i.vendor === "OpenAI"),
}));
// What each month's releases mean you can do now. The release list on the
// slide is the evidence; this line is the point.
const TAKEAWAYS: Record<string, string> = {
  "2026-05": "Hand an agent a goal that takes hours or days, and give your team shared agents for its workflows.",
  "2026-06": "Delegate from Slack or your phone, put tasks on a schedule, and fix a draft by pointing at it.",
  "2026-07": "Close the laptop: agents keep working in the cloud, and Claude can write to your Outlook, calendar and OneDrive.",
  "2026-08": "Share work by link with anyone, keep one memory across all your Claude work, and let Claude drive your browser.",
  "2026-09": "Ask any chat for a deck, doc or design; get agents that keep working between conversations; and ChatGPT with PitchBook and FactSet built in.",
  "2026-10": "Work in native Google Docs, Sheets and Slides, turn data into live dashboards and explainer videos, and manage it all from one Plugins page.",
  "2026-11": "Send Claude to the partner meeting, build the model and the whiteboard in chat, and run DCFs and memos on a finance-trained GPT.",
};
const day = (d: string) => new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone: "UTC" }).format(new Date(`${d}T00:00:00Z`));
const total = (timeline as Item[]).filter((i) => i.verified && !i.prior).length;
---

<PageAsDeckWrapper title={TITLE} description={DESCRIPTION} noindex={true} pdfHref={presentation.pdf}>

  {/* ── 01 cover */}
  <section class="slide slide--cover">
    <p class="slide-eyebrow" data-reveal>Agentic VC Dojo · Monthly All-Hands</p>
    <h1 class="slide-headline" data-reveal style="--delay: 80ms;">Agents at <span class="accent">Work</span></h1>
    <p class="slide-subhead" data-reveal style="--delay: 160ms;">Thursday · November 19, 2026 · 9:00 AM PT</p>
    <div class="slide-footnote">
      <span>In partnership with Kauffman Fellows</span>
      <span>↓ to start</span>
    </div>
  </section>

  {/* ── 02 agenda */}
  <section class="slide">
    <p class="slide-eyebrow" data-reveal>The next 60 minutes</p>
    <h2 class="slide-headline slide-headline--medium" data-reveal style="--delay: 80ms;">Three things, in order</h2>
    <ol class="agenda" data-reveal style="--delay: 160ms;">
      <li class="agenda-accent"><span class="agenda-n">01</span><span>A whirlwind of Claude and ChatGPT updates, and how to think about using them</span><span class="agenda-min">15m</span></li>
      <li class="agenda-accent"><span class="agenda-n">02</span><span>Personal agents: wins, disappointments, show-and-tell</span><span class="agenda-min">25m</span></li>
      <li><span class="agenda-n">03</span><span>The home connector idea, and how to get started</span><span class="agenda-min">15m</span></li>
      <li><span class="agenda-n">04</span><span>Questions and what's next</span><span class="agenda-min">5m</span></li>
    </ol>
    <p class="slide-caption" data-reveal style="--delay: 240ms;">Fast today, on purpose. Two sessions in December go deeper.</p>
  </section>

  {/* ── 03 segment 1 */}
  <section class="slide">
    <p class="slide-eyebrow" data-reveal>01 · What's new</p>
    <h2 class="slide-headline" data-reveal style="--delay: 80ms;">Six months, <span class="accent">{total} releases.</span></h2>
    <p class="slide-subhead" data-reveal style="--delay: 160ms;">
      Claude, ChatGPT, Claude Code, Codex and the models behind them, May to November. Every one is on the hub, linked to its source.
    </p>
    <p class="slide-caption" data-reveal style="--delay: 240ms;"><a class="pop-link" href="/release-timeline" target="_blank" rel="noopener">fullstack-vc.com/release-timeline ↗</a></p>
  </section>

  {/* ── 04–09 month by month */}
  {months.map((m) => (
    <section class="slide slide--month">
      <p class="slide-eyebrow" data-reveal>01 · What's new · {m.label}</p>
      {TAKEAWAYS[m.key] && (
        <h2 class="month-takeaway" data-reveal style="--delay: 60ms;"><span class="accent">Now you can:</span> {TAKEAWAYS[m.key]}</h2>
      )}
      <div class="month-grid" data-reveal style="--delay: 140ms;">
        {[["Anthropic", m.anthropic], ["OpenAI", m.openai]].map(([vendor, list]) => (
          <div class={`month-col month-col--${(vendor as string).toLowerCase()}`}>
            <h3>{vendor}</h3>
            <ul>
              {(list as Item[]).map((i) => (
                <li class:list={{ "is-headline": i.importance === 3 }}>
                  <span class="month-day">{day(i.date)}</span>
                  <span>{i.title}</span>
                </li>
              ))}
              {(list as Item[]).length === 0 && <li class="is-quiet"><span class="month-day">·</span><span>Nothing major</span></li>}
            </ul>
          </div>
        ))}
      </div>
    </section>
  ))}

  {/* ── 10 Claude picks */}
  <section class="slide">
    <p class="slide-eyebrow" data-reveal>01 · What's new · Claude, for a fund</p>
    <h2 class="slide-headline slide-headline--small" data-reveal style="--delay: 80ms;">Four Claude changes worth <span class="accent">using this week</span></h2>
    <ol class="picks" data-reveal style="--delay: 160ms;">
      <li><strong>Cowork and chat are one Claude</strong> <em>Sep 16</em><span>Hand over the data-room export; get back a first-draft IC memo and a summary deck, even after you close the laptop.</span></li>
      <li><strong>One memory, and you can see it</strong> <em>Jul 10 · Aug 25</em><span>Claude keeps what it learns about your fund in Settings › Memory › Topics, editable. Sensitive topics stay out unless you opt in.</span></li>
      <li><strong>Docs, Sheets, Slides, and Google files</strong> <em>Sep 16 · Oct 6</em><span>Decks, docs and models in any chat; native Google Docs, Sheets and Slides edited from Claude or inside the file.</span></li>
      <li><strong>Meetings, Data and Whiteboards</strong> <em>Nov 10 · 12</em><span>Claude takes the partner-meeting notes; portfolio KPI dashboards on certified metrics that LPs can see live without your data access; a whiteboard that turns IC debate into owners and dates.</span></li>
    </ol>
  </section>

  {/* ── 11 ChatGPT picks */}
  <section class="slide">
    <p class="slide-eyebrow" data-reveal>01 · What's new · ChatGPT, for a fund</p>
    <h2 class="slide-headline slide-headline--small" data-reveal style="--delay: 80ms;">Five ChatGPT changes <span class="accent">to know</span></h2>
    <ol class="picks" data-reveal style="--delay: 160ms;">
      <li><strong>ChatGPT for Financial Services</strong> <em>Sep 10</em><span>PitchBook, Crunchbase, Preqin, FactSet, Capital IQ and Datasite built in, on GPT-6 Astra; it drafts models and memos in your firm's templates, with information barriers. Started with investment banking and equity research; sold to eligible institutions.</span></li>
      <li><strong>Workspace agents: build once, share with the team</strong> <em>GA May 21</em><span>Describe the workflow and ChatGPT builds the agent; it runs on a schedule or from Slack and asks before sensitive steps. OpenAI's own example scores inbound leads, emails them and updates the CRM: swap leads for pitches and it's a deal-intake agent.</span></li>
      <li><strong>Dots: agents that keep working</strong> <em>Sep 29</em><span>Its own cloud computer and browser, 4,000+ apps, and a memory that learns how you judge things. It acts on new evidence without being asked: rerun the portfolio model when a company's monthly update lands, and flag what changed. Rules decide what it may do alone.</span></li>
      <li><strong>ChatGPT Work, also inside Microsoft 365</strong> <em>Jul 9 · Sep 10–17</em><span>An agent that stays with a project for hours and hands back sheets, slides and docs; OpenAI says finance teams cut month-end close from days to hours. Plus a Word add-in and SharePoint folders: compare term sheets straight from the deal folder.</span></li>
      <li><strong>GPT-6, and now 6.2 for valuation work</strong> <em>Oct 7 · Nov 17</em><span>GPT-6 answers with charts and small tools, but pick a higher reasoning level for real diligence. OpenAI says Astra works Financial Modeling World Cup challenges in Excel about four times faster than the winning human, and 6.2 is trained on DCFs, valuation workbooks and investment memos.</span></li>
    </ol>
  </section>

  {/* ── 11b artifact templates */}
  <section class="slide">
    <p class="slide-eyebrow" data-reveal>01 · What's new · Artifacts, rebuilt</p>
    <h2 class="slide-headline slide-headline--small" data-reveal style="--delay: 80ms;">One chat, <span class="accent">seven kinds of work product</span></h2>
    <ul class="templates" data-reveal style="--delay: 160ms;">
      <li><strong>Docs</strong><span>living, shared documents</span></li>
      <li><strong>Slides</strong><span>decks from a prompt</span></li>
      <li><strong>Design</strong><span>on-canvas, your design system</span></li>
      <li><strong>Data</strong><span>live dashboards, certified metrics</span></li>
      <li><strong>Sheets</strong><span>formulas, tabs, export to .xlsx <em>beta</em></span></li>
      <li><strong>Whiteboards</strong><span>brainstorm with Claude live <em>beta</em></span></li>
      <li><strong>Motion</strong><span>animated explainers, MP4 <em>Team/Ent beta</em></span></li>
    </ul>
    <p class="slide-caption" data-reveal style="--delay: 240ms;">They work in Claude Code too, and you can view and edit them on iOS and Android. Pre–Sep 16 chat artifacts are now "legacy": still shareable, no new ones.</p>
  </section>

  {/* ── 12 heads-up */}
  <section class="slide">
    <p class="slide-eyebrow" data-reveal>01 · What's new · Tell your IT person</p>
    <h2 class="slide-headline slide-headline--small" data-reveal style="--delay: 80ms;">Four <span class="accent">defaults</span> changing under you</h2>
    <ul class="picks picks--warn" data-reveal style="--delay: 160ms;">
      <li><strong>ChatGPT Dots are on for Enterprise</strong> <em>since Nov 18</em><span>Unless an admin opted out. A dot can learn from connected apps unprompted, and disconnecting an app doesn't delete what it already pulled.</span></li>
      <li><strong>Claude Data turns on for Enterprise</strong> <em>Fri, Nov 20</em><span>Unless an owner already saved a setting. Sheets, Whiteboards and Motion stay off on Enterprise until an admin enables them (Organization settings › Artifacts); on Team they're already on.</span></li>
      <li><strong>Custom GPTs are being retired</strong> <em>announced Sep 11</em><span>Your "memo GPT" needs to move to a plugin.</span></li>
      <li><strong>Claude Meetings skips outside guests</strong> <em>Nov 12</em><span>Founder pitch calls need an admin to allow external participants.</span></li>
    </ul>
  </section>

  {/* ── 13 decks as code */}
  <section class="slide slide--bold">
    <div class="bold-grid">
      <div>
        <p class="slide-eyebrow" data-reveal>01 · What's new · A takeaway for the bold</p>
        <h2 class="slide-headline" data-reveal style="--delay: 80ms;">Ditch PowerPoint. <span class="accent">Have Claude write the deck as code.</span></h2>
        <p class="slide-subhead" data-reveal style="--delay: 160ms;">
          HTML, JS and SVG. Your brand as code, not a template. Live data and polls inside. Versioned, and shared as a link that opens without an account.
        </p>
        <p class="slide-caption" data-reveal style="--delay: 240ms;">You're looking at one. This deck is a web page. And we build decks and memos this way for funds:</p>
      </div>
      <div data-reveal style="--delay: 320ms;">
        <div class="bold-cards">
          {codeFirst.map((t) => <ToolCard slug={t.id} data={t.data as any} />)}
        </div>
      </div>
    </div>
  </section>

  {/* ── 13b how to think about it */}
  <section class="slide">
    <p class="slide-eyebrow" data-reveal>01 · How to think about using it</p>
    <h2 class="slide-headline slide-headline--small" data-reveal style="--delay: 80ms;">Eight habits of an <span class="accent">agent-native VC</span></h2>
    <ol class="habits" data-reveal style="--delay: 160ms;">
      <li><span>01</span>Use Claude Code and Codex, not just the chat</li>
      <li><span>02</span>Write briefs and specs, not prompts</li>
      <li><span>03</span>Put routine work on a schedule</li>
      <li><span>04</span>Let models work in HTML, not .pptx</li>
      <li><span>05</span>Experiment with enterprise context</li>
      <li><span>06</span>Give it direct access: APIs and your browser</li>
      <li><span>07</span>Automate your personal life</li>
      <li><span>08</span>Create your firm's home connector</li>
    </ol>
    <p class="slide-caption" data-reveal style="--delay: 240ms;">The guide, with examples and tools for each: <a class="pop-link" href="/guides/agent-native-vc-2027/" target="_blank" rel="noopener">fullstack-vc.com/guides/agent-native-vc-2027 ↗</a></p>
  </section>

  {/* ── 14 segment 2: wins and disappointments */}
  <section class="slide">
    <p class="slide-eyebrow" data-reveal>02 · Personal agents</p>
    <h2 class="slide-headline slide-headline--medium" data-reveal style="--delay: 80ms;">What worked? <span class="accent">What let you down?</span></h2>
    <p class="slide-subhead" data-reveal style="--delay: 160ms;">
      Instinct, Town, Grok Bot, Muse, OpenClaw, Hermes, and now the big labs' own: ChatGPT's Dots and Claude Duet. The group chat has been testing them on real lives for weeks.
    </p>
    <div class="two-col" data-reveal style="--delay: 240ms;">
      <ul class="prompts prompts--win">
        <li>The moment it did something you didn't ask for</li>
        <li>An errand it handled end to end</li>
        <li>What you'd never give back</li>
      </ul>
      <ul class="prompts prompts--miss">
        <li>Where it guessed wrong, or went quiet</li>
        <li>Accounts it couldn't reach</li>
        <li>What you turned off, and why</li>
      </ul>
    </div>
    <p class="slide-caption" data-reveal style="--delay: 320ms;">Background reading: <a class="pop-link" href="/guides/personal-agents-in-the-dojo/" target="_blank" rel="noopener">fullstack-vc.com/guides/personal-agents-in-the-dojo ↗</a></p>
  </section>

  {/* ── 14b propagate wins */}
  <section class="slide">
    <p class="slide-eyebrow" data-reveal>02 · Personal agents</p>
    <h2 class="slide-headline slide-headline--small" data-reveal style="--delay: 80ms;">A win only counts once <span class="accent">someone else can repeat it.</span></h2>
    <ol class="agenda" data-reveal style="--delay: 160ms;">
      <li><span class="agenda-n">01</span><span><strong>Write it down as a brief or a skill:</strong> what you asked, what it needed access to, what you checked.</span><span class="agenda-min"></span></li>
      <li><span class="agenda-n">02</span><span><strong>Share it where the group looks:</strong> the chat for the story, the hub for the recipe.</span><span class="agenda-min"></span></li>
      <li><span class="agenda-n">03</span><span><strong>Add the tool to your stack</strong> on your hub profile, so others can find who uses what.</span><span class="agenda-min"></span></li>
      <li class="agenda-accent"><span class="agenda-n">04</span><span><strong>Put it behind your firm's home connector,</strong> so the whole team gets it, not just you.</span><span class="agenda-min"></span></li>
    </ol>
  </section>

  {/* ── 14c show and tell */}
  <section class="slide slide--close">
    <p class="slide-eyebrow" data-reveal>02 · Show-and-tell</p>
    <h2 class="slide-headline" data-reveal style="--delay: 80ms;">Share your screen. <span class="accent">Five minutes.</span></h2>
    <p class="slide-subhead" data-reveal style="--delay: 160ms;">One thing your agent did for you this month: what you asked, and what came back. Rough is fine.</p>
  </section>

  {/* ── 15 segment 3: the problem */}
  <section class="slide">
    <p class="slide-eyebrow" data-reveal>03 · A home connector</p>
    <h2 class="slide-headline slide-headline--medium" data-reveal style="--delay: 80ms;">A connector per tool. Skills per person. Memory per app. <span class="accent">Nothing spans them.</span></h2>
    <p class="slide-subhead" data-reveal style="--delay: 160ms;">
      This is every team using Claude or ChatGPT right now. So no agent can do this: "Find the company in our CRM, pull our research note from the wiki, and draft the follow-up."
    </p>
  </section>

  {/* ── 15b one door, four things */}
  <section class="slide">
    <p class="slide-eyebrow" data-reveal>03 · A home connector</p>
    <h2 class="slide-headline slide-headline--small" data-reveal style="--delay: 80ms;">One connector the whole team adds. <span class="accent">Four things behind it.</span></h2>
    <ul class="templates" data-reveal style="--delay: 160ms;">
      <li><strong>Skills</strong><span>the firm's playbooks: how we write a memo, how we log a founder call</span></li>
      <li><strong>Context</strong><span>thesis, portfolio, who's who, written once</span></li>
      <li><strong>Memory</strong><span>what the agents learn, as plain files with full history</span></li>
      <li><strong>Tools</strong><span>CRM, wiki, email, calendar, each with its own permissions</span></li>
    </ul>
    <p class="slide-caption" data-reveal style="--delay: 240ms;">Who can read, who can write, what needs a human to approve: set once, for everyone.</p>
  </section>

  {/* ── 15c we run this today, why now */}
  <section class="slide slide--connectors">
    <p class="slide-eyebrow" data-reveal>03 · A home connector</p>
    <h2 class="slide-headline slide-headline--small" data-reveal style="--delay: 80ms;">Not a someday idea. <span class="accent">Three firms run on one today.</span></h2>
    <ol class="agenda" data-reveal style="--delay: 160ms;">
      <li><span class="agenda-n">✓</span><span><strong>One connector per firm:</strong> Palmer AI, The Water Foundation and Lossless each add one connector, and Claude calls their Twenty, Outline and Plane through it, with shared skills.</span><span class="agenda-min"></span></li>
      <li><span class="agenda-n">✓</span><span><strong>Shared files:</strong> event-hog ran a three-person team's conference from Claude in October; every note became a saved change under its author's name.</span><span class="agenda-min"></span></li>
      <li class="agenda-accent"><span class="agenda-n">→</span><span><strong>Why it's easy now:</strong> it needs a version-controlled store (GitHub and GitLab work), and Cloudflare Artifacts makes it cheap and invisible: git repos for agents, next to the connector on Workers, and nobody sees GitHub.</span><span class="agenda-min"></span></li>
    </ol>
    <div data-reveal style="--delay: 240ms;">
      <div class="connector-cards">
        {ourConnectors.map((t) => <ToolCard slug={t.id} data={t.data as any} />)}
      </div>
    </div>
  </section>

  {/* ── 15c2 folder convention */}
  <section class="slide">
    <p class="slide-eyebrow" data-reveal>03 · A home connector</p>
    <h2 class="slide-headline slide-headline--small" data-reveal style="--delay: 80ms;">Name the folders <span class="accent">so the model knows there are rules.</span></h2>
    <ul class="templates" data-reveal style="--delay: 160ms;">
      <li><strong>context-v/</strong><span>thesis, portfolio, people, plans</span></li>
      <li><strong>context-v/agent-skills/</strong><span>shared skills, one SKILL.md each</span></li>
      <li><strong>docs-v/</strong><span>documentation for people and agents</span></li>
      <li><strong>changelog-v/</strong><span>dated notes on what changed</span></li>
      <li><strong>memory-v/</strong><span>what the agents learn and save</span></li>
    </ul>
    <p class="slide-caption" data-reveal style="--delay: 240ms;">"memory" and "docs" mean a hundred layouts in a model's training data. The -v is ours: it says this folder follows a pattern, so find it and keep to it. Not required; it's how we work.</p>
  </section>

  {/* ── 15d ask for it */}
  <section class="slide">
    <p class="slide-eyebrow" data-reveal>03 · A home connector</p>
    <h2 class="slide-headline slide-headline--small" data-reveal style="--delay: 80ms;">You don't write it. <span class="accent">You ask Claude Code or Codex for it.</span></h2>
    <pre class="prompt" data-reveal style="--delay: 160ms;">Build me a home connector: a remote MCP server on Cloudflare
Workers that my team adds once in Claude and ChatGPT.
Behind it, a version-controlled repo (Cloudflare Artifacts,
or GitHub/GitLab): context-v/,
context-v/agent-skills/ (served as prompts), docs-v/,
changelog-v/, memory-v/. Every write is a commit under the
person's name; tools only add. Proxy our CRM and wiki through it
with stored credentials. Sign-in per person, a permission table
per folder and tool, and approval for sensitive actions.</pre>
    <p class="slide-caption" data-reveal style="--delay: 240ms;">The full prompt and recipe: <a class="pop-link" href="/guides/one-home-connector/" target="_blank" rel="noopener">fullstack-vc.com/guides/one-home-connector ↗</a>. Start with the files, then add one tool at a time.</p>
  </section>

  {/* ── 15e get started */}
  <section class="slide">
    <p class="slide-eyebrow" data-reveal>03 · Get started this week</p>
    <h2 class="slide-headline slide-headline--small" data-reveal style="--delay: 80ms;">Your first home connector <span class="accent">in five steps.</span></h2>
    <ol class="agenda" data-reveal style="--delay: 160ms;">
      <li><span class="agenda-n">01</span><span>Open Claude Code or Codex in the desktop app, in an empty folder. No terminal needed.</span><span class="agenda-min"></span></li>
      <li><span class="agenda-n">02</span><span>Paste the prompt from the recipe, and answer its questions as it builds.</span><span class="agenda-min"></span></li>
      <li><span class="agenda-n">03</span><span>Files first: have Claude save a note, then find it from a fresh chat.</span><span class="agenda-min"></span></li>
      <li><span class="agenda-n">04</span><span>Add your most-used tool, usually the CRM, read-only.</span><span class="agenda-min"></span></li>
      <li class="agenda-accent"><span class="agenda-n">05</span><span>Invite one teammate, and give them the same connector.</span><span class="agenda-min"></span></li>
    </ol>
