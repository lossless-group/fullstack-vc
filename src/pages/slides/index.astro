---
/**
 * Slides index — auto-discovers:
 *   1. Standalone Astro decks: `src/pages/slides/<slug>.astro` files that
 *      `export const presentation = { title, description, ... }`.
 *   2. Markdown decks: `src/content/slides/*.md` with frontmatter.
 * Per-deck routing:
 *   - Astro decks resolve directly via Astro's file-based routing (`/slides/<slug>`).
 *   - Markdown decks resolve via `[...slug].astro` to `MarkdownSlideDeck`.
 */
export const prerender = true;

import BaseThemeLayout from '../../layouts/BaseThemeLayout.astro';

interface Presentation {
  title: string;
  slug: string;
  description: string;
  date?: string;
  author?: string;
  tags?: string[];
  type: 'astro' | 'markdown';
}

// 1. Auto-discover standalone Astro decks. eager:false avoids loading their
//    Reveal/CSS bundles into the index page.
const astroGlobs = import.meta.glob<{
  presentation?: {
    title?: string;
    description?: string;
    date?: string;
    author?: string;
    tags?: string[];
  };
}>('./*.astro');

const astroDecks: Presentation[] = [];
for (const [path, loader] of Object.entries(astroGlobs)) {
  if (path.includes('index.astro') || path.includes('[')) continue;
  try {
    const mod = await loader();
    if (mod.presentation) {
      const slug = path.replace('./', '').replace('.astro', '');
      astroDecks.push({
        slug,
        title: mod.presentation.title ?? slug,
        description: mod.presentation.description ?? '',
        date: mod.presentation.date,
        author: mod.presentation.author,
        tags: mod.presentation.tags,
        type: 'astro',
      });
    }
  } catch (e) {
    console.warn(`[slides/index] Could not load ${path}:`, e);
  }
}

// 2. Markdown decks via raw glob — read frontmatter ourselves (no content
//    collection needed; keeps the slides surface independent).
const mdGlobs = import.meta.glob<string>('../../content/slides/*.md', {
  eager: true,
  query: '?raw',
  import: 'default',
});

const markdownDecks: Presentation[] = [];
for (const [path, raw] of Object.entries(mdGlobs)) {
  const fileName = path.split('/').pop()!.replace(/\.md$/, '');
  const fmMatch = (raw as string).match(/^---\r?\n([\s\S]*?)\r?\n---/);
  let title = fileName;
  let description = '';
  let date: string | undefined;
  if (fmMatch) {
    const fm = fmMatch[1];
    title = fm.match(/^title:\s*"?([^"\n]+)"?/m)?.[1]?.trim() ?? fileName;
    description = fm.match(/^description:\s*"?([^"\n]+)"?/m)?.[1]?.trim() ?? '';
    date = fm.match(/^date:\s*"?([^"\n]+)"?/m)?.[1]?.trim();
  }
  markdownDecks.push({
    slug: fileName,
    title,
    description,
    date,
    type: 'markdown',
  });
}

const presentations = [...astroDecks, ...markdownDecks].sort((a, b) => {
  if (!a.date && !b.date) return a.title.localeCompare(b.title);
  if (!a.date) return 1;
  if (!b.date) return -1;
  return new Date(b.date).getTime() - new Date(a.date).getTime();
});
---

<BaseThemeLayout
  title="Slides · FullStack VC"
  description="Reveal.js presentations — Astro components and markdown both render here."
  containerClass="px-6 py-12 max-w-5xl mx-auto"
>
  <header class="slides-header">
    <p class="slides-eyebrow">Web-native slides</p>
    <h1 class="slides-title">
      <span class="slides-title__accent">Reveal</span> what you're building.
    </h1>
    <p class="slides-lede">
      Decks here render through Reveal.js. Astro decks compose existing site components;
      markdown decks live in <code>src/content/slides/</code>. Hit a deck, then press
      <kbd>F</kbd> for fullscreen or <kbd>S</kbd> for speaker notes.
    </p>
  </header>

  <ul class="slides-grid" role="list">
    {presentations.map(p => (
      <li>
        <a href={`/slides/${p.slug}`} class="slides-card">
          <span class={`slides-card__type slides-card__type--${p.type}`}>
            {p.type === 'astro' ? 'Astro' : 'Markdown'}
          </span>
          <h2 class="slides-card__title">{p.title}</h2>
          {p.description && <p class="slides-card__desc">{p.description}</p>}
          <footer class="slides-card__meta">
            {p.author && <span>{p.author}</span>}
            {p.date && <span>{p.date}</span>}
            <span class="slides-card__cta">Open →</span>
          </footer>
        </a>
      </li>
    ))}
  </ul>

  {presentations.length === 0 && (
    <p class="slides-empty">
      No decks yet. Drop an <code>.astro</code> file in <code>src/pages/slides/</code>
      that exports a <code>presentation</code> object, or a markdown file in
      <code>src/content/slides/</code>.
    </p>
  )}
</BaseThemeLayout>

<style>
  .slides-header { margin-bottom: 3rem; }
  .slides-eyebrow {
    margin: 0 0 0.625rem;
    font-family: var(--font-code);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
  }
  .slides-title {
    margin: 0 0 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .slides-title__accent {
    background: var(--fx-headline-gradient);
    -webkit-background-clip: text;
            background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .slides-lede {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 60ch;
  }
  .slides-lede code, .slides-empty code {
    font-family: var(--font-code);
    font-size: 0.875em;
    padding: 0.125em 0.375em;
    border-radius: 0.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .slides-lede kbd {
    font-family: var(--font-code);
    font-size: 0.8em;
    padding: 0.125em 0.5em;
    border-radius: 0.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
  }

  .slides-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .slides-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .slides-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.5rem;
    border-radius: 0.875rem;
    background: var(--fx-card-bg);
    border: 1px solid var(--fx-card-border);
    box-shadow: var(--fx-card-shadow);
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
  }
  .slides-card:hover {
    border-color: var(--fx-card-border-hover);
    box-shadow: var(--fx-card-shadow-hover);
    transform: translateY(-2px);
  }

  .slides-card__type {
    align-self: flex-start;
    font-family: var(--font-code);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.1875rem 0.5rem;
    border-radius: 999px;
    border: 1px solid currentColor;
  }
  .slides-card__type--astro    { color: var(--color-primary); }
  .slides-card__type--markdown { color: var(--color-secondary); }

  .slides-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .slides-card__desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .slides-card__meta {
    margin-top: auto;
    padding-top: 0.625rem;
    border-top: 1px dashed var(--color-border);
    display: flex;
    align-items: center;
    gap: 0.875rem;
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .slides-card__cta {
    margin-left: auto;
    color: var(--color-primary);
    font-weight: 600;
  }

  .slides-empty {
    margin: 2rem 0 0;
    padding: 1.5rem;
    border-radius: 0.625rem;
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    color: var(--color-text-muted);
  }
</style>
