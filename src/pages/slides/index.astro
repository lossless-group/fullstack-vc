---
/**
 * Slides index — auto-discovers standalone Astro decks:
 *   - Flat: `src/pages/slides/<slug>.astro`
 *   - Subdirectory: `src/pages/slides/<slug>/index.astro`
 *
 * Each deck exports a `presentation = { title, description, date, ... }` const.
 * A `featured: true` entry pulls out into the top-right "Today" card; the rest
 * render in the grid below sorted by date descending.
 *
 * Markdown deck discovery was removed — Reveal-only markdown decks are still
 * served by [...slug].astro but don't surface on this index.
 */
export const prerender = true;

import BaseThemeLayout from '../../layouts/BaseThemeLayout.astro';

interface Presentation {
  title: string;
  slug: string;
  description: string;
  date?: string;
  author?: string;
  tags?: string[];
  featured?: boolean;
  type: 'astro';
}

// Discover both flat .astro files AND subdirectory index.astro files.
// eager:false so each deck's bundle isn't pulled into the index.
const astroGlobs = import.meta.glob<{
  presentation?: {
    title?: string;
    description?: string;
    date?: string;
    author?: string;
    tags?: string[];
    featured?: boolean;
  };
}>(['./*.astro', './*/index.astro']);

const decks: Presentation[] = [];
for (const [path, loader] of Object.entries(astroGlobs)) {
  // Skip this index file and dynamic catch-alls.
  if (path === './index.astro' || path.includes('[')) continue;
  try {
    const mod = await loader();
    if (!mod.presentation) continue;
    // Slug from path:
    //   ./agentic-vc-dojo-launch.astro            → agentic-vc-dojo-launch
    //   ./2026-05-27_monthly-all-hands/index.astro → 2026-05-27_monthly-all-hands
    const slug = path
      .replace(/^\.\//, '')
      .replace(/\/index\.astro$/, '')
      .replace(/\.astro$/, '');
    decks.push({
      slug,
      title: mod.presentation.title ?? slug,
      description: mod.presentation.description ?? '',
      date: mod.presentation.date,
      author: mod.presentation.author,
      tags: mod.presentation.tags,
      featured: mod.presentation.featured ?? false,
      type: 'astro',
    });
  } catch (e) {
    console.warn(`[slides/index] Could not load ${path}:`, e);
  }
}

// Sort all by date descending. Featured decks are pulled out for the hero
// slot; the remaining flow into the grid in date-desc order.
decks.sort((a, b) => {
  if (!a.date && !b.date) return a.title.localeCompare(b.title);
  if (!a.date) return 1;
  if (!b.date) return -1;
  return new Date(b.date).getTime() - new Date(a.date).getTime();
});

const featuredDeck = decks.find((d) => d.featured);
const restDecks = decks.filter((d) => !d.featured);
---

<BaseThemeLayout
  title="Slides · FullStack VC"
  description="Section-composed and Reveal-based decks — Agentic VC Dojo and beyond."
  containerClass="px-6 py-12 max-w-6xl mx-auto"
>
  {featuredDeck && (
    <aside class="featured-banner" aria-label="Featured deck">
      <a href={`/slides/${featuredDeck.slug}`} class="featured-banner__card">
        <div class="featured-banner__head">
          <span class="featured-banner__pill">Today</span>
          {featuredDeck.date && <span class="featured-banner__date">{featuredDeck.date}</span>}
        </div>
        <h2 class="featured-banner__title">{featuredDeck.title}</h2>
        {featuredDeck.description && (
          <p class="featured-banner__desc">{featuredDeck.description}</p>
        )}
        <span class="featured-banner__cta">Open the deck →</span>
      </a>
    </aside>
  )}

  <header class="slides-header">
    <p class="slides-eyebrow">Web-native slides</p>
    <h1 class="slides-title">
      <span class="slides-title__accent">Reveal</span> what you're building.
    </h1>
    <p class="slides-lede">
      Decks here render through Reveal.js or the section-composed paradigm.
      Astro decks compose existing site components; press <kbd>F</kbd> for fullscreen
      or <kbd>S</kbd> for speaker notes on Reveal decks.
    </p>
  </header>

  {restDecks.length > 0 && (
    <ul class="slides-grid" role="list">
      {restDecks.map((p) => (
        <li>
          <a href={`/slides/${p.slug}`} class="slides-card">
            <span class="slides-card__type">Astro</span>
            <h2 class="slides-card__title">{p.title}</h2>
            {p.description && <p class="slides-card__desc">{p.description}</p>}
            <footer class="slides-card__meta">
              {p.author && <span>{p.author}</span>}
              {p.date && <span>{p.date}</span>}
              <span class="slides-card__cta">Open →</span>
            </footer>
          </a>
        </li>
      ))}
    </ul>
  )}

  {decks.length === 0 && (
    <p class="slides-empty">
      No decks yet. Drop an <code>.astro</code> file in <code>src/pages/slides/</code>
      that exports a <code>presentation</code> object — or a subdirectory with an
      <code>index.astro</code> doing the same.
    </p>
  )}
</BaseThemeLayout>

<style>
  /* Featured banner — full-width hero above the page header. Impossible to miss. */
  .featured-banner {
    display: block;
    margin: 0 0 2.5rem;
  }
  .featured-banner__card {
    display: block;
    padding: 1.75rem 2rem 1.5rem;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--color-accent) 10%, var(--fx-card-bg));
    border: 1.5px solid color-mix(in srgb, var(--color-accent) 65%, var(--color-border));
    box-shadow: var(--fx-card-shadow);
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease, box-shadow 150ms ease, transform 150ms ease, background 150ms ease;
  }
  .featured-banner__card:hover {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 15%, var(--fx-card-bg));
    box-shadow: var(--fx-card-shadow-hover);
    transform: translateY(-2px);
  }
  .featured-banner__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .featured-banner__pill {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .featured-banner__date {
    font-family: var(--font-code);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }
  .featured-banner__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-text);
  }
  .featured-banner__desc {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.5;
    max-width: 72ch;
  }
  .featured-banner__cta {
    display: inline-block;
    font-family: var(--font-code);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  /* Page header */
  .slides-header { margin-bottom: 3rem; }
  .slides-eyebrow {
    margin: 0 0 0.625rem;
    font-family: var(--font-code);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
  }
  .slides-title {
    margin: 0 0 0.875rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .slides-title__accent {
    background: var(--fx-headline-gradient);
    -webkit-background-clip: text;
            background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .slides-lede {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 55ch;
  }
  .slides-lede code, .slides-empty code {
    font-family: var(--font-code);
    font-size: 0.875em;
    padding: 0.125em 0.375em;
    border-radius: 0.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .slides-lede kbd {
    font-family: var(--font-code);
    font-size: 0.8em;
    padding: 0.125em 0.5em;
    border-radius: 0.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-primary);
  }

  /* Featured "Today" card — top-right of the top region */
  .featured-deck {
    /* Featured column — right side of the top region */
  }
  .featured-deck__card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.75rem 1.75rem 1.5rem;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--color-accent) 8%, var(--fx-card-bg));
    border: 1.5px solid color-mix(in srgb, var(--color-accent) 60%, var(--color-border));
    box-shadow: var(--fx-card-shadow);
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease, box-shadow 150ms ease, transform 150ms ease, background 150ms ease;
    height: 100%;
  }
  .featured-deck__card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--fx-card-shadow-hover);
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--color-accent) 12%, var(--fx-card-bg));
  }
  .featured-deck__pill {
    align-self: flex-start;
    font-family: var(--font-code);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .featured-deck__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-text);
  }
  .featured-deck__desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .featured-deck__meta {
    margin-top: auto;
    padding-top: 0.625rem;
    border-top: 1px dashed color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
    display: flex;
    align-items: center;
    gap: 0.875rem;
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .featured-deck__cta {
    margin-left: auto;
    color: var(--color-accent);
    font-weight: 600;
  }

  /* Regular decks grid */
  .slides-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .slides-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1100px) {
    .slides-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .slides-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.5rem;
    border-radius: 0.875rem;
    background: var(--fx-card-bg);
    border: 1px solid var(--fx-card-border);
    box-shadow: var(--fx-card-shadow);
    text-decoration: none;
    color: inherit;
    transition: border-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
  }
  .slides-card:hover {
    border-color: var(--fx-card-border-hover);
    box-shadow: var(--fx-card-shadow-hover);
    transform: translateY(-2px);
  }

  .slides-card__type {
    align-self: flex-start;
    font-family: var(--font-code);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.1875rem 0.5rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    color: var(--color-primary);
  }

  .slides-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .slides-card__desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .slides-card__meta {
    margin-top: auto;
    padding-top: 0.625rem;
    border-top: 1px dashed var(--color-border);
    display: flex;
    align-items: center;
    gap: 0.875rem;
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .slides-card__cta {
    margin-left: auto;
    color: var(--color-primary);
    font-weight: 600;
  }

  .slides-empty {
    margin: 2rem 0 0;
    padding: 1.5rem;
    border-radius: 0.625rem;
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    color: var(--color-text-muted);
  }
</style>
