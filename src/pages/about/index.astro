---
export const prerender = true;
import { getEntry } from 'astro:content';
import BaseThemeLayout from '../../layouts/BaseThemeLayout.astro';
import Section__HowItWorks from '../../components/sections/Section__HowItWorks.astro';
import Section__DojoComponents from '../../components/sections/Section__DojoComponents.astro';

const page = await getEntry('pages', 'about');
const { title, description, eyebrow, heading, lede } = page!.data;
---

<BaseThemeLayout title={title} description={description}>
  <section class="about-hero">
    <p class="about-hero__eyebrow">{eyebrow}</p>
    <h1 class="about-hero__heading">{heading}</h1>
    <p class="about-hero__lede">{lede}</p>
  </section>

  <Section__HowItWorks hideMore={true} />
  <Section__DojoComponents />
</BaseThemeLayout>

<style>
  .about-hero {
    max-width: 56rem;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .about-hero__eyebrow {
    margin: 0;
    font-family: var(--font-code);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
  }
  .about-hero__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--color-text);
    background: var(--fx-headline-gradient, none);
    -webkit-background-clip: text;
            background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .about-hero__lede {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-text);
    max-width: 44rem;
  }
</style>
