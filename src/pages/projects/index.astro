---
export const prerender = true;

import BaseThemeLayout from '../../layouts/BaseThemeLayout.astro';
import HeroBanner from '../../components/heroes/HeroBannerWithMessageHierarchy.astro';
import Section__ProjectGallery from '../../components/sections/Section__ProjectGallery.astro';
import { loadProjectsByStatus } from '../../lib/load-projects';

const [active, proposed, archived] = await Promise.all([
  loadProjectsByStatus('active'),
  loadProjectsByStatus('proposed'),
  loadProjectsByStatus('archived'),
]);

// PNG (not WEBP) — WhatsApp and iMessage are inconsistent with WebP for OG
// share previews. The .png variant exists alongside .webp in /public/.
const heroImage = '/imageRep__AgenticVC-Dojo.png';
---

<BaseThemeLayout
  title="Projects · FullStack VC"
  description="Active working-group projects in the FullStack VC peer learning community."
  image={heroImage}
  ogType="website"
>
  <!-- Hero. Falls back to plain message hierarchy if no banner image is available
       (production deploys: replace heroImage with a real /og/projects.png).
       The same image is passed to BaseThemeLayout above so the page's own OG
       share image matches what visitors see on the page. -->
  <HeroBanner
    image={heroImage}
    imageAlt=""
    overlay="gradient"
    align="left"
    height="standard"
    contextSetterTxt="Projects to Learn and Use · Peer Learning"
    headerTxt="Projects, proposed by you, built together."
    subheaderTxt="Gain momentum and collaborate with the KF SIG + FullStack VC community."
    supportingTxt="We work together to learn skills we can all apply as individuals with the intention of impacting your firm — and the projects below are how the community puts that into practice.</br></br>At the very least, you can develop AI Superpowers and reduce burnout."
    ctaLabelTxt="Propose a project"
    ctaHref="/projects/propose"
  />

  <div class="px-6 py-16 max-w-6xl mx-auto flex flex-col gap-20">
    <!-- Active: portfolio variant (default standard concept) -->
    <Section__ProjectGallery
      contextSetterTxt="In flight"
      headingTxt="Actively supported by the community"
      introTxt="Projects discussed and improved through working groups, with a visble cadence of progress. Click in for the spec, the cadence, and the people."
      projects={active}
      variant="portfolio"
    />

    <!-- Proposed: lite variant -->
    <Section__ProjectGallery
      contextSetterTxt="Open call"
      headingTxt="Proposed — looking for working-group members"
      introTxt="Projects in the queue that need a few committed members to start. Reach out via the Dojo WhatsApp group if one resonates."
      projects={proposed}
      variant="lite"
    />

    <!-- Archived: shelf variant -->
    <Section__ProjectGallery
      contextSetterTxt="Prior work"
      headingTxt="Archive"
      introTxt="Projects we shut down deliberately. Read these — failure modes are some of the best content the community produces."
      projects={archived}
      variant="shelf"
    />
  </div>
</BaseThemeLayout>
