---
export const prerender = true;
import { getCollection } from 'astro:content';
import { parseMarkdown } from '@lossless-group/lfm';
import BookReaderLayout from '../../../layouts/BookReaderLayout.astro';
import AstroMarkdown from '../../../components/markdown/AstroMarkdown.astro';
import Sources from '../../../components/markdown/Sources.astro';

export async function getStaticPaths() {
  const all = await getCollection('ventureWorkflows');
  // YOLO: render all chapters regardless of `published` flag for now.
  const sorted = [...all].sort((a, b) => a.data.chapter_number - b.data.chapter_number);
  return sorted.map((entry, i) => ({
    params: { slug: entry.id.replace(/^\d+-/, '') },
    props: {
      entry,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { data } = entry;
const body = entry.body ?? '';

const tree = await parseMarkdown(body);
const citations = (tree as any).data?.citations?.ordered ?? [];

// Word count: strip code fences + footnote defs, then count whitespace-separated tokens.
const bodyText = body
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/^\[\^\d+\]:[\s\S]*?(?=\n\[\^|\n##|$)/gm, ' ');
const wordCount = bodyText.split(/\s+/).filter(Boolean).length;
// 220 wpm — long-tail-validated average for online prose (per spec).
const readingMinutes = Math.max(1, Math.ceil(wordCount / 220));

function chapterHref(e: any): string {
  return `/read/venture-handbook/${e.id.replace(/^\d+-/, '')}/`;
}

function navProp(e: any) {
  if (!e) return null;
  return {
    href: chapterHref(e),
    title: e.data.title,
    number: e.data.chapter_number,
    lede: e.data.lede,
    tags: e.data.tags,
  };
}
const prevProp = navProp(prev);
const nextProp = navProp(next);

const author = (data as any).contributors?.[0] ?? 'Class 20 Living Draft';
const updated: Date | null = (data as any).date_modified ?? (data as any).date_published ?? (data as any).date_authored ?? null;
---

<BookReaderLayout
  title={`${data.title} · Venture Handbook · FullStack VC`}
  description={(data as any).summary ?? data.lede}
  chapterNumber={data.chapter_number}
  chapterTitle={data.title}
  chapterLede={data.lede}
  chapterEyebrow={(data as any).chapter_eyebrow}
  bannerSrc={(data as any).hero_image ?? (data as any).og_image}
  tags={data.tags}
  subsectionOutline={(data as any).subsection_outline}
  readingMinutes={readingMinutes}
  wordCount={wordCount}
  author={author}
  updated={updated}
  sourceOrganization={(data as any).source_organization}
  prev={prevProp}
  next={nextProp}
>
  <AstroMarkdown node={tree} />
  <Sources citations={citations} />
</BookReaderLayout>
