---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseThemeLayout from '../../../layouts/BaseThemeLayout.astro';

const all = await getCollection('ventureWorkflows');
// YOLO: list all chapters regardless of `published` flag for now.
const sorted = [...all].sort((a, b) => a.data.chapter_number - b.data.chapter_number);

function pad(n: number): string {
  return String(n).padStart(2, '0');
}

function chapterHref(e: any): string {
  return `/read/venture-handbook/${e.id.replace(/^\d+-/, '')}/`;
}
---

<BaseThemeLayout
  title="Venture Handbook · FullStack VC"
  description="Ten workflow chapters covering the practice of venture capital — drawn from the Kauffman Fellows Class 20 living draft and updated for the agentic era."
  containerClass="px-6 py-12 max-w-4xl mx-auto"
>
  <header class="book-head">
    <p class="book-head__eyebrow">Venture Handbook · Class 20 Living Draft</p>
    <h1 class="book-head__title">The Venture Handbook</h1>
    <p class="book-head__lede">
      Ten workflow chapters covering the practice of venture capital — strategy,
      sourcing, diligence, governance, portfolio services, fund management, and exits.
      Drawn from the Kauffman Fellows Class 20 living draft.
    </p>
    <p class="book-head__meta">
      {sorted.length} {sorted.length === 1 ? 'chapter' : 'chapters'}
    </p>
  </header>

  <ol class="chapters">
    {sorted.map(entry => (
      <li class="chapter-card">
        <a href={chapterHref(entry)} class="chapter-card__link">
          <span class="chapter-card__number">Chapter {pad(entry.data.chapter_number)}</span>
          <h2 class="chapter-card__title">{entry.data.title}</h2>
          {entry.data.lede && <p class="chapter-card__lede">{entry.data.lede}</p>}
          {entry.data.tags && entry.data.tags.length > 0 && (
            <div class="chapter-card__tags">
              {entry.data.tags.slice(0, 4).map((t: string) => (
                <span class="chapter-card__tag">#{t}</span>
              ))}
              {entry.data.tags.length > 4 && (
                <span class="chapter-card__tag chapter-card__tag--more">
                  +{entry.data.tags.length - 4}
                </span>
              )}
            </div>
          )}
        </a>
      </li>
    ))}
  </ol>
</BaseThemeLayout>

<style>
  .book-head {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }
  .book-head__eyebrow {
    font-family: var(--font-code);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
  }
  .book-head__title {
    font-family: var(--font-display);
    font-size: 2.75rem;
    line-height: 1.1;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.875rem;
  }
  .book-head__lede {
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--color-text);
    max-width: 42rem;
    margin: 0 0 1rem;
  }
  .book-head__meta {
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .chapters {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .chapter-card { margin: 0; }
  .chapter-card__link {
    display: block;
    padding: 1.25rem 1.5rem;
    border-radius: 0.875rem;
    background: var(--fx-card-bg);
    border: 1px solid var(--fx-card-border);
    box-shadow: var(--fx-card-shadow);
    text-decoration: none;
    transition: border-color 150ms ease, box-shadow 150ms ease;
  }
  .chapter-card__link:hover {
    border-color: var(--fx-card-border-hover);
    box-shadow: var(--fx-card-shadow-hover);
  }
  .chapter-card__number {
    display: block;
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-primary);
    margin-bottom: 0.375rem;
  }
  .chapter-card__title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }
  .chapter-card__lede {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
  }
  .chapter-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chapter-card__tag {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }
  .chapter-card__tag--more {
    opacity: 0.7;
  }
</style>
