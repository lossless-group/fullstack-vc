---
export const prerender = true;
import BaseThemeLayout from '../layouts/BaseThemeLayout.astro';
import TextLinkSpan from '../components/buttons/TextLinkSpan.astro';
---

<BaseThemeLayout
  title="FullStack VC — Agentic VC Dojo"
  description="A learning community where venture capitalists practice using AI to give their firms superpowers."
>
  <div class="px-6 pt-4 max-w-4xl mx-auto text-right">
    <TextLinkSpan>
      <a href="/brand-kit">Brand Kit</a>
      <a href="/design-system">Design System</a>
    </TextLinkSpan>
  </div>

  <section class="px-6 pt-12 pb-24 max-w-4xl mx-auto">
    <p
      class="text-sm uppercase tracking-[0.18em] mb-6"
      style="color: var(--color-text-muted); font-family: var(--font-code);"
    >
      Agentic VC Dojo · Monthly · Members only
    </p>

    <h1
      class="text-5xl md:text-7xl font-bold leading-[1.05] tracking-tight mb-8"
      style="font-family: var(--font-display); background: var(--fx-headline-gradient, none); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: var(--color-text);"
    >
      Give your firm AI superpowers.
    </h1>

    <p
      class="text-xl md:text-2xl max-w-2xl leading-relaxed mb-10"
      style="color: var(--color-text);"
    >
      A working community for the next generation of venture capitalists — learning, in public, how to make
      <span style="color: var(--color-primary); font-weight: 600;">agentic AI</span>
      a daily practice inside investment firms.
    </p>

    <a
      href="/dojo"
      class="inline-flex items-center px-6 py-3 rounded-lg font-medium transition-colors"
      style="background: var(--color-primary); color: var(--color__bone); box-shadow: var(--fx-card-shadow);"
    >
      Join the Dojo
    </a>

    <div
      class="mt-20 p-6 rounded-xl"
      style="background: var(--fx-card-bg); border: 1px solid var(--fx-card-border); box-shadow: var(--fx-card-shadow);"
    >
      <p style="color: var(--color-text-muted); font-family: var(--font-code); font-size: 0.875rem;">
        // status: scaffolding · brand TBD · iterate from here
      </p>
    </div>
  </section>
</BaseThemeLayout>
