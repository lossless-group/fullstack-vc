---
export const prerender = true;
import BaseThemeLayout from '../../../layouts/BaseThemeLayout.astro';
import ModeThemeToggle from '../../../components/ui/ModeThemeToggle.astro';
import Section__WorkingGroupGallery from '../../../components/sections/Section__WorkingGroupGallery.astro';
import { loadWorkingGroupsWithProjects } from '../../../lib/load-working-groups';

const [active, proposed, archived] = await Promise.all([
  loadWorkingGroupsWithProjects('active'),
  loadWorkingGroupsWithProjects('proposed'),
  loadWorkingGroupsWithProjects('archived'),
]);
---

<BaseThemeLayout
  title="Section · Working Group Gallery"
  description="Four variants of Section__WorkingGroupGallery: portfolio, mission-brief, lite, shelf. Sibling to Section__ProjectGallery; differs by carrying an active-projects chip row on the card body."
  noindex={true}
  containerClass="px-6 py-12 max-w-6xl mx-auto"
>
  <header class="mb-8">
    <p class="text-sm uppercase tracking-[0.18em] mb-3" style="color: var(--color-text-muted); font-family: var(--font-code);">
      Design System · Sections
    </p>
    <h1 class="text-4xl md:text-5xl font-bold mb-3" style="font-family: var(--font-display); color: var(--color-text);">
      Section__WorkingGroupGallery
    </h1>
    <p style="color: var(--color-text-muted);">
      Sibling to <code style="font-family: var(--font-code); color: var(--color-primary);">Section__ProjectGallery</code> with the same four variants and CSS, but the data is enriched: each entry carries the WG plus its currently-active projects (pre-joined by the loader) so the card can show a small chip row of "current projects."
    </p>
  </header>

  <ModeThemeToggle />

  <section class="ds-block">
    <h2 class="ds-block-title">Variant: <code>portfolio</code> — Working Group Cards</h2>
    <p class="ds-block-note">
      Banner thumbnail + title + lede + leads + tag chips, plus an active-projects chip row showing 1–3 currently-running projects. Default for the active section on <code>/working-groups/</code>.
    </p>
    <Section__WorkingGroupGallery
      contextSetterTxt="In flight"
      headingTxt="Active Working Groups"
      introTxt="Communities of practice meeting on a regular cadence."
      entries={active}
      variant="portfolio"
    />
  </section>

  <section class="ds-block">
    <h2 class="ds-block-title">Variant: <code>mission-brief</code> — Number-badge dossier</h2>
    <p class="ds-block-note">
      Same projects in the alternate "standard" treatment. Echoes <code>AreasOfVentureGrid</code> rhythm — useful when WGs feel curriculum-shaped.
    </p>
    <Section__WorkingGroupGallery
      contextSetterTxt="Mission briefs"
      headingTxt="Same data, dossier treatment"
      entries={active}
      variant="mission-brief"
    />
  </section>

  <section class="ds-block">
    <h2 class="ds-block-title">Variant: <code>lite</code> — Open-call cards</h2>
    <p class="ds-block-note">
      No thumbnail. Dashed border. Used by the proposed section on <code>/working-groups/</code>.
    </p>
    <Section__WorkingGroupGallery
      contextSetterTxt="Open call"
      headingTxt="Proposed working groups"
      entries={proposed}
      variant="lite"
    />
  </section>

  <section class="ds-block">
    <h2 class="ds-block-title">Variant: <code>shelf</code> — Archive rows</h2>
    <p class="ds-block-note">
      Compact horizontal rows. Used by the archived section.
    </p>
    <Section__WorkingGroupGallery
      contextSetterTxt="Prior practice"
      headingTxt="Archive"
      entries={archived}
      variant="shelf"
    />
  </section>

  <details class="text-sm mt-8">
    <summary style="color: var(--color-text-muted); cursor: pointer; font-family: var(--font-code);">Props + tokens</summary>
    <pre class="mt-3 p-4 rounded overflow-x-auto" style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text); font-family: var(--font-code); font-size: 0.8125rem;">{`<Section__WorkingGroupGallery
  contextSetterTxt="In flight"
  headingTxt="Active Working Groups"
  introTxt="Optional intro paragraph."
  entries={entries}                // pre-joined: WorkingGroupWithProjects[]
                                   //   each = { wg, currentProjects }
  variant="portfolio"              // 'portfolio' | 'mission-brief' | 'lite' | 'shelf'
  emptyHide={true}                 // empty list renders nothing
/>

/* Tokens read */
--fx-card-bg, --fx-card-border, --fx-card-border-hover,
--fx-card-shadow, --fx-card-shadow-hover,
--color-text, --color-text-muted, --color-primary, --color-secondary,
--color-surface, --color-border, --color-background,
--color-status-active, --color-status-proposed, --color-status-archived,
--font-display, --font-body, --font-code`}</pre>
  </details>
</BaseThemeLayout>

<style is:global>
  .ds-block {
    margin-bottom: 4rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .ds-block:last-of-type { border-bottom: none; }
  .ds-block-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 1.5rem 0 0.5rem;
  }
  .ds-block-title code {
    color: var(--color-primary);
    font-family: var(--font-code);
    font-size: 0.875em;
    background: var(--color-surface);
    padding: 0.1em 0.3em;
    border-radius: 0.25rem;
    border: 1px solid var(--color-border);
  }
  .ds-block-note {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    line-height: 1.55;
  }
  .ds-block-note code {
    color: var(--color-primary);
    font-family: var(--font-code);
  }
</style>
