---
export const prerender = true;
import BaseThemeLayout from '../../../layouts/BaseThemeLayout.astro';
import ModeThemeToggle from '../../../components/ui/ModeThemeToggle.astro';
import JumboPopdown__Projects from '../../../components/ui/menus/JumboPopdown__Projects.astro';
import { loadProjectsForPopdown } from '../../../lib/load-projects';

const projects = await loadProjectsForPopdown({ showProposed: true, maxItems: 8 });
---

<BaseThemeLayout
  title="Component · JumboPopdown__Projects"
  description="Header dropdown that surfaces working-group projects."
  noindex={true}
  containerClass="px-6 py-12 max-w-6xl mx-auto"
>
  <header class="mb-8">
    <p class="text-sm uppercase tracking-[0.18em] mb-3" style="color: var(--color-text-muted); font-family: var(--font-code);">
      Design System · Components
    </p>
    <h1 class="text-4xl md:text-5xl font-bold mb-3" style="font-family: var(--font-display); color: var(--color-text);">
      JumboPopdown__Projects
    </h1>
    <p style="color: var(--color-text-muted);">
      Header-mounted dropdown that surfaces active (and optionally proposed) projects.
      Conforms to <code style="font-family: var(--font-code); color: var(--color-primary);">Jumbotron-Popdown-Patterns.md</code>.
      Hover or click to open. Esc closes. Arrow keys navigate.
    </p>
  </header>

  <ModeThemeToggle />

  <!-- Live: with proposed -->
  <section class="ds-block">
    <h2 class="ds-block-title">Default — active + proposed</h2>
    <p class="ds-block-note">
      As wired into <code>Header.astro</code>. Hover the trigger or tab to it and press Enter.
    </p>
    <div class="ds-popdown-stage">
      <JumboPopdown__Projects projects={projects} triggerLabelTxt="Projects" />
    </div>
  </section>

  <!-- Variant: active only -->
  <section class="ds-block">
    <h2 class="ds-block-title">Active only — <code>showProposed: false</code></h2>
    <p class="ds-block-note">
      Hides the proposed subgroup. Use on pages where the open-call shouldn't compete for attention.
    </p>
    <div class="ds-popdown-stage">
      <JumboPopdown__Projects projects={projects} triggerLabelTxt="Projects" showProposed={false} />
    </div>
  </section>

  <!-- A11y reference -->
  <section class="ds-block">
    <h2 class="ds-block-title">A11y checklist</h2>
    <ul class="ds-checklist">
      <li>Trigger is a real <code>&lt;button&gt;</code> with <code>aria-haspopup="menu"</code> and <code>aria-expanded</code>.</li>
      <li>Panel has <code>role="menu"</code>; items have <code>role="menuitem"</code>.</li>
      <li>Esc closes and returns focus to the trigger.</li>
      <li>Arrow up/down moves focus between items; Home/End jump to first/last.</li>
      <li>Click outside closes.</li>
      <li>Hover-open only on pointer:fine devices. Touch falls through to click.</li>
      <li>Animations are respected by <code>prefers-reduced-motion</code>.</li>
      <li>Mobile (<code>max-width: 720px</code>): becomes a bottom drawer.</li>
    </ul>
  </section>

  <details class="text-sm mt-8">
    <summary style="color: var(--color-text-muted); cursor: pointer; font-family: var(--font-code);">Props + tokens</summary>
    <pre class="mt-3 p-4 rounded overflow-x-auto" style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text); font-family: var(--font-code); font-size: 0.8125rem;">{`<JumboPopdown__Projects
  triggerLabelTxt="Projects"        /* nav-link text */
  projects={popdownProjects}        /* pre-loaded ProjectEntry[] */
  showProposed={true}               /* default true */
/>

/* Loader */
import { loadProjectsForPopdown } from '../../lib/load-projects';
const popdownProjects = await loadProjectsForPopdown({ showProposed: true, maxItems: 6 });

/* Tokens read */
--fx-card-bg, --fx-card-border, --fx-card-shadow-hover,
--color-text, --color-text-muted, --color-primary, --color-surface, --color-border,
--color-status-active, --color-status-proposed, --color-status-archived,
--font-display, --font-code`}</pre>
  </details>
</BaseThemeLayout>

<style is:global>
  .ds-block {
    margin-bottom: 4rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .ds-block:last-of-type { border-bottom: none; }
  .ds-block-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 1.5rem 0 0.5rem;
  }
  .ds-block-title code {
    color: var(--color-primary);
    font-family: var(--font-code);
    font-size: 0.875em;
    background: var(--color-surface);
    padding: 0.1em 0.3em;
    border-radius: 0.25rem;
    border: 1px solid var(--color-border);
  }
  .ds-block-note {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    line-height: 1.55;
  }
  .ds-block-note code {
    color: var(--color-primary);
    font-family: var(--font-code);
  }
  .ds-popdown-stage {
    padding: 4rem 1.5rem 8rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    display: flex;
    justify-content: center;
  }
  .ds-checklist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--color-text);
  }
  .ds-checklist li {
    padding-left: 1.25rem;
    position: relative;
    line-height: 1.55;
  }
  .ds-checklist li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-status-active);
    font-family: var(--font-code);
    font-weight: 600;
  }
  .ds-checklist code {
    color: var(--color-primary);
    font-family: var(--font-code);
    font-size: 0.9em;
  }
</style>
