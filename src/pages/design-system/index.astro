---
export const prerender = true;
import BaseThemeLayout from '../../layouts/BaseThemeLayout.astro';
import ModeThemeToggle from '../../components/ui/ModeThemeToggle.astro';
import WebinarCard from '../../components/webinars/WebinarCard.astro';
import TextLinkSpan from '../../components/buttons/TextLinkSpan.astro';
import ContentPreviewNavCard from '../../components/read/ContentPreviewNavCard.astro';

// Synthetic data so all three status variants are inspectable side by side.
const sampleData = {
  title: 'Sample · How agents reshape diligence',
  lede: 'A workshop on wiring an agentic research loop into a junior analyst workflow.',
  durationMinutes: 60,
  presenters: ['Lead Presenter', 'Co-host'],
  rsvpUrl: 'https://example.com/rsvp',
  recordingUrl: 'https://example.com/recording',
};
const upcomingDate = new Date(Date.now() + 14 * 24 * 60 * 60 * 1000); // 14 days out
const liveDate = new Date(Date.now() - 5 * 60 * 1000);                // started 5 min ago
const recordedDate = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000); // 30 days ago

const fxTokens = [
  { token: '--fx-glow-opacity',     desc: 'Base glow opacity (0–1) — light: subtle, dark: moderate, vibrant: max' },
  { token: '--fx-glow-spread',      desc: 'Glow spread radius — scales with mode intensity' },
  { token: '--fx-card-bg',          desc: 'Card background, mode-adaptive' },
  { token: '--fx-card-border',      desc: 'Card border at rest' },
  { token: '--fx-card-border-hover',desc: 'Card border on hover' },
  { token: '--fx-card-shadow',      desc: 'Card shadow at rest' },
  { token: '--fx-card-shadow-hover',desc: 'Card shadow on hover' },
  { token: '--fx-headline-gradient',desc: 'Display headline gradient — none in light, gradient in dark/vibrant' },
  { token: '--fx-flare-color',      desc: 'Color for canvas/Three.js elements (resolved via getComputedStyle)' },
];

const components = [
  {
    name: 'ModeThemeToggle',
    purpose: 'The 3-mode + theme toggle widget used on /brand-kit and /design-system.',
    cssContract: '--color-primary, --color-text, --color-text-muted, --color-border, --fx-card-bg, --fx-card-border, --font-code',
    props: '— (no props yet)',
  },
  {
    name: 'BaseThemeLayout',
    purpose: 'Site-wide layout wrapper. Applies theme class on <html>, boots theme + mode switchers, imports global.css.',
    cssContract: '(none directly — sets up the contract for descendants)',
    props: 'title, description, themeClass, noindex, containerClass',
  },
  {
    name: 'BoilerPlateHTML',
    purpose: 'Bare HTML skeleton with pre-paint mode-application script (avoids FOUC).',
    cssContract: '(none directly)',
    props: 'title, description, themeClass, favicon, noindex',
  },
  {
    name: 'WebinarCard',
    purpose: 'Calendar-style card for webinars collection entries; status inferred from date_scheduled.',
    cssContract: '--fx-card-*, --color-text, --color-text-muted, --color-primary, --color-accent, --color-surface, --color-border, --font-display, --font-code',
    props: 'data, href?, statusOverride?',
  },
  {
    name: 'BannerWithOverlay',
    purpose: 'Composites brand-font HTML title text over an Ideogram-generated, text-stripped base image. Used for changelog banners. Mode-aware scrim adapts to light/dark/vibrant.',
    cssContract: '--color-border, --color-surface, --color__bone, --color__obsidian, --color__ink, --color__lime-terminal, --font-display, --font-body, --font-code',
    props: 'src, title, eyebrow?, subtitle?, alt?, href?',
  },
  {
    name: 'Header',
    purpose: 'Sticky site chrome — wordmark + nav + ModeToggle. Rendered by BaseThemeLayout on every page.',
    cssContract: '--color-background, --color-border, --color-text, --color-text-muted, --color-primary, --font-display, --font-code',
    props: '— (no props)',
  },
  {
    name: 'ModeToggle',
    purpose: '3-mode chrome cycle button (light → dark → vibrant). Reads window.modeSwitcher; CSS-driven icon visibility.',
    cssContract: '--color-text, --color-border, --color-primary',
    props: '— (no props)',
  },
  {
    name: 'SocialsFaviconRow',
    purpose: 'Universal social-icon row. Pass a URL per platform to show that link; omit to hide. Renders nothing if no platforms passed. Brand-aware hover via --color-primary so the row tracks the active mode.',
    cssContract: '--color-text-muted, --color-primary',
    props: 'github?, linkedin?, twitter?, bluesky?, instagram?, youtube?, mastodon?, email?, rss?, size?, class?',
  },
  {
    name: 'HeroContentCoreMessage',
    purpose: 'Primary hero composition for marketing pages. Eyebrow + h1 (gradient via --fx-headline-gradient) + h2 + supporting paragraph + optional CTA. Used on /dojo as the 2/3-width hero.',
    cssContract: '--font-display, --font-body, --font-code, --color-text, --color-text-muted, --color-primary, --color__bone, --fx-headline-gradient, --fx-card-shadow, --fx-card-shadow-hover',
    props: 'contextSetter?, headerTxt, subheaderTxt?, supportingTxt?, ctaHref?, ctaLabel?',
  },
  {
    name: 'AlternateCta',
    purpose: 'Secondary card-style CTA that lives next to a hero (typically 1/3 width). Title + body HTML + trailing attribution + optional secondary action. Mode-aware card surface.',
    cssContract: '--fx-card-bg, --fx-card-border, --fx-card-border-hover, --fx-card-shadow, --fx-card-shadow-hover, --color-text, --color-text-muted, --color-primary, --color-border, --font-display, --font-body, --font-code',
    props: 'title?, bodyHtml, trailingHtml?, ctaHref?, ctaLabel?',
  },
  {
    name: 'TextLinkSpan',
    purpose: 'Inline-flex row of subtle text links auto-separated by a bright dot. Children are plain <a> tags; the dot is inserted between them by CSS pseudo-elements. Used for low-emphasis nav rows (e.g. footer-style links inline below a primary CTA).',
    cssContract: '--color-text-muted, --color-text, --color-primary, --font-code; internal: --tls-width, --tls-min-width, --tls-max-width, --tls-separator, --tls-separator-color (all overridable via props)',
    props: 'width?, minWidth?, maxWidth? (defaults: auto / max-content / 80%); separator? (default "•"); separatorColor? (default var(--color-primary)); class?',
  },
  {
    name: 'AreasOfVentureGrid',
    purpose: 'Section that renders a 1/2/3-column responsive grid of "areas of venture" cards. Sourced from the Venture Handbook chapter structure; used at the bottom of /dojo.',
    cssContract: '--fx-card-bg, --fx-card-border, --fx-card-border-hover, --fx-card-shadow, --fx-card-shadow-hover, --color-text, --color-text-muted, --color-primary, --color-border, --font-display, --font-body, --font-code',
    props: 'eyebrow?, heading?, intro?, areas: Area[]  (number, title, lede, tags? — marketing hooks, not structural sub-sections)',
  },
  {
    name: 'BookReaderLayout',
    purpose: 'Page chrome around a single chapter. Wraps BaseThemeLayout. Composes ReadingProgressBar + skip link + top triptych (prev card + banner + next card) + ChapterMeta + tags + "in this chapter" outline + body slot + bottom prev/next cards. Container queries (NOT viewport media) drive four layout modes (Mobile / Tablet / Half-Screen / Desktop) per width AND aspect ratio.',
    cssContract: '--fx-card-bg, --fx-card-border, --fx-card-border-hover, --fx-card-shadow, --fx-card-shadow-hover, --color-text, --color-text-muted, --color-primary, --color-accent, --color-surface, --color-border, --color-background, --color__bone, --font-display, --font-body, --font-code; declares container-type: inline-size, container-name: reader on .book-reader-page; sets --reader-column, --reader-outer, --reader-card-width, --reader-prose-size by mode',
    props: 'title, description?, chapterNumber, chapterTitle, chapterLede?, chapterEyebrow?, bannerSrc?, tags?, subsectionOutline?, readingMinutes?, wordCount?, author?, updated?, sourceOrganization?, prev?, next?, backHref?, backLabel?',
  },
  {
    name: 'ReadingProgressBar',
    purpose: 'Thin top-of-viewport stripe that tracks scroll position relative to the article body bounding rect (not the viewport). 3px tall, --color-primary fill, rAF-throttled scroll listener. Inline <script> via define:vars; respects prefers-reduced-motion (kills the width transition).',
    cssContract: '--color-primary; uses color-mix() for the glow shadow',
    props: 'target? (CSS selector for article body, default ".book-reader__body")',
  },
  {
    name: 'ChapterMeta',
    purpose: 'Slim, code-font row immediately below the chapter banner. Renders Chapter NN · X min read · word count · author · updated date · source org as a horizontal definition-list. Reading time computed by caller as ceil(words / 220).',
    cssContract: '--color-text, --color-text-muted, --color-primary, --color-border, --font-code',
    props: 'chapterNumber, readingMinutes?, wordCount?, author?, updated?, sourceOrganization?',
  },
  {
    name: 'FormattedDate',
    purpose: 'Renders a date (Date object, ISO date string, or full ISO timestamp) in one of a small set of named styles inside a semantic <time datetime="YYYY-MM-DD"> element. Default style "long" → "April 26, 2026" (preferred for body prose and chapter meta). Other styles: "medium", "short", "iso", "reverse-medium" ("2026, Apr. 26"), "year-only". Backed by lib/format-date.ts which handles UTC normalization to avoid timezone-shift bugs.',
    cssContract: '(none — inherits from context; passes through optional class= prop to the <time> element)',
    props: 'date: Date | string | null; style?: "long" | "medium" | "short" | "iso" | "reverse-medium" | "year-only" (default "long"); class?',
  },
  {
    name: 'ContentPreviewNavCard',
    purpose: 'Prev / next chapter preview card. Visual echo of AreasOfVentureGrid (--fx-card-* tokens, number-in-corner motif, lede + tags rhythm) with direction-aware chevron (top-left for prev, top-right for next). Two variants: "inline" adapts to reader container size — full → slim → chevron-only — for the top triptych; "block" is always full for chapter-end placement.',
    cssContract: '--fx-card-bg, --fx-card-border, --color-primary, --color-text, --color-text-muted, --color-border, --font-display, --font-body, --font-code; uses container queries on the reader container',
    props: 'direction: "prev"|"next", number, title, lede?, tags?, href, maxHeight?, ledeLineClamp? (default 4), variant?: "inline"|"block" (default "inline")',
  },
  {
    name: 'HeroBannerWithMessageHierarchy',
    purpose: 'Image-banner hero that wraps HeroContentCoreMessage. Three heights (short/standard/tall) × three overlays (gradient/scrim/none) × two alignments (left/center). Used by /projects/ and any project detail page that has a hero_image.',
    cssContract: '--color-background, --color-surface, --color-text, --color-text-muted, --color-primary, --fx-headline-gradient, --fx-card-shadow, --fx-card-shadow-hover, --font-display, --font-body, --font-code',
    props: 'image, imageAlt?, overlay?, align?, height?, contextSetterTxt?, headerTxt, subheaderTxt?, supportingTxt?, ctaLabelTxt?, ctaHref?  → demo: /design-system/heroes/hero-banner-with-message-hierarchy',
  },
  {
    name: 'Section__ProjectGallery',
    purpose: 'Renders a filtered set of projects in one of four variants: portfolio (Working Group Cards — default for active), mission-brief (numbered dossier — alternate "standard"), lite (proposed — dashed), shelf (archive — compact rows). Empty list + emptyHide → renders nothing.',
    cssContract: '--fx-card-bg, --fx-card-border, --fx-card-border-hover, --fx-card-shadow, --fx-card-shadow-hover, --color-text, --color-text-muted, --color-primary, --color-secondary, --color-surface, --color-border, --color-background, --color-status-active, --color-status-proposed, --color-status-archived, --font-display, --font-body, --font-code',
    props: 'contextSetterTxt?, headingTxt?, introTxt?, projects: ProjectEntry[], variant?: "portfolio"|"mission-brief"|"lite"|"shelf" (default "portfolio"), emptyHide?: boolean (default true)  → demo: /design-system/sections/project-gallery',
  },
  {
    name: 'JumboPopdown__Projects',
    purpose: 'Header-mounted dropdown surfacing active (and optionally proposed) working-group projects. Conforms to context-v/blueprints/Jumbotron-Popdown-Patterns.md. Hover-open + click-toggle, Esc closes, arrow keys navigate, mobile becomes a bottom drawer.',
    cssContract: '--fx-card-bg, --fx-card-border, --fx-card-shadow-hover, --color-text, --color-text-muted, --color-primary, --color-surface, --color-border, --color-status-*, --font-display, --font-code',
    props: 'triggerLabelTxt? (default "Projects"), projects: ProjectEntry[], showProposed?: boolean (default true)  → demo: /design-system/components/jumbo-popdown-projects',
  },
  {
    name: 'ProjectMetadataDisplay',
    purpose: 'Below-hero metadata strip on /projects/[slug]/. Status pill, cadence, last-activity timestamp, leads + members with avatars (initials fallback), external link icon row, optional RSVP CTA, scope paragraph.',
    cssContract: '--fx-card-bg, --fx-card-border, --fx-card-shadow, --color-text, --color-text-muted, --color-primary, --color-surface, --color-border, --color-status-*, --color__bone, --font-display, --font-code',
    props: 'project: ProjectEntry',
  },
  {
    name: 'MarkdownReader',
    purpose: 'Generic LFM-rendered reading column. Used by /projects/[slug]/ and /working-groups/[slug]/. Wraps an MDAST tree in a 70ch prose container with global heading/paragraph/list styles. Top chrome: optional back-link (configurable via backHref/backLabelTxt) + optional "Edit on source" link. Renders Sources when citations are present. Renamed from ProjectReader to make non-domain reuse explicit.',
    cssContract: '--color-text, --color-text-muted, --color-primary, --color-surface, --color-border, --font-display, --font-body, --font-code',
    props: 'tree: MDAST root, citations?: Citation[], editUrl?, backHref? (default "/projects/"), backLabelTxt? (default "All projects")  → demo: /design-system/markdown/markdown-reader',
  },
  {
    name: 'Section__WorkingGroupGallery',
    purpose: 'Sibling to Section__ProjectGallery — same four variants and CSS, but the data shape is enriched: each entry carries the WorkingGroupEntry plus its currently-active projects (pre-joined by the loader). The portfolio and mission-brief variant cards add a small chip row showing 1–3 of the WG\'s active projects, which is the headline differentiator vs. project cards.',
    cssContract: '--fx-card-bg, --fx-card-border, --fx-card-border-hover, --fx-card-shadow, --fx-card-shadow-hover, --color-text, --color-text-muted, --color-primary, --color-secondary, --color-surface, --color-border, --color-background, --color-status-active, --color-status-proposed, --color-status-archived, --font-display, --font-body, --font-code',
    props: 'contextSetterTxt?, headingTxt?, introTxt?, entries: WorkingGroupWithProjects[], variant?: "portfolio"|"mission-brief"|"lite"|"shelf" (default "portfolio"), emptyHide?: boolean (default true)  → demo: /design-system/sections/working-group-gallery',
  },
  {
    name: 'JumboPopdown__WorkingGroups',
    purpose: 'Sibling to JumboPopdown__Projects. Header-mounted dropdown surfacing active (and optionally proposed) working groups. Same hover-open + click-toggle, Esc closes, arrow keys navigate, mobile becomes a bottom drawer. Mounted in Header.astro alongside the Projects popdown.',
    cssContract: '--fx-card-bg, --fx-card-border, --fx-card-shadow-hover, --color-text, --color-text-muted, --color-primary, --color-surface, --color-border, --color-status-*, --font-display, --font-code',
    props: 'triggerLabelTxt? (default "Working Groups"), workingGroups: WorkingGroupEntry[], showProposed?: boolean (default true)  → demo: /design-system/components/jumbo-popdown-working-groups',
  },
  {
    name: 'WorkingGroupMetadataDisplay',
    purpose: 'Sibling to ProjectMetadataDisplay. Below-hero metadata strip on /working-groups/[slug]/. Same shape because the WG schema is currently a clone of the projects schema: status pill, cadence, last-activity timestamp, leads + members rosters, external link icon row, optional RSVP CTA, scope paragraph.',
    cssContract: '--fx-card-bg, --fx-card-border, --fx-card-shadow, --color-text, --color-text-muted, --color-primary, --color-surface, --color-border, --color-status-*, --color__bone, --font-display, --font-code',
    props: 'workingGroup: WorkingGroupEntry',
  },
];
---

<BaseThemeLayout
  title="Design System · FullStack VC"
  description="Component catalog: variants, props, CSS contracts, mode-specific behavior."
  noindex={true}
  containerClass="px-6 py-12 max-w-6xl mx-auto"
>
  <header class="mb-8">
    <p class="text-sm uppercase tracking-[0.18em] mb-3" style="color: var(--color-text-muted); font-family: var(--font-code);">
      Internal · Design System
    </p>
    <h1 class="text-4xl md:text-5xl font-bold mb-3" style="font-family: var(--font-display); color: var(--color-text);">
      Component catalog
    </h1>
    <p style="color: var(--color-text-muted);">
      Every component used on the site, with variants visible in all three modes. New components land here in the same change that introduces them.
    </p>
  </header>

  <ModeThemeToggle />

  <!-- Card variants -->
  <section class="mb-16">
    <h2 class="text-2xl font-semibold mb-2" style="font-family: var(--font-display); color: var(--color-text);">Card</h2>
    <p class="mb-6" style="color: var(--color-text-muted);">
      Surface element using <code style="font-family: var(--font-code); color: var(--color-primary);">--fx-card-*</code> tokens.
      Mode determines shadow intensity, border treatment, and hover behavior.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      <div class="ds-card">
        <h3 class="ds-card-title">Rest</h3>
        <p class="ds-card-body">Default card surface in current mode.</p>
      </div>
      <div class="ds-card ds-card-hover">
        <h3 class="ds-card-title">Hover state</h3>
        <p class="ds-card-body">Forced hover styling for inspection.</p>
      </div>
      <div class="ds-card">
        <h3 class="ds-card-title">With code</h3>
        <p class="ds-card-body" style="font-family: var(--font-code); font-size: 0.875rem;">{`const dojo = await VCDojo.start();`}</p>
      </div>
    </div>

    <details class="text-sm">
      <summary style="color: var(--color-text-muted); cursor: pointer; font-family: var(--font-code);">CSS contract + usage</summary>
      <pre class="mt-3 p-4 rounded overflow-x-auto" style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text); font-family: var(--font-code); font-size: 0.8125rem;">{`<div class="ds-card">
  <h3 class="ds-card-title">Title</h3>
  <p class="ds-card-body">Body</p>
</div>

/* Tokens read */
--fx-card-bg, --fx-card-border, --fx-card-border-hover,
--fx-card-shadow, --fx-card-shadow-hover,
--color-text, --color-text-muted, --font-display`}</pre>
    </details>
  </section>

  <!-- WebinarCard -->
  <section class="mb-16">
    <h2 class="text-2xl font-semibold mb-2" style="font-family: var(--font-display); color: var(--color-text);">WebinarCard</h2>
    <p class="mb-6" style="color: var(--color-text-muted);">
      Calendar-style card for the <code style="font-family: var(--font-code); color: var(--color-primary);">webinars</code> collection.
      Status (<em>Upcoming / Live / Recorded</em>) is inferred at render time from <code style="font-family: var(--font-code);">date_scheduled</code> via <code style="font-family: var(--font-code);">inferWebinarStatus()</code>.
    </p>
    <div class="grid grid-cols-1 gap-4 mb-4">
      <WebinarCard data={{ ...sampleData, date_scheduled: upcomingDate }} statusOverride="Upcoming" />
      <WebinarCard data={{ ...sampleData, date_scheduled: liveDate }}     statusOverride="Live" />
      <WebinarCard data={{ ...sampleData, date_scheduled: recordedDate }} statusOverride="Recorded" />
    </div>
    <details class="text-sm">
      <summary style="color: var(--color-text-muted); cursor: pointer; font-family: var(--font-code);">Props + tokens</summary>
      <pre class="mt-3 p-4 rounded overflow-x-auto" style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text); font-family: var(--font-code); font-size: 0.8125rem;">{`<WebinarCard data={entry.data} href="/webinars/[id]" />

/* Props */
data:           { title, lede?, date_scheduled, durationMinutes?,
                  presenters?, rsvpUrl?, recordingUrl? }
href?:          link to detail page
statusOverride?: 'Upcoming' | 'Live' | 'Recorded' (design-system use only)

/* Tokens read */
--fx-card-bg, --fx-card-border, --fx-card-border-hover,
--fx-card-shadow, --fx-card-shadow-hover,
--color-text, --color-text-muted, --color-primary, --color-accent,
--color-surface, --color-border, --color__bone,
--font-display, --font-code`}</pre>
    </details>
  </section>

  <!-- Buttons -->
  <section class="mb-16">
    <h2 class="text-2xl font-semibold mb-2" style="font-family: var(--font-display); color: var(--color-text);">Buttons</h2>
    <p class="mb-6" style="color: var(--color-text-muted);">Primary, secondary (outlined), ghost.</p>
    <div class="flex flex-wrap gap-3 mb-6">
      <button class="ds-btn ds-btn-primary">Primary</button>
      <button class="ds-btn ds-btn-secondary">Secondary</button>
      <button class="ds-btn ds-btn-ghost">Ghost</button>
      <button class="ds-btn ds-btn-primary" disabled>Disabled</button>
    </div>
  </section>

  <!-- TextLinkSpan -->
  <section class="mb-16">
    <h2 class="text-2xl font-semibold mb-2" style="font-family: var(--font-display); color: var(--color-text);">TextLinkSpan</h2>
    <p class="mb-6" style="color: var(--color-text-muted);">
      Subtle text-link row with an auto-inserted bright dot between children. Pass plain <code style="font-family: var(--font-code); color: var(--color-primary);">&lt;a&gt;</code> tags — the separator comes from CSS.
    </p>

    <div class="flex flex-col gap-6 mb-6 p-6 rounded-lg" style="background: var(--fx-card-bg); border: 1px solid var(--fx-card-border);">
      <div>
        <p class="text-xs mb-2" style="color: var(--color-text-muted); font-family: var(--font-code);">Default</p>
        <TextLinkSpan>
          <a href="/brand-kit">Brand Kit</a>
          <a href="/design-system">Design System</a>
        </TextLinkSpan>
      </div>

      <div>
        <p class="text-xs mb-2" style="color: var(--color-text-muted); font-family: var(--font-code);">Three links</p>
        <TextLinkSpan>
          <a href="/brand-kit">Brand Kit</a>
          <a href="/design-system">Design System</a>
          <a href="/changelog">Changelog</a>
        </TextLinkSpan>
      </div>

      <div>
        <p class="text-xs mb-2" style="color: var(--color-text-muted); font-family: var(--font-code);">Custom separator (slash) + accent color</p>
        <TextLinkSpan separator="/" separatorColor="var(--color-accent)">
          <a href="/brand-kit">Brand Kit</a>
          <a href="/design-system">Design System</a>
          <a href="/changelog">Changelog</a>
        </TextLinkSpan>
      </div>

      <div>
        <p class="text-xs mb-2" style="color: var(--color-text-muted); font-family: var(--font-code);">Constrained width (maxWidth=320px)</p>
        <TextLinkSpan maxWidth="320px">
          <a href="/brand-kit">Brand Kit</a>
          <a href="/design-system">Design System</a>
          <a href="/changelog">Changelog</a>
          <a href="/webinars">Webinars</a>
        </TextLinkSpan>
      </div>
    </div>

    <details class="text-sm">
      <summary style="color: var(--color-text-muted); cursor: pointer; font-family: var(--font-code);">Props + tokens</summary>
      <pre class="mt-3 p-4 rounded overflow-x-auto" style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-text); font-family: var(--font-code); font-size: 0.8125rem;">{`<TextLinkSpan>
  <a href="/brand-kit">Brand Kit</a>
  <a href="/design-system">Design System</a>
</TextLinkSpan>

/* Props (all optional) */
width?:           CSS width        (default: auto)
minWidth?:        CSS min-width    (default: max-content — keeps links on one line)
maxWidth?:        CSS max-width    (default: 80%)
separator?:       glyph            (default: "•")
separatorColor?:  CSS color        (default: var(--color-primary))
class?:           extra class name(s)

/* Tokens read */
--color-text-muted, --color-text, --color-primary, --font-code

/* Internal CSS vars (overridable via props above) */
--tls-width, --tls-min-width, --tls-max-width,
--tls-separator, --tls-separator-color`}</pre>
    </details>
  </section>

  <!-- ContentPreviewNavCard -->
  <section class="mb-16">
    <h2 class="text-2xl font-semibold mb-2" style="font-family: var(--font-display); color: var(--color-text);">ContentPreviewNavCard</h2>
    <p class="mb-6" style="color: var(--color-text-muted);">
      Prev / next chapter card used by <code style="font-family: var(--font-code); color: var(--color-primary);">BookReaderLayout</code>.
