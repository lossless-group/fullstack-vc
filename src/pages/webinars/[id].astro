---
export const prerender = true;
import { getCollection } from 'astro:content';
import { parseMarkdown } from '@lossless-group/lfm';
import BaseThemeLayout from '../../layouts/BaseThemeLayout.astro';
import AstroMarkdown from '../../components/markdown/AstroMarkdown.astro';
import Sources from '../../components/markdown/Sources.astro';
import { inferWebinarStatus } from '../../lib/webinar-status';

export async function getStaticPaths() {
  const webinars = await getCollection('webinars');
  return webinars.map(entry => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;
const status = inferWebinarStatus(data);

const tree = await parseMarkdown(entry.body ?? '');
const citations = (tree as any).data?.citations?.ordered ?? [];

const date = data.date_scheduled;
const month = date.toLocaleString('en-US', { month: 'short', timeZone: 'America/New_York' }).toUpperCase();
const day = date.toLocaleString('en-US', { day: 'numeric', timeZone: 'America/New_York' });
const weekday = date.toLocaleString('en-US', { weekday: 'long', timeZone: 'America/New_York' });
const year = date.getFullYear();
const time = date.toLocaleString('en-US', {
  hour: 'numeric',
  minute: '2-digit',
  hour12: true,
  timeZone: 'America/New_York',
  timeZoneName: 'short',
});

const presentersStr = (data.presenters ?? []).join(' · ');
const ctaHref = status === 'Recorded' ? data.recordingUrl : data.rsvpUrl;
const ctaLabel = status === 'Recorded' ? 'Watch recording' : status === 'Live' ? 'Join now' : 'RSVP';
---

<BaseThemeLayout
  title={`${data.title} · Agentic VC Dojo`}
  description={data.lede ?? `Webinar: ${data.title}`}
  image="/og-default.jpg"
  ogType="article"
  containerClass="px-6 py-12 max-w-3xl mx-auto"
>
  <a href="/webinars" class="back-link">← All sessions</a>

  <article class={`webinar-detail webinar-detail--${status.toLowerCase()}`}>
    <header class="webinar-detail__head">
      <div class="webinar-detail__date" aria-hidden="true">
        <span class="webinar-detail__date-month">{month}</span>
        <span class="webinar-detail__date-day">{day}</span>
        <span class="webinar-detail__date-weekday">{weekday}</span>
        <span class="webinar-detail__date-year">{year}</span>
      </div>

      <div class="webinar-detail__head-text">
        <span class={`webinar-detail__status webinar-detail__status--${status.toLowerCase()}`}>
          {status === 'Live' && <span class="webinar-detail__status-dot" aria-hidden="true"></span>}
          {status}
        </span>
        <h1 class="webinar-detail__title">{data.title}</h1>
        {data.lede && <p class="webinar-detail__lede">{data.lede}</p>}
      </div>
    </header>

    <dl class="webinar-detail__meta">
      <div class="webinar-detail__meta-row">
        <dt>When</dt>
        <dd>{weekday}, {month} {day} · {time} · {data.durationMinutes ?? 60} min</dd>
      </div>
      {presentersStr && (
        <div class="webinar-detail__meta-row">
          <dt>With</dt>
          <dd>{presentersStr}</dd>
        </div>
      )}
      {data.tags && data.tags.length > 0 && (
        <div class="webinar-detail__meta-row">
          <dt>Tags</dt>
          <dd>
            {data.tags.map(tag => <span class="webinar-detail__tag">{tag}</span>)}
          </dd>
        </div>
      )}
    </dl>

    {ctaHref && (
      <a
        href={ctaHref}
        class="webinar-detail__cta"
        target={status === 'Recorded' ? '_blank' : undefined}
        rel={status === 'Recorded' ? 'noopener noreferrer' : undefined}
      >
        {ctaLabel}
        <span aria-hidden="true">→</span>
      </a>
    )}

    <div class="webinar-detail__body">
      <AstroMarkdown node={tree} />
      <Sources citations={citations} />
    </div>
  </article>
</BaseThemeLayout>

<style>
  .back-link {
    display: inline-block;
    font-family: var(--font-code);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color 150ms ease;
  }
  .back-link:hover { color: var(--color-primary); }

  .webinar-detail {
    padding: 2rem;
    border-radius: 1rem;
    background: var(--fx-card-bg);
    border: 1px solid var(--fx-card-border);
    box-shadow: var(--fx-card-shadow);
  }

  /* Header — date column on the left, text on the right */
  .webinar-detail__head {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .webinar-detail__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.25rem 0.75rem;
    border-radius: 0.875rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    text-align: center;
  }
  .webinar-detail__date-month {
    font-family: var(--font-code);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-primary);
  }
  .webinar-detail__date-day {
    font-family: var(--font-display);
    font-size: 4.5rem;
    line-height: 1;
    font-weight: 700;
    color: var(--color-text);
    margin: 0.375rem 0;
  }
  .webinar-detail__date-weekday {
    font-family: var(--font-code);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-text);
  }
  .webinar-detail__date-year {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-top: 0.125rem;
  }

  .webinar-detail__head-text { min-width: 0; }

  /* Status badge — same shape as card, bigger */
  .webinar-detail__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-family: var(--font-code);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    margin-bottom: 0.875rem;
  }
  .webinar-detail__status--upcoming { color: var(--color-primary); }
  .webinar-detail__status--live     { color: var(--color-accent); }
  .webinar-detail__status--recorded { color: var(--color-text-muted); }
  .webinar-detail__status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    animation: webinar-detail-pulse 1.4s ease-in-out infinite;
  }
  @keyframes webinar-detail-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.45; transform: scale(0.85); }
  }

  .webinar-detail__title {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1.15;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }
  .webinar-detail__lede {
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--color-text);
    margin: 0;
  }

  /* Meta */
  .webinar-detail__meta {
    margin: 0 0 1.75rem;
    padding: 1rem 1.25rem;
    border-radius: 0.625rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: 0.9375rem;
  }
  .webinar-detail__meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    align-items: baseline;
    padding: 0.375rem 0;
  }
  .webinar-detail__meta-row + .webinar-detail__meta-row {
    border-top: 1px dashed var(--color-border);
  }
  .webinar-detail__meta-row dt {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    min-width: 4rem;
  }
  .webinar-detail__meta-row dd {
    margin: 0;
    color: var(--color-text);
  }
  .webinar-detail__tag {
    display: inline-block;
    font-family: var(--font-code);
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    margin-right: 0.375rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  /* CTA */
  .webinar-detail__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1.25rem;
    border-radius: 0.625rem;
    background: var(--color-primary);
    color: var(--color__bone);
    font-family: var(--font-code);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    margin-bottom: 2rem;
    transition: box-shadow 150ms ease, transform 150ms ease;
  }
  .webinar-detail__cta:hover {
    box-shadow: var(--fx-card-shadow-hover);
    transform: translateX(2px);
  }
  .webinar-detail--recorded .webinar-detail__cta {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .webinar-detail--recorded .webinar-detail__cta:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* Body markdown — minimal scoped prose styles to counter Tailwind preflight */
  .webinar-detail__body {
    color: var(--color-text);
    line-height: 1.65;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }
  .webinar-detail__body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    margin: 1.75rem 0 0.75rem;
    color: var(--color-text);
  }
  .webinar-detail__body :global(h3) {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
    color: var(--color-text);
  }
  .webinar-detail__body :global(p) {
    margin: 0 0 1em;
  }
  .webinar-detail__body :global(ul) {
    list-style: disc;
    padding-left: 1.5em;
    margin: 0 0 1em;
  }
  .webinar-detail__body :global(ol) {
    list-style: decimal;
    padding-left: 1.5em;
    margin: 0 0 1em;
  }
  .webinar-detail__body :global(li) { margin-bottom: 0.25em; }
  .webinar-detail__body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .webinar-detail__body :global(code) {
    font-family: var(--font-code);
    font-size: 0.875em;
    padding: 0.125em 0.375em;
    border-radius: 0.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .webinar-detail__body :global(pre) {
    font-family: var(--font-code);
    font-size: 0.875rem;
    padding: 1rem;
    border-radius: 0.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    overflow-x: auto;
    margin: 0 0 1em;
  }
  .webinar-detail__body :global(pre code) {
    background: transparent;
    border: 0;
    padding: 0;
  }
  .webinar-detail__body :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    padding-left: 1rem;
    margin: 0 0 1em;
    color: var(--color-text-muted);
    font-style: italic;
  }
  .webinar-detail__body :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 1.75rem 0;
  }
  .webinar-detail__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.25em;
    font-size: 0.9375rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .webinar-detail__body :global(thead) {
    background: var(--color-surface);
  }
  .webinar-detail__body :global(th),
  .webinar-detail__body :global(td) {
    text-align: left;
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }
  .webinar-detail__body :global(th) {
    font-family: var(--font-code);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .webinar-detail__body :global(tbody tr:last-child td) { border-bottom: 0; }
  .webinar-detail__body :global(tbody tr:hover) {
    background: color-mix(in srgb, var(--color-primary) 4%, transparent);
  }
  .webinar-detail__body :global(sup a) {
    text-decoration: none;
    padding: 0 0.2em;
    border-radius: 0.2em;
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    color: var(--color-primary);
    font-size: 0.7em;
    font-weight: 600;
  }

  /* Responsive — collapse the date column on narrow screens */
  @media (max-width: 600px) {
    .webinar-detail { padding: 1.5rem; }
    .webinar-detail__head { grid-template-columns: 1fr; gap: 1rem; }
    .webinar-detail__date {
      flex-direction: row;
      gap: 0.5rem;
      padding: 0.75rem 1rem;
      justify-content: flex-start;
    }
    .webinar-detail__date-day { font-size: 2rem; margin: 0; }
    .webinar-detail__title { font-size: 1.75rem; }
  }
</style>
