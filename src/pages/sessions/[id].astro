---
// SSR per blueprint v2 §4.1: live session pages need per-request access to
// OAuth cookies (auth state for the poll voting UI) and to the latest Poll +
// PollResult rows from Astro DB. Dropping prerender + getStaticPaths so the
// route is dynamic; recorded-webinar pages still benefit from Vercel's edge
// caching of SSR responses.
import { getCollection } from 'astro:content';
import { db, Session as DbSession, Poll as DbPoll, PollResult as DbPollResult, eq } from 'astro:db';
import { parseMarkdown } from '@lossless-group/lfm';
import BaseThemeLayout from '../../layouts/BaseThemeLayout.astro';
import AstroMarkdown from '../../components/markdown/AstroMarkdown.astro';
import Sources from '../../components/markdown/Sources.astro';
import { inferWebinarStatus } from '../../lib/webinar-status';
import Section__WebinarSurveyStats from '../../components/sections/Section__WebinarSurveyStats.astro';
import Section__WebinarSurveyPolls from '../../components/sections/Section__WebinarSurveyPolls.astro';
import Section__WebinarFirmsRepresented from '../../components/sections/Section__WebinarFirmsRepresented.astro';
import Section__WebinarSurveyVoices from '../../components/sections/Section__WebinarSurveyVoices.astro';
import Section__WebinarPresenters from '../../components/sections/Section__WebinarPresenters.astro';
import Section__WebinarReflection from '../../components/sections/Section__WebinarReflection.astro';
import Section__BreakoutsTeaser from '../../components/sections/Section__BreakoutsTeaser.astro';
import Section__LPSyndicationPulse from '../../components/sections/Section__LPSyndicationPulse.astro';
import PollEmbed from '../../components/polls/PollEmbed.svelte';
import { verifySession, SESSION_COOKIE_NAME } from '../../lib/session';
import { matchesRoster } from '../../lib/oauth-roster';
import type { PollSnapshot, PollTemplate } from '../../lib/poll-templates';

// Eager-load all curated survey JSONs at build time. Each webinar id maps to
// at most one file in src/data/webinar-survey/<id>.json. Pages without a
// matching file render exactly as before.
const surveyModules = import.meta.glob<{ default: any }>(
  '../../data/webinar-survey/*.json',
  { eager: true }
);

// ── Resolve the markdown entry for this slug (404 if missing) ─────────────
const { id } = Astro.params;
const sessions = await getCollection('sessions');
const entry = sessions.find(e => e.id === id);
if (!entry) {
  return Astro.redirect('/sessions');
}
const data = entry.data;

// ── Look up the DB Session matching this slug, if any ─────────────────────
// If found, fetch its polls + cached results and render <PollEmbed /> islands.
// If not found, the session has no live-poll component (existing webinars).
const dbSession = await db.select().from(DbSession).where(eq(DbSession.slug, id!)).get();

let pollSnapshots: PollSnapshot[] = [];
let pulsePollSnapshots: PollSnapshot[] = [];
if (dbSession) {
  const polls = await db.select().from(DbPoll).where(eq(DbPoll.session_id, dbSession.id)).all();
  // Fetch all results in parallel.
  const results = await Promise.all(
    polls.map(p => db.select().from(DbPollResult).where(eq(DbPollResult.poll_id, p.id)).get())
  );
  const allSnapshots: PollSnapshot[] = polls.map((poll, i) => {
    const result = results[i] ?? null;
    const isMultiStringInput = poll.template === 'multi-string-input';
    const resultsHidden = !isMultiStringInput && (
      poll.results_visibility === 'host-only' ||
      (poll.results_visibility === 'on-close' && poll.status !== 'closed')
    );

    let tallies: unknown | null = resultsHidden ? null : (result?.tallies ?? null);
    let totalVotesVisible = !resultsHidden;

    // multi-string-input has a split visibility model (blueprint v2 §16.2):
    // counts are always public; entry CONTENT is gated by results_visibility.
    // Mirror the /api/polls/[id]/results.json endpoint so the SSR snapshot
    // matches what the next interval-poll fetch will return.
    if (isMultiStringInput) {
      const t = (result?.tallies as {
        total_strings?: number;
        total_contributors?: number;
        entries?: unknown;
      } | null) ?? {};
      const contentVisible =
        poll.results_visibility === 'live' ||
        (poll.results_visibility === 'on-close' && poll.status === 'closed');
      tallies = {
        total_strings: t.total_strings ?? 0,
        total_contributors: t.total_contributors ?? 0,
        entries: contentVisible ? (t.entries ?? []) : null,
      };
      totalVotesVisible = true;
    }

    return {
      poll_id: poll.id,
      title: poll.title,
      prompt: poll.prompt,
      template: poll.template as PollTemplate,
      options: (poll.options ?? null) as any,
      allow_revote: !!poll.allow_revote,
      results_visibility: poll.results_visibility as 'live' | 'on-close' | 'host-only',
      anonymous_display: !!poll.anonymous_display,
      status: poll.status as 'draft' | 'scheduled' | 'open' | 'closed',
      total_votes: result?.total_votes ?? 0,
      total_votes_visible: totalVotesVisible,
      tallies,
      last_aggregated_at: result?.last_aggregated_at
        ? new Date(result.last_aggregated_at).toISOString()
        : null,
      // Carry the surface tag through so the page can route the snapshot to
      // the right section. PollEmbed itself ignores this field.
      display_group: (poll as any).display_group ?? null,
    };
  });

  // Route by surface: tagged polls render in their themed panel; untagged
  // polls render in the standard live polls section at the bottom.
  pulsePollSnapshots = allSnapshots.filter(
    (s: any) => s.display_group === 'lp-syndication-pulse'
  );
  pollSnapshots = allSnapshots.filter((s: any) => !s.display_group);
}

// ── Auth state (session cookie + roster check) ────────────────────────────
const session = await verifySession(Astro.cookies.get(SESSION_COOKIE_NAME)?.value);
const rosterEntry = session ? matchesRoster(session) : null;
const isAuthenticated = !!session && !!rosterEntry;
const displayName = rosterEntry?.name ?? session?.name ?? null;
const status = inferWebinarStatus(data);

const tree = await parseMarkdown(entry.body ?? '');
const citations = (tree as any).data?.citations?.ordered ?? [];

const date = data.date_scheduled;
const month = date.toLocaleString('en-US', { month: 'short', timeZone: 'America/New_York' }).toUpperCase();
const day = date.toLocaleString('en-US', { day: 'numeric', timeZone: 'America/New_York' });
const weekday = date.toLocaleString('en-US', { weekday: 'long', timeZone: 'America/New_York' });
const year = date.getFullYear();
const time = date.toLocaleString('en-US', {
  hour: 'numeric',
  minute: '2-digit',
  hour12: true,
  timeZone: 'America/New_York',
  timeZoneName: 'short',
});

const presentersStr = (data.presenters ?? []).join(' · ');
const presenterDetails = data.presenterDetails ?? [];
const hasPresenterCards = presenterDetails.length > 0;

// Classifier-driven labels for the presenters section. Setupathons render
// their host as the only "presenter", so the section header becomes
// "Setupathon host" rather than the all-hands default "Speed-demo presenters".
const classifierSet = new Set(data.classifiers ?? []);
const isSetupathon = classifierSet.has('Setupathons');
const presentersHeadingTxt = isSetupathon
  ? (presenterDetails.length === 1 ? 'Your setupathon host' : 'Your setupathon hosts')
  : 'Speed-demo presenters';
const presentersEyebrowTxt = isSetupathon ? 'Hosted by' : 'With';
const partner = data.partnerMark ?? null;
const ctaHref = status === 'Recorded' ? data.recordingUrl : data.rsvpUrl;
const ctaLabel = status === 'Recorded' ? 'Watch recording' : status === 'Live' ? 'Join now' : 'RSVP';

const surveyKey = `../../data/webinar-survey/${entry.id}.json`;
const survey = surveyModules[surveyKey]?.default ?? null;

// Eager-load all breakout data modules at build time. Each file exports the
// session as a named const (e.g. FROM_YES_TO_WIN); we pick the one whose
// `.parent` matches the slug from frontmatter. data.breakouts unset → null.
const breakoutModules = import.meta.glob<Record<string, any>>(
  '../../data/breakouts/*.ts',
  { eager: true }
);
const breakoutsSlug = data.breakouts ?? null;
const breakoutData = breakoutsSlug
  ? Object.values(breakoutModules[`../../data/breakouts/${breakoutsSlug}.ts`] ?? {}).find(
      (v: any) => v && typeof v === 'object' && v.parent === breakoutsSlug
    ) ?? null
  : null;
---

<BaseThemeLayout
  title={`${data.title} · Agentic VC Dojo`}
  description={data.lede ?? `Webinar: ${data.title}`}
  image="/og-default.jpg"
  ogType="article"
  containerClass="px-6 py-12 max-w-3xl mx-auto"
>
  <a href="/sessions" class="back-link">← All sessions</a>

  <article class={`webinar-detail webinar-detail--${status.toLowerCase()}`}>
    <header class="webinar-detail__head">
      <div class="webinar-detail__date" aria-hidden="true">
        <span class="webinar-detail__date-month">{month}</span>
        <span class="webinar-detail__date-day">{day}</span>
        <span class="webinar-detail__date-weekday">{weekday}</span>
        <span class="webinar-detail__date-year">{year}</span>
      </div>

      <div class="webinar-detail__head-text">
        <span class={`webinar-detail__status webinar-detail__status--${status.toLowerCase()}`}>
          {status === 'Live' && <span class="webinar-detail__status-dot" aria-hidden="true"></span>}
          {status}
        </span>
        <h1 class="webinar-detail__title">{data.title}</h1>
        {data.lede && <p class="webinar-detail__lede">{data.lede}</p>}
      </div>
    </header>

    <dl class="webinar-detail__meta">
      <div class="webinar-detail__meta-row">
        <dt>When</dt>
        <dd>{weekday}, {month} {day} · {time} · {data.durationMinutes ?? 60} min</dd>
      </div>
      {presentersStr && !hasPresenterCards && (
        <div class="webinar-detail__meta-row">
          <dt>With</dt>
          <dd>{presentersStr}</dd>
        </div>
      )}
      {data.tags && data.tags.length > 0 && (
        <div class="webinar-detail__meta-row">
          <dt>Tags</dt>
          <dd>
            {data.tags.map(tag => <span class="webinar-detail__tag">{tag}</span>)}
          </dd>
        </div>
      )}
    </dl>

    {(partner || ctaHref) && (
      <div class="webinar-detail__action-row">
        {partner && (
          <aside class="webinar-detail__partner" aria-label={`Presented in partnership with ${partner.name}`}>
            <span class="webinar-detail__partner-label">In partnership with</span>
            {partner.url ? (
              <a href={partner.url} target="_blank" rel="noopener noreferrer" class="webinar-detail__partner-link">
                <img src={partner.light}   alt={partner.name} class="webinar-detail__partner-img webinar-detail__partner-img--light"   loading="lazy" decoding="async" />
                <img src={partner.dark}    alt={partner.name} class="webinar-detail__partner-img webinar-detail__partner-img--dark"    loading="lazy" decoding="async" />
                <img src={partner.vibrant} alt={partner.name} class="webinar-detail__partner-img webinar-detail__partner-img--vibrant" loading="lazy" decoding="async" />
              </a>
            ) : (
              <span class="webinar-detail__partner-link">
                <img src={partner.light}   alt={partner.name} class="webinar-detail__partner-img webinar-detail__partner-img--light"   loading="lazy" decoding="async" />
                <img src={partner.dark}    alt={partner.name} class="webinar-detail__partner-img webinar-detail__partner-img--dark"    loading="lazy" decoding="async" />
                <img src={partner.vibrant} alt={partner.name} class="webinar-detail__partner-img webinar-detail__partner-img--vibrant" loading="lazy" decoding="async" />
              </span>
            )}
          </aside>
        )}

        {ctaHref && (
          <a
            href={ctaHref}
            class="webinar-detail__cta"
            target={status === 'Recorded' ? '_blank' : undefined}
            rel={status === 'Recorded' ? 'noopener noreferrer' : undefined}
          >
            {ctaLabel}
            <span aria-hidden="true">→</span>
          </a>
        )}
      </div>
    )}

    {hasPresenterCards && (
      <Section__WebinarPresenters
        presenters={presenterDetails}
        hosts={data.hosts ?? []}
        headingTxt={presentersHeadingTxt}
        eyebrowTxt={presentersEyebrowTxt}
      />
    )}

    <div class="webinar-detail__body">
      <AstroMarkdown node={tree} />
      {pulsePollSnapshots.length > 0 && (
        <Section__LPSyndicationPulse
          snapshots={pulsePollSnapshots}
          isAuthenticated={isAuthenticated}
          displayName={displayName}
        />
      )}
      {breakoutData && <Section__BreakoutsTeaser data={breakoutData} />}
      <Sources citations={citations} />
    </div>
  </article>

  {pollSnapshots.length > 0 && (
    <section class="session-polls" aria-labelledby="session-polls-heading">
      <header class="session-polls__header">
        <h2 id="session-polls-heading" class="session-polls__heading">Live polls</h2>
        <p class="session-polls__lede">
          Vote during the meeting. Results develop in real time.
        </p>
      </header>
      <div class="session-polls__list">
        {pollSnapshots.map(snapshot => (
          <PollEmbed
            client:load
            pollId={snapshot.poll_id}
            initialState={snapshot}
            isAuthenticated={isAuthenticated}
            displayName={displayName}
            variant="card"
          />
        ))}
      </div>
    </section>
  )}

  {survey && (
    <div class="webinar-survey">
      <Section__WebinarSurveyStats totals={survey.totals} />
      <Section__WebinarSurveyPolls
        experience={survey.experience}
        toolStack={survey.toolStack}
        surveyed={survey.totals.surveyed}
      />
      <Section__WebinarFirmsRepresented firms={survey.firms} />
      <Section__WebinarSurveyVoices
        id="wsvoices-building"
        quotes={survey.quotes}
        headingTxt="What this room"
        headingAccentTxt="is actually working on"
        ledeTxt="Quotes are anonymized. Several of these are exactly what we'll workshop on Thursday."
      />
      {survey.quotesWanted && survey.quotesWanted.length > 0 && (
        <Section__WebinarSurveyVoices
          id="wsvoices-asks"
          quotes={survey.quotesWanted}
          headingTxt="What this room is"
          headingAccentTxt="hoping to take home"
          ledeTxt="Free-response answers to 'what do you most want to get out of this session?' — lightly edited."
        />
      )}
      {survey.reflection && (
        <Section__WebinarReflection reflection={survey.reflection} />
      )}
    </div>
  )}
</BaseThemeLayout>

<style>
  .session-polls {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .session-polls__header { display: flex; flex-direction: column; gap: 0.375rem; }
  .session-polls__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
  }
  .session-polls__lede {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }
  .session-polls__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-code);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color 150ms ease;
  }
  .back-link:hover { color: var(--color-primary); }

  .webinar-detail {
    padding: 2rem;
    border-radius: 1rem;
    background: var(--fx-card-bg);
    border: 1px solid var(--fx-card-border);
    box-shadow: var(--fx-card-shadow);
  }

  /* Header — date column on the left, text on the right */
  .webinar-detail__head {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .webinar-detail__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.25rem 0.75rem;
    border-radius: 0.875rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    text-align: center;
  }
  .webinar-detail__date-month {
    font-family: var(--font-code);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-primary);
  }
  .webinar-detail__date-day {
    font-family: var(--font-display);
    font-size: 4.5rem;
    line-height: 1;
    font-weight: 700;
    color: var(--color-text);
    margin: 0.375rem 0;
  }
  .webinar-detail__date-weekday {
    font-family: var(--font-code);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-text);
  }
  .webinar-detail__date-year {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-top: 0.125rem;
  }

  .webinar-detail__head-text { min-width: 0; }

  /* Status badge — same shape as card, bigger */
  .webinar-detail__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-family: var(--font-code);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    margin-bottom: 0.875rem;
  }
  .webinar-detail__status--upcoming { color: var(--color-primary); }
  .webinar-detail__status--live     { color: var(--color-accent); }
  .webinar-detail__status--recorded { color: var(--color-text-muted); }
  .webinar-detail__status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    animation: webinar-detail-pulse 1.4s ease-in-out infinite;
  }
  @keyframes webinar-detail-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.45; transform: scale(0.85); }
  }

  .webinar-detail__title {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1.15;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }
  .webinar-detail__lede {
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--color-text);
    margin: 0;
  }

  /* Meta */
  .webinar-detail__meta {
    margin: 0 0 1.75rem;
    padding: 1rem 1.25rem;
    border-radius: 0.625rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: 0.9375rem;
  }
  .webinar-detail__meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    align-items: baseline;
    padding: 0.375rem 0;
  }
  .webinar-detail__meta-row + .webinar-detail__meta-row {
    border-top: 1px dashed var(--color-border);
  }
  .webinar-detail__meta-row dt {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    min-width: 4rem;
  }
  .webinar-detail__meta-row dd {
    margin: 0;
    color: var(--color-text);
  }
  .webinar-detail__tag {
    display: inline-block;
    font-family: var(--font-code);
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    margin-right: 0.375rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  /* Action row — partner mark on the left, RSVP/CTA on the right. The
     partner takes its natural width; the button is hugged to the right
     edge. On narrow screens the row wraps and stacks. */
  .webinar-detail__action-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 2rem;
    flex-wrap: wrap;
  }

  /* CTA */
  .webinar-detail__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.5rem;
    border-radius: 0.625rem;
    background: var(--color-primary);
    color: var(--color__bone);
    font-family: var(--font-code);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    flex: 0 0 auto;
    transition: box-shadow 150ms ease, transform 150ms ease;
  }
  .webinar-detail__cta:hover {
    box-shadow: var(--fx-card-shadow-hover);
    transform: translateX(2px);
  }
  .webinar-detail--recorded .webinar-detail__cta {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .webinar-detail--recorded .webinar-detail__cta:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* Partner mark — horizontal credit strip on the left of the action row.
     Label and logo sit on a single row, separated by a thin vertical rule.
     No card chrome — this is attribution, not a competing CTA. */
  .webinar-detail__partner {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    flex: 1 1 auto;
    min-width: 0;
  }
  .webinar-detail__partner-label {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    line-height: 1.2;
    max-width: 6rem;
    flex: 0 0 auto;
    padding-right: 0.875rem;
    border-right: 1px solid var(--color-border);
  }
  .webinar-detail__partner-link {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    transition: opacity 150ms ease;
  }
  .webinar-detail__partner-link:hover { opacity: 0.85; }
  .webinar-detail__partner-img {
    display: none;
    height: 3.5rem;
    width: auto;
    max-width: 100%;
  }
  @media (max-width: 600px) {
    .webinar-detail__partner-img { height: 2.75rem; }
    .webinar-detail__partner-label { max-width: 5rem; }
  }
  /* Default (no data-mode set) → fall back to the light variant. */
  .webinar-detail__partner-img--light { display: block; }
  /* Mode-aware swaps. The data-mode attribute lives on a parent set by the
     site's ThemeSwitcher utility (see Section__HowItWorks for prior art). */
  :global([data-mode="dark"]) .webinar-detail__partner-img--light    { display: none; }
  :global([data-mode="dark"]) .webinar-detail__partner-img--dark     { display: block; }
  :global([data-mode="vibrant"]) .webinar-detail__partner-img--light { display: none; }
  :global([data-mode="vibrant"]) .webinar-detail__partner-img--vibrant { display: block; }

  /* Body markdown — minimal scoped prose styles to counter Tailwind preflight */
  .webinar-detail__body {
    color: var(--color-text);
    line-height: 1.65;
    border-top: 1px solid var(--color-border);
    padding-top: 1.5rem;
  }
  .webinar-detail__body :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
