---
// A share page for one section of a long-form page (a recipe, a handbook
// chapter). Chat apps ignore #fragments, so sharing page#heading would unfurl
// with the whole page's image. This page carries the section's own title and
// card, then sends people on to the heading. noindex, and kept out of the
// sitemap: the canonical is the page with its fragment.
// Pattern source: sites/cathode-site/src/pages/s/log/[logId]/[headingId].astro
import { getSectionShares, SECTION_SOURCES } from '../../lib/share-cards';

export const prerender = true;

export async function getStaticPaths() {
  const sections = await getSectionShares();
  return sections.map((section) => ({
    params: { section: `${SECTION_SOURCES[section.source].base}/${section.slug}/${section.headingId}` },
    props: { section },
  }));
}

const { section } = Astro.props as { section: Awaited<ReturnType<typeof getSectionShares>>[number] };
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.origin;
const target = `/${SECTION_SOURCES[section.source].base}/${section.slug}/#${section.headingId}`;
const targetAbs = new URL(target, siteOrigin + '/').href;
const ogImage = new URL(`/og/tall/${section.card.key}.jpg`, siteOrigin + '/').href;
const twitterImage = new URL(`/og/wide/${section.card.key}.jpg`, siteOrigin + '/').href;
// Section titles are just the heading; the page title goes in the description.
const title = section.headingText;
const description = `From “${section.pageTitle}” on FullStack VC.${section.pageLede ? ` ${section.pageLede}` : ''}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={targetAbs} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={targetAbs} />
    <meta property="og:site_name" content="FullStack VC" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1080" />
    <meta property="og:image:height" content="1440" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={twitterImage} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>location.replace(target);</script>
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 2rem;">
    <p><a href={target}>Continue to “{title}”</a></p>
  </body>
</html>
