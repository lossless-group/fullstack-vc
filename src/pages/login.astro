---
import BaseThemeLayout from '../layouts/BaseThemeLayout.astro';
import { verifySession, SESSION_COOKIE_NAME } from '../lib/session';

// If already logged in, bounce straight to /stack/me.
const session = await verifySession(Astro.cookies.get(SESSION_COOKIE_NAME)?.value);
if (session) return Astro.redirect('/stack/me', 302);
---

<BaseThemeLayout
  title="Log in · FullStack VC"
  description="Sign in to the Agentic VC Dojo. Kauffman Fellows only."
  containerClass="px-6 py-16 max-w-md mx-auto"
>
  <p class="text-sm uppercase tracking-[0.18em] mb-3" style="color: var(--color-text-muted); font-family: var(--font-code);">
    Agentic VC Dojo · Members only
  </p>
  <h1 class="text-3xl md:text-4xl font-bold mb-3" style="font-family: var(--font-display); color: var(--color-text);">
    Log in
  </h1>
  <p class="mb-8" style="color: var(--color-text);">
    Sign in with whichever account is verified against the Kauffman Fellows roster.
  </p>

  <div class="login-buttons">
    <a class="login-btn login-btn--github" href="/api/auth/github/login">
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/>
      </svg>
      Continue with GitHub
    </a>

    <a class="login-btn login-btn--linkedin" href="/api/auth/linkedin/login">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
      </svg>
      Continue with LinkedIn
    </a>
  </div>

  <p class="text-sm mt-8" style="color: var(--color-text-muted);">
    Not a Kauffman Fellow yet? <a href="/" style="color: var(--color-primary);">About the Dojo</a> ·
    See our <a href="/privacy" style="color: var(--color-primary);">privacy policy</a>.
  </p>
</BaseThemeLayout>

<style>
  .login-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .login-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.875rem 1.25rem;
    border-radius: 0.625rem;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    background: var(--fx-card-bg);
    font-family: var(--font-code);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 150ms ease, color 150ms ease, background-color 150ms ease;
  }
  .login-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .login-btn svg { width: 1.125rem; height: 1.125rem; }
</style>
