---
/* HeroContentCoreMessage
   The primary hero composition used at the top of marketing pages.
   Renders an eyebrow (contextSetter), an h1, an h2 subheader, and a supporting paragraph.
   All typography reads semantic tokens — works in light, dark, and vibrant modes. */

export interface Props {
  contextSetter?: string;
  headerTxt: string;
  subheaderTxt?: string;
  supportingTxt?: string;
  /** Optional CTA shown below the supporting copy. Pass href + label to render. */
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  contextSetter,
  headerTxt,
  subheaderTxt,
  supportingTxt,
  ctaHref,
  ctaLabel,
} = Astro.props;
---

<article class="hero-core">
  {contextSetter && (
    <p class="hero-core__eyebrow">{contextSetter}</p>
  )}

  <h1 class="hero-core__headline">{headerTxt}</h1>

  {subheaderTxt && (
    <h2 class="hero-core__subheader">{subheaderTxt}</h2>
  )}

  {supportingTxt && (
    <p class="hero-core__supporting" set:html={supportingTxt}></p>
  )}

  {Astro.slots.has('cta') ? (
    <div class="hero-core__cta-row"><slot name="cta" /></div>
  ) : ctaHref && ctaLabel && (
    <div class="hero-core__cta-row">
      <a href={ctaHref} class="hero-core__cta">{ctaLabel}</a>
    </div>
  )}
</article>

<style>
  .hero-core {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .hero-core__eyebrow {
    font-family: var(--font-code);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
    margin: 0;
  }
  .hero-core__headline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--color-text);
    background: var(--fx-headline-gradient, none);
    -webkit-background-clip: text;
            background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-core__subheader {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.4;
    color: var(--color-text);
    margin: 0;
  }
  .hero-core__supporting {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 56ch;
  }
  .hero-core__cta-row {
    margin-top: 0.5rem;
  }
  .hero-core__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    font-family: var(--font-code);
    font-size: 0.875rem;
    text-decoration: none;
    background: var(--color-primary);
    color: var(--color__bone);
    border: 1px solid var(--color-primary);
    box-shadow: var(--fx-card-shadow);
    transition: box-shadow 150ms ease, transform 150ms ease;
  }
  .hero-core__cta:hover {
    box-shadow: var(--fx-card-shadow-hover);
    transform: translateY(-1px);
  }
</style>
