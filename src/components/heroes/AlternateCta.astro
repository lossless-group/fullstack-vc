---
/* AlternateCta
   Secondary call-to-action that lives alongside a hero (typically 1/3 width
   next to a 2/3 hero). Self-contained card with a body block and an optional
   trailing inline-attribution paragraph. */

export interface Props {
  /** Headline above the body — short, punchy. */
  title?: string;
  /** Main HTML body of the card. */
  bodyHtml: string;
  /** Trailing attribution / network line (HTML allowed). */
  trailingHtml?: string;
  /** Optional secondary action button at the bottom of the card. */
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  title,
  bodyHtml,
  trailingHtml,
  ctaHref,
  ctaLabel,
} = Astro.props;
---

<aside class="alt-cta">
  {title && <h3 class="alt-cta__title">{title}</h3>}
  <div class="alt-cta__body" set:html={bodyHtml}></div>
  {trailingHtml && (
    <p class="alt-cta__trailing" set:html={trailingHtml}></p>
  )}
  {ctaHref && ctaLabel && (
    <a href={ctaHref} class="alt-cta__action">{ctaLabel}</a>
  )}
</aside>

<style>
  .alt-cta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: 0.875rem;
    background: var(--fx-card-bg);
    border: 1px solid var(--fx-card-border);
    box-shadow: var(--fx-card-shadow);
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }
  .alt-cta:hover {
    border-color: var(--fx-card-border-hover);
    box-shadow: var(--fx-card-shadow-hover);
  }
  .alt-cta__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .alt-cta__body {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .alt-cta__body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .alt-cta__trailing {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-code);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .alt-cta__trailing :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .alt-cta__action {
    align-self: flex-start;
    padding: 0.5rem 0.875rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-family: var(--font-code);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .alt-cta__action:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
</style>
