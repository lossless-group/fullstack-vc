---
/* CtaBtnWithAuthIcons
   CTA button that signals which auth providers the destination accepts.
   Renders the chosen provider glyphs (linkedin, github) on the leading
   edge of the button alongside the label. Same visual chrome as the
   default hero CTA so it slots in via HeroContentCoreMessage's `cta` slot. */

export interface Props {
  href: string;
  label: string;
  /** Auth providers to display. Order is preserved. */
  providers?: Array<'linkedin' | 'github'>;
  /** Render as an external link (target=_blank). Default false. */
  external?: boolean;
  /** Icon size in px. Default 18. */
  iconSize?: number;
}

const {
  href,
  label,
  providers = ['linkedin', 'github'],
  external = false,
  iconSize = 18,
} = Astro.props;
---

<a
  href={href}
  class="cta-auth"
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class="cta-auth__icons" aria-hidden="true">
    {providers.map(p => p === 'linkedin' ? (
      <svg xmlns="http://www.w3.org/2000/svg" width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="currentColor" focusable="false">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>
    ) : (
      <svg xmlns="http://www.w3.org/2000/svg" width={iconSize} height={iconSize} viewBox="0 0 24 24" fill="currentColor" focusable="false">
        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
      </svg>
    ))}
  </span>
  <span class="cta-auth__label">{label}</span>
  <span class="cta-auth__arrow" aria-hidden="true">→</span>
</a>

<style>
  .cta-auth {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1.25rem;
    border-radius: 0.5rem;
    font-family: var(--font-code);
    font-size: 0.875rem;
    text-decoration: none;
    background: var(--color-primary);
    color: var(--color__bone);
    border: 1px solid var(--color-primary);
    box-shadow: var(--fx-card-shadow);
    transition: box-shadow 150ms ease, transform 150ms ease;
  }
  .cta-auth:hover {
    box-shadow: var(--fx-card-shadow-hover);
    transform: translateY(-1px);
  }
  .cta-auth__icons {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    line-height: 0;
    padding-right: 0.625rem;
    border-right: 1px solid color-mix(in srgb, var(--color__bone) 35%, transparent);
  }
  .cta-auth__label {
    letter-spacing: 0.04em;
  }
  .cta-auth__arrow {
    margin-left: 0.125rem;
    transition: transform 150ms ease;
  }
  .cta-auth:hover .cta-auth__arrow {
    transform: translateX(2px);
  }
</style>
