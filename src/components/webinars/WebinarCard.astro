---
import { inferWebinarStatus, type WebinarStatus } from '../../lib/webinar-status';

interface Props {
  data: {
    title: string;
    lede?: string;
    date_scheduled: Date;
    durationMinutes?: number;
    presenters?: string[];
    rsvpUrl?: string;
    recordingUrl?: string;
  };
  href?: string;
  /** Override status — useful for design-system showcasing all three. */
  statusOverride?: WebinarStatus;
}

const { data, href, statusOverride } = Astro.props;
const status: WebinarStatus = statusOverride ?? inferWebinarStatus(data);

const date = data.date_scheduled;
const month = date.toLocaleString('en-US', { month: 'short', timeZone: 'America/New_York' }).toUpperCase();
const day = date.toLocaleString('en-US', { day: 'numeric', timeZone: 'America/New_York' });
const weekday = date.toLocaleString('en-US', { weekday: 'short', timeZone: 'America/New_York' }).toUpperCase();
const year = date.getFullYear();
const time = date.toLocaleString('en-US', {
  hour: 'numeric',
  minute: '2-digit',
  hour12: true,
  timeZone: 'America/New_York',
  timeZoneName: 'short',
});

const presentersStr = (data.presenters ?? []).join(' · ');
const ctaHref = status === 'Recorded' ? data.recordingUrl : data.rsvpUrl;
const ctaLabel = status === 'Recorded' ? 'Watch recording' : status === 'Live' ? 'Join now' : 'RSVP';
---

<article class={`webinar-card webinar-card--${status.toLowerCase()}`} data-status={status}>
  <!-- Date "tear-off" -->
  <div class="webinar-card__date" aria-hidden="true">
    <span class="webinar-card__date-month">{month}</span>
    <span class="webinar-card__date-day">{day}</span>
    <span class="webinar-card__date-weekday">{weekday}</span>
  </div>

  <!-- Body -->
  <div class="webinar-card__body">
    <div class="webinar-card__head">
      <span class={`webinar-card__status webinar-card__status--${status.toLowerCase()}`}>
        {status === 'Live' && <span class="webinar-card__status-dot" aria-hidden="true"></span>}
        {status}
      </span>
    </div>

    {href ? (
      <a href={href} class="webinar-card__title-link">
        <h3 class="webinar-card__title">{data.title}</h3>
      </a>
    ) : (
      <h3 class="webinar-card__title">{data.title}</h3>
    )}

    {data.lede && <p class="webinar-card__lede">{data.lede}</p>}

    <dl class="webinar-card__meta">
      <div class="webinar-card__meta-row">
        <dt>When</dt>
        <dd>{time} · {data.durationMinutes ?? 60} min</dd>
      </div>
      {presentersStr && (
        <div class="webinar-card__meta-row">
          <dt>With</dt>
          <dd>{presentersStr}</dd>
        </div>
      )}
    </dl>

    <div class="webinar-card__cta-row">
      {ctaHref && (
        <a
          href={ctaHref}
          class="webinar-card__cta"
          target={status === 'Recorded' ? '_blank' : undefined}
          rel={status === 'Recorded' ? 'noopener noreferrer' : undefined}
        >
          {ctaLabel}
          <span aria-hidden="true">→</span>
        </a>
      )}
      {href && (
        <a href={href} class="webinar-card__cta webinar-card__cta--secondary">
          Learn more
          <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .webinar-card {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1.5rem;
    padding: 1.25rem;
    border-radius: 0.875rem;
    background: var(--fx-card-bg);
    border: 1px solid var(--fx-card-border);
    box-shadow: var(--fx-card-shadow);
    transition: all 200ms ease;
  }
  .webinar-card:hover {
    border-color: var(--fx-card-border-hover);
    box-shadow: var(--fx-card-shadow-hover);
  }

  /* Date tear-off */
  .webinar-card__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 0.5rem;
    border-radius: 0.625rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    text-align: center;
  }
  .webinar-card__date-month {
    font-family: var(--font-code);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-primary);
  }
  .webinar-card__date-day {
    font-family: var(--font-display);
    font-size: 2.5rem;
    line-height: 1;
    font-weight: 700;
    color: var(--color-text);
    margin: 0.25rem 0 0.125rem;
  }
  .webinar-card__date-weekday {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  /* Body */
  .webinar-card__body { min-width: 0; }

  .webinar-card__head {
    display: flex;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  /* Status badges */
  .webinar-card__status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.1875rem 0.625rem;
    border-radius: 999px;
    font-family: var(--font-code);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid currentColor;
  }
  .webinar-card__status--upcoming { color: var(--color-primary); }
  .webinar-card__status--live     { color: var(--color-accent); }
  .webinar-card__status--recorded { color: var(--color-text-muted); }

  .webinar-card__status-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    animation: webinar-card-pulse 1.4s ease-in-out infinite;
  }
  @keyframes webinar-card-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.45; transform: scale(0.85); }
  }

  /* Title */
  .webinar-card__title-link { text-decoration: none; }
  .webinar-card__title-link:hover .webinar-card__title { color: var(--color-primary); }
  .webinar-card__title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.5rem;
    transition: color 150ms ease;
  }

  .webinar-card__lede {
    color: var(--color-text);
    margin: 0 0 1rem;
    line-height: 1.5;
  }

  /* Meta dl */
  .webinar-card__meta {
    margin: 0 0 1rem;
    font-size: 0.875rem;
  }
  .webinar-card__meta-row {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }
  .webinar-card__meta-row dt {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    min-width: 3rem;
    padding-top: 0.125rem;
  }
  .webinar-card__meta-row dd {
    margin: 0;
    color: var(--color-text);
  }

  /* CTA row — wraps on narrow widths so secondary tucks under primary */
  .webinar-card__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    align-items: center;
  }

  /* Primary CTA (RSVP / Watch recording / Join now) */
  .webinar-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    background: var(--color-primary);
    color: var(--color__bone);
    font-family: var(--font-code);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: box-shadow 150ms ease, transform 150ms ease;
  }
  .webinar-card__cta:hover {
    box-shadow: var(--fx-card-shadow-hover);
    transform: translateX(2px);
  }
  .webinar-card--recorded .webinar-card__cta:not(.webinar-card__cta--secondary) {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .webinar-card--recorded .webinar-card__cta:not(.webinar-card__cta--secondary):hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* Secondary CTA (Learn more) — minimal, never competes with primary */
  .webinar-card__cta--secondary {
    background: transparent;
    color: var(--color-text-muted);
    padding: 0.5rem 0.75rem;
    font-weight: 500;
  }
  .webinar-card__cta--secondary:hover {
    background: transparent;
    color: var(--color-primary);
    box-shadow: none;
  }

  /* Responsive — collapse the date column on narrow screens */
  @media (max-width: 480px) {
    .webinar-card { grid-template-columns: 1fr; gap: 1rem; }
    .webinar-card__date {
      flex-direction: row;
      gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      justify-content: flex-start;
    }
    .webinar-card__date-day { font-size: 1.5rem; margin: 0; }
  }
</style>
