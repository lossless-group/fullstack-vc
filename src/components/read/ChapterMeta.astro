---
import FormattedDate from '../ui/FormattedDate.astro';

interface Props {
  chapterNumber: number;
  readingMinutes?: number;
  wordCount?: number;
  author?: string;
  updated?: Date | null;
  sourceOrganization?: string;
}

const {
  chapterNumber,
  readingMinutes,
  wordCount,
  author,
  updated,
  sourceOrganization,
} = Astro.props;

function pad(n: number): string {
  return String(n).padStart(2, '0');
}

function formatNumber(n: number): string {
  return n.toLocaleString('en-US');
}
---

<dl class="chapter-meta" aria-label="Chapter metadata">
  <div class="chapter-meta__item chapter-meta__item--primary">
    <dt class="chapter-meta__label">Chapter</dt>
    <dd class="chapter-meta__value">{pad(chapterNumber)}</dd>
  </div>

  {readingMinutes !== undefined && (
    <div class="chapter-meta__item">
      <dt class="chapter-meta__label">Read</dt>
      <dd class="chapter-meta__value">{readingMinutes} min</dd>
    </div>
  )}

  {wordCount !== undefined && (
    <div class="chapter-meta__item">
      <dt class="chapter-meta__label">Words</dt>
      <dd class="chapter-meta__value">{formatNumber(wordCount)}</dd>
    </div>
  )}

  {author && (
    <div class="chapter-meta__item">
      <dt class="chapter-meta__label">Author</dt>
      <dd class="chapter-meta__value">{author}</dd>
    </div>
  )}

  {updated && (
    <div class="chapter-meta__item">
      <dt class="chapter-meta__label">Updated</dt>
      <dd class="chapter-meta__value"><FormattedDate date={updated} style="long" /></dd>
    </div>
  )}

  {sourceOrganization && (
    <div class="chapter-meta__item chapter-meta__item--source">
      <dt class="chapter-meta__label">Source</dt>
      <dd class="chapter-meta__value">{sourceOrganization}</dd>
    </div>
  )}
</dl>

<style>
  .chapter-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1.25rem 1.5rem;
    margin: 0;
    padding: 0.875rem 1.125rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .chapter-meta__item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0;
  }
  .chapter-meta__item--primary .chapter-meta__value {
    color: var(--color-primary);
    font-weight: 600;
  }
  .chapter-meta__item--source { margin-left: auto; }
  .chapter-meta__label {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.625rem;
    opacity: 0.65;
  }
  .chapter-meta__label::after { content: ':'; opacity: 0.5; margin-left: 0.1rem; }
  .chapter-meta__value {
    margin: 0;
    color: var(--color-text);
  }
  @container reader (max-width: 480px) {
    .chapter-meta { gap: 0.625rem 1rem; padding: 0.75rem 0.875rem; }
    .chapter-meta__item--source { margin-left: 0; flex-basis: 100%; }
  }
</style>
