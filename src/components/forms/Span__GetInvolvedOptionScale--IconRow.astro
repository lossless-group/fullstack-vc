---
/* Span__GetInvolvedOptionScale--IconRow
   A three-icon "how involved?" toggle that appears on every project /
   working-group / proposal card. Tapping an icon registers (or clears) the
   user's intended level of participation for that entity.

   Three levels — increasing weight L→R:
     · Lead-Potential      "Eager and able"           (flame icon, accent color, heaviest)
     · Active-Participant  "Count me reliably in"     (raised-hand, primary, medium)
     · Keep-Informed       "Want to stay informed"    (eye, muted, lightest)

   Hydration model
     The page is prerendered, so we cannot know the user's session at SSR.
     A single page-level fetch (`/api/participation-interest`) populates a
     Map keyed by `${kind}::${slug}` and applies initial state to every
     instance. Then per-row click handlers POST/DELETE optimistically.

   Not-logged-in: the API returns `{ loggedIn: false }` and a click on any
   icon redirects the user to /login (preserving return URL).

   Props:
     entityKind  — 'project' | 'working-group' | 'project-proposal' | 'working-group-proposal'
     entitySlug  — slug for content-collection entries; UUID for Proposal rows
     entityTitleTxt — human-readable label, only used for aria-label/tooltip context
     size        — 'sm' (compact, used on lite/proposal cards) or 'md' (used on portfolio/mission-brief) */

export type EntityKind = 'project' | 'working-group' | 'project-proposal' | 'working-group-proposal';

export interface Props {
  entityKind: EntityKind;
  entitySlug: string;
  entityTitleTxt?: string;
  size?: 'sm' | 'md';
}

const {
  entityKind,
  entitySlug,
  entityTitleTxt = '',
  size = 'md',
} = Astro.props;
---

<div
  class:list={['gioscale', `gioscale--${size}`]}
  data-gioscale-root
  data-entity-kind={entityKind}
  data-entity-slug={entitySlug}
  data-logged-in="false"
  role="group"
  aria-label={`Get involved with ${entityTitleTxt || 'this'}`}
>
  <p class="gioscale__lede">Get involved:</p>

  {/* Row-level gating tooltip. Hidden by default; appears only after a
      logged-out user *clicks* one of the icons (JS sets
      data-show-login-tip="true" on the row). Auto-dismisses after 6s and
      on outside-click. Rendered as a real <a href> so keyboard /
      right-click "open in new tab" works. */}
  <a class="gioscale__login-tip" href={`/login?next=${Astro.url?.pathname ?? '/'}`} role="tooltip">
    <strong class="gioscale__login-tip-head">Only those who have logged in may get involved.</strong>
    <em class="gioscale__login-tip-quip">Only the penitent man shall pass.</em>
    <span class="gioscale__login-tip-cta">Click here to log in →</span>
  </a>

  <button
    type="button"
    class="gioscale__btn gioscale__btn--lead"
    data-level="lead-potential"
    aria-pressed="false"
    aria-label="Lead-Potential — eager and able"
  >
    <span class="gioscale__icon" aria-hidden="true">
      {/* Flame — heaviest weight cue: filled triangular flame */}
      <svg viewBox="0 0 24 24" width="100%" height="100%" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="currentColor" fill-opacity="0.18">
        <path d="M12 2c1.5 3 4 5 4 8a4 4 0 0 1-2 3.5c.5-1 .5-2-.5-3-1 1.5-2 2-2.5 3.5-.4 1.3 0 2.5 1 3.2-2.4-.2-5-2-5-5.2 0-2.4 1.5-4 2.5-5.5C10.5 4.8 11 3.4 12 2z"/>
        <path d="M12 22a6 6 0 0 1-6-6c0-2 1-3 2-4 .5 1 1.5 1.5 2.5 1.5-.6 1-.6 2 .3 2.8.8.7 2.2.7 3 0 1-.8 1-2 .3-3 1.2.4 2.4 1.4 2.9 2.7A6 6 0 0 1 12 22z"/>
      </svg>
    </span>
    <span class="gioscale__tip" role="tooltip">Eager and able</span>
  </button>

  <button
    type="button"
    class="gioscale__btn gioscale__btn--active"
    data-level="active-participant"
    aria-pressed="false"
    aria-label="Active-Participant — count me reliably in"
  >
    <span class="gioscale__icon" aria-hidden="true">
      {/* Raised-hand — middle weight, solid checkmark in a circle */}
      <svg viewBox="0 0 24 24" width="100%" height="100%" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.12"/>
        <path d="M8 12.5l3 3 5-6"/>
      </svg>
    </span>
    <span class="gioscale__tip" role="tooltip">Count me reliably in</span>
  </button>

  <button
    type="button"
    class="gioscale__btn gioscale__btn--keep"
    data-level="keep-informed"
    aria-pressed="false"
    aria-label="Keep-Informed — want to stay informed"
  >
    <span class="gioscale__icon" aria-hidden="true">
      {/* Eye — lightest weight, outline only */}
      <svg viewBox="0 0 24 24" width="100%" height="100%" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/>
        <circle cx="12" cy="12" r="2.6"/>
      </svg>
    </span>
    <span class="gioscale__tip" role="tooltip">Want to stay informed</span>
  </button>
</div>

<script>
  // ───────────────────────────────────────────────────────────────────────
  // Page-level hydration. Astro deduplicates this <script> across multiple
  // component instances, so this initializer runs exactly once per page.
  // ───────────────────────────────────────────────────────────────────────
  type Level = 'lead-potential' | 'active-participant' | 'keep-informed';
  type Kind = 'project' | 'working-group' | 'project-proposal' | 'working-group-proposal';

  interface InterestRow { entity_kind: Kind; entity_slug: string; level: Level; }

  const LOG_PREFIX = '[gioscale]';
  let interestsPromise: Promise<{ loggedIn: boolean; interests: InterestRow[] }> | null = null;

  function loadInterests() {
    if (!interestsPromise) {
      interestsPromise = fetch('/api/participation-interest', {
        headers: { 'accept': 'application/json' },
        credentials: 'same-origin',
      })
        .then(async r => {
          const text = await r.text();
          let parsed: any = null;
          try { parsed = text ? JSON.parse(text) : null; } catch {}
          if (!r.ok) {
            console.warn(LOG_PREFIX, 'GET /api/participation-interest failed', r.status, text);
            return { loggedIn: false, interests: [] };
          }
          return parsed ?? { loggedIn: false, interests: [] };
        })
        .catch(err => {
          console.error(LOG_PREFIX, 'GET /api/participation-interest threw', err);
          return { loggedIn: false, interests: [] };
        });
    }
    return interestsPromise;
  }

  function key(kind: string, slug: string) { return `${kind}::${slug}`; }

  function setSelected(root: HTMLElement, level: Level | null) {
    root.dataset.selectedLevel = level ?? '';
    root.querySelectorAll<HTMLButtonElement>('.gioscale__btn').forEach(btn => {
      const isOn = btn.dataset.level === level;
      btn.setAttribute('aria-pressed', isOn ? 'true' : 'false');
      btn.classList.toggle('is-selected', isOn);
    });
  }

  function flashError(root: HTMLElement, msg?: string) {
    root.classList.add('is-error');
    if (msg) {
      let banner = root.querySelector<HTMLElement>('.gioscale__banner');
      if (!banner) {
        banner = document.createElement('p');
        banner.className = 'gioscale__banner';
        root.appendChild(banner);
      }
      banner.textContent = msg;
      banner.style.display = 'block';
      setTimeout(() => { if (banner) banner.style.display = 'none'; }, 3000);
    }
    setTimeout(() => root.classList.remove('is-error'), 1200);
  }

  async function hydrate() {
    const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-gioscale-root]'));
    console.log(LOG_PREFIX, 'hydrate — found', roots.length, 'instances');
    if (roots.length === 0) return;

    const data = await loadInterests();
    console.log(LOG_PREFIX, 'initial interests', data);
    const map = new Map<string, Level>();
    for (const i of (data.interests ?? [])) map.set(key(i.entity_kind, i.entity_slug), i.level);

    for (const root of roots) {
      if (root.dataset.gioscaleBound === '1') continue; // idempotent on hot reload
      root.dataset.gioscaleBound = '1';

      const kind = root.dataset.entityKind!;
      const slug = root.dataset.entitySlug!;
      root.dataset.loggedIn = data.loggedIn ? 'true' : 'false';
      const initial = map.get(key(kind, slug)) ?? null;
      if (initial) setSelected(root, initial);

      root.querySelectorAll<HTMLButtonElement>('.gioscale__btn').forEach(btn => {
        btn.addEventListener('click', async (ev) => {
          ev.preventDefault();
          ev.stopPropagation();

          const level = btn.dataset.level as Level;
          console.log(LOG_PREFIX, 'click', { kind, slug, level, loggedIn: root.dataset.loggedIn });

          // Not logged in → reveal the gating tooltip near the row instead
          // of redirecting. The user reads it, then either clicks the "log
          // in" link inside it or moves on. Auto-dismiss after 6s, and
          // close on any click outside the row.
          if (root.dataset.loggedIn !== 'true') {
            root.dataset.showLoginTip = 'true';
            const existingTimer = Number(root.dataset.loginTipTimer || 0);
            if (existingTimer) window.clearTimeout(existingTimer);
            const timer = window.setTimeout(() => {
              root.dataset.showLoginTip = 'false';
              delete root.dataset.loginTipTimer;
            }, 6000);
            root.dataset.loginTipTimer = String(timer);
            return;
          }

          const current = (root.dataset.selectedLevel || null) as Level | null;
          const sameLevel = current === level;
          const nextLevel: Level | null = sameLevel ? null : level;

          // Optimistic toggle.
          const prevLevel = current;
          setSelected(root, nextLevel);
          root.classList.add('is-pending');

          try {
            const res = await fetch('/api/participation-interest', {
              method: nextLevel ? 'POST' : 'DELETE',
              headers: { 'content-type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify(
                nextLevel
                  ? { entity_kind: kind, entity_slug: slug, level: nextLevel }
                  : { entity_kind: kind, entity_slug: slug }
              ),
            });
            const text = await res.text();
            if (!res.ok) {
              console.warn(LOG_PREFIX, 'persist failed', res.status, text);
              setSelected(root, prevLevel);
              flashError(root, res.status === 401 ? 'Sign in to save' : `Save failed (${res.status})`);
              if (res.status === 401) {
                root.dataset.loggedIn = 'false';
              }
            } else {
              console.log(LOG_PREFIX, 'persist ok', text);
            }
          } catch (err) {
            console.error(LOG_PREFIX, 'persist threw', err);
            setSelected(root, prevLevel);
            flashError(root, 'Network error');
          } finally {
            root.classList.remove('is-pending');
          }
        });
      });
    }
  }

  // NOTE: do NOT add a capture-phase document listener that calls
  // stopPropagation — that fires BEFORE the event reaches the button and
  // suppresses our own click handlers. The icon row is rendered as a sibling
  // of the card's <a class="pcard__hit">, not nested inside it, so bubbling
  // can never trigger card navigation. Per-button stopPropagation in the
  // bubble-phase handler below is enough belt-and-suspenders.

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', hydrate, { once: true });
  } else {
    hydrate();
  }

  // Dismiss any open login tooltip when the user clicks anywhere outside
  // a row whose tooltip is showing.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    document.querySelectorAll<HTMLElement>('[data-gioscale-root][data-show-login-tip="true"]').forEach(root => {
      if (target && root.contains(target)) return;
      root.dataset.showLoginTip = 'false';
      const t = Number(root.dataset.loginTipTimer || 0);
      if (t) {
        window.clearTimeout(t);
        delete root.dataset.loginTipTimer;
      }
    });
  });

  // Hot-reload safety in dev — re-run on Astro view-transition navigations.
  document.addEventListener('astro:page-load', () => {
    interestsPromise = null;
    hydrate();
  });
</script>

<style>
  .gioscale {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.5rem 0.625rem;
    border-radius: 0.625rem;
    background: color-mix(in srgb, var(--color-surface) 60%, transparent);
    border: 1px solid var(--color-border);
    /* This row sits inside an <a class="pcard__hit">. Mark it as not part
       of the link affordance so card hover styles don't bleed in. */
    isolation: isolate;
  }
  .gioscale--sm {
    padding: 0.375rem 0.5rem;
    gap: 0.375rem;
  }

  .gioscale__lede {
    margin: 0;
    flex: 0 0 auto;
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }
  .gioscale--sm .gioscale__lede {
    font-size: 0.625rem;
    letter-spacing: 0.12em;
  }

  .gioscale__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border-radius: 0.5rem;
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 150ms ease, background 150ms ease, border-color 150ms ease, transform 120ms ease;
    /* Keep buttons crisp inside the prose context of a card. */
    line-height: 0;
  }
  .gioscale--sm .gioscale__btn {
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 0.4375rem;
  }
  .gioscale__btn:hover,
  .gioscale__btn:focus-visible {
    outline: none;
    transform: translateY(-1px);
    border-color: var(--fx-card-border-hover, var(--color-primary));
    color: var(--color-text);
  }

  .gioscale__icon {
    display: inline-block;
    width: 1.125rem;
    height: 1.125rem;
  }
  .gioscale--sm .gioscale__icon {
    width: 0.9375rem;
    height: 0.9375rem;
  }

  /* Per-button weight cues at rest — heaviest on the left. */
  .gioscale__btn--lead   { color: color-mix(in srgb, var(--color-accent, var(--color-primary)) 70%, var(--color-text-muted)); }
  .gioscale__btn--active { color: color-mix(in srgb, var(--color-primary) 65%, var(--color-text-muted)); }
  .gioscale__btn--keep   { color: var(--color-text-muted); }

  /* Selected state — saturated, ringed. */
  .gioscale__btn.is-selected {
    color: var(--color-background);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px -6px var(--badge, transparent);
  }
  .gioscale__btn--lead.is-selected {
    --badge: var(--color-accent, var(--color-primary));
    background: var(--color-accent, var(--color-primary));
    border-color: var(--color-accent, var(--color-primary));
  }
  .gioscale__btn--active.is-selected {
    --badge: var(--color-primary);
    background: var(--color-primary);
    border-color: var(--color-primary);
  }
  .gioscale__btn--keep.is-selected {
    --badge: var(--color-text);
    background: var(--color-text);
    border-color: var(--color-text);
    color: var(--color-background);
  }

  /* Error / pending pulses */
  .gioscale.is-pending .gioscale__btn { opacity: 0.85; }
  .gioscale.is-error {
    animation: gioscale-shake 0.4s ease;
  }
  @keyframes gioscale-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-3px); }
    75% { transform: translateX(3px); }
  }

  /* Inline error banner — shown by JS when an API call fails. */
  .gioscale__banner {
    display: none;
    margin: 0;
    flex: 1 1 100%;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--color-status-archived, #c44) 18%, transparent);
    color: var(--color-text);
    font-family: var(--font-code);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  /* Tooltip — pure CSS, fades in on hover/focus. */
  .gioscale__tip {
    position: absolute;
    bottom: calc(100% + 0.4rem);
    left: 50%;
    transform: translateX(-50%) translateY(2px);
    padding: 0.3125rem 0.5rem;
    border-radius: 0.375rem;
    background: var(--color-text);
    color: var(--color-background);
    font-family: var(--font-code);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    line-height: 1.2;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 140ms ease, transform 140ms ease;
    z-index: 5;
    box-shadow: 0 6px 16px -8px rgba(0,0,0,0.35);
  }
  .gioscale__tip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 4px solid transparent;
    border-top-color: var(--color-text);
  }
  .gioscale__btn:hover .gioscale__tip,
  .gioscale__btn:focus-visible .gioscale__tip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* ───── Logged-out gating ─────
     Icons and their per-icon hover tooltips stay fully visible regardless
     of login state — those describe what each level *means*. The "you
     must sign in" message is gated on click attempt, not hover, so the
     user only sees it once they actually try to engage. */

  .gioscale__login-tip {
    position: absolute;
    bottom: calc(100% + 0.4rem);
    left: 0;
    right: 0;
    margin: 0 auto;
    max-width: 22rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    background: var(--color-text);
    color: var(--color-background);
    font-family: var(--font-body, inherit);
    font-size: 0.75rem;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
    box-shadow: 0 8px 22px -10px rgba(0,0,0,0.4);
    pointer-events: none;
    opacity: 0;
    transform: translateY(2px);
    transition: opacity 160ms ease, transform 160ms ease;
    z-index: 6;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .gioscale__login-tip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 1.5rem;
    border: 5px solid transparent;
    border-top-color: var(--color-text);
  }
  /* Invisible bridge so cursor doesn't lose hover when crossing the
     0.4rem gap between the icon row and the tooltip. */
  .gioscale__login-tip::before {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 0.6rem;
  }
  .gioscale__login-tip-head {
    font-weight: 600;
    letter-spacing: -0.005em;
  }
  .gioscale__login-tip-quip {
    font-style: italic;
    opacity: 0.85;
    font-size: 0.6875rem;
  }
  .gioscale__login-tip-cta {
    margin-top: 0.125rem;
    font-family: var(--font-code);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    text-transform: uppercase;
  }
  /* Click-triggered: shown once data-show-login-tip="true" is set by JS,
     auto-dismissed after 6s or by clicking outside the row. */
  .gioscale[data-show-login-tip="true"] .gioscale__login-tip {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  /* Always hidden when we know the user is logged in. */
  .gioscale[data-logged-in="true"] .gioscale__login-tip {
    display: none;
  }
</style>
