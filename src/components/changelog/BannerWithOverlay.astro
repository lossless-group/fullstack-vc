---
// ============================================================================
// BannerWithOverlay
//
// Renders a changelog banner: the AI-generated base image (text already stripped
// by the Ideogram Layerize pass — see scripts/generate-changelog-banners.ts and
// utils/api-connectors/ideogram.ts) with crisp HTML/CSS title text composited
// on top in our brand fonts.
//
// Why this pattern instead of baking text into the model output:
//   - Pixel-perfect typography (HTML, not pixels)
//   - Brand-correct fonts (--font-display, --font-code)
//   - Edit-without-regen (changing image_text is a frontmatter edit, $0 cost)
//   - Mode-aware (overlay color tracks --color tokens)
//   - Accessible: real text, indexable, screen-reader friendly, copy-pasteable
// ============================================================================

interface Props {
  /** Path to the layerized base image, e.g. /changelog/2025-04-25_01__a1b2c3d4.png */
  src: string;
  /** Primary title text overlaid on the lower-left of the banner. */
  title: string;
  /** Optional small uppercase label rendered above the title (e.g. "Changelog · 2025-04-25"). */
  eyebrow?: string;
  /** Optional secondary line beneath the title. */
  subtitle?: string;
  /** Alt text for the background image. Defaults to title. */
  alt?: string;
  /** Optional href — wraps the whole banner in a link. */
  href?: string;
}

const { src, title, eyebrow, subtitle, alt, href } = Astro.props;
const altText = alt ?? title;
const Wrapper = href ? 'a' : 'div';
const wrapperProps = href ? { href, 'aria-label': title, class: 'banner-overlay__link' } : { class: 'banner-overlay__wrapper' };
---

<Wrapper {...wrapperProps}>
  <figure class="banner-overlay">
    <img class="banner-overlay__bg" src={src} alt={altText} loading="lazy" decoding="async" />
    <figcaption class="banner-overlay__caption">
      {eyebrow && <span class="banner-overlay__eyebrow">{eyebrow}</span>}
      <span class="banner-overlay__title">{title}</span>
      {subtitle && <span class="banner-overlay__subtitle">{subtitle}</span>}
    </figcaption>
  </figure>
</Wrapper>

<style>
  .banner-overlay__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .banner-overlay {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 1;
    overflow: hidden;
    border-radius: 0.875rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    isolation: isolate;
  }

  .banner-overlay__bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 350ms ease;
  }
  .banner-overlay__link:hover .banner-overlay__bg {
    transform: scale(1.02);
  }

  /* Gradient scrim — guarantees text legibility regardless of generated image */
  .banner-overlay::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color__obsidian) 78%, transparent) 0%,
      color-mix(in srgb, var(--color__obsidian) 35%, transparent) 35%,
      transparent 65%
    );
    pointer-events: none;
    z-index: 1;
  }

  .banner-overlay__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.5rem 1.75rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    color: var(--color__bone);
  }

  .banner-overlay__eyebrow {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color__lime-terminal);
  }

  .banner-overlay__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.6vw, 2.5rem);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 14px color-mix(in srgb, var(--color__obsidian) 50%, transparent);
  }

  .banner-overlay__subtitle {
    font-family: var(--font-body);
    font-size: clamp(0.875rem, 1.4vw, 1rem);
    color: color-mix(in srgb, var(--color__bone) 80%, transparent);
    max-width: 60ch;
  }

  /* Vibrant mode — drop the scrim opacity so the loud generated colors come through */
  html[data-mode="vibrant"] .banner-overlay::after {
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color__obsidian) 65%, transparent) 0%,
      color-mix(in srgb, var(--color__obsidian) 20%, transparent) 35%,
      transparent 60%
    );
  }

  /* Light mode — invert the scrim so it darkens against light backgrounds */
  html[data-mode="light"] .banner-overlay::after {
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color__ink) 70%, transparent) 0%,
      color-mix(in srgb, var(--color__ink) 25%, transparent) 35%,
      transparent 60%
    );
  }

  @media (max-width: 480px) {
    .banner-overlay__caption { padding: 1rem 1.25rem; gap: 0.25rem; }
  }
</style>
