---
/* GitHubRepoCard — renders the LFM `::github-repo{repo="owner/name"}` leaf
   directive as a card for one GitHub repository: owner/name, description,
   primary language, stars, forks, topics and when it was last pushed.
   Live numbers come from the GitHub API, cached in memory for an hour; if the
   API is slow or rate-limited the card falls back to the directive's own
   attributes (description, language), so it never breaks the page. */
import { fetchRepo } from '../../lib/github-repo';

interface Props {
  node: any;
}

const attrs = (Astro.props.node?.attributes ?? {}) as Record<string, string>;
const slug = (attrs.repo ?? '').replace(/^https?:\/\/github\.com\//, '').replace(/\/$/, '');
const live = slug ? await fetchRepo(slug) : null;

const [owner, name] = slug.split('/');
const description = attrs.description ?? live?.description ?? '';
const language = attrs.language ?? live?.language ?? null;
const topics = (live?.topics ?? []).slice(0, 4);
const pushed = live?.pushed_at
  ? new Date(live.pushed_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  : null;
const homepage = attrs.homepage ?? live?.homepage ?? null;
---

{slug && (
  <a class="repo-card" href={`https://github.com/${slug}`} target="_blank" rel="noopener noreferrer">
    <span class="repo-card__head">
      <svg class="repo-card__mark" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      <span class="repo-card__name"><span class="repo-card__owner">{owner}/</span>{name}</span>
      <span class="repo-card__ext" aria-hidden="true">↗</span>
    </span>
    {description && <span class="repo-card__desc">{description}</span>}
    {topics.length > 0 && (
      <span class="repo-card__topics">{topics.map((t) => <span class="repo-card__topic">{t}</span>)}</span>
    )}
    <span class="repo-card__meta">
      {language && <span class="repo-card__lang"><span class="repo-card__dot" aria-hidden="true"></span>{language}</span>}
      {live && <span>★ {live.stargazers_count}</span>}
      {live && <span>Forks {live.forks_count}</span>}
      {pushed && <span>Updated {pushed}</span>}
      {homepage && <span class="repo-card__home">{homepage.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span>}
    </span>
  </a>
)}

<style>
  .repo-card {
    display: flex; flex-direction: column; gap: .5rem;
    margin: 1rem 0; padding: 1rem 1.1rem; border-radius: .75rem;
    border: 1px solid var(--color-border); background: var(--color-surface);
    color: var(--color-text); text-decoration: none;
    transition: border-color .15s ease;
  }
  .repo-card:hover { border-color: var(--color-primary); }
  .repo-card__head { display: flex; align-items: center; gap: .55rem; min-width: 0; }
  .repo-card__mark { width: 18px; height: 18px; flex: none; color: var(--color-text); }
  .repo-card__name {
    font-family: var(--font-code); font-weight: 700; font-size: .95rem;
    overflow-wrap: anywhere; color: var(--color-text);
  }
  .repo-card:hover .repo-card__name { color: var(--color-primary); }
  .repo-card__owner { font-weight: 400; color: var(--color-text-muted); }
  .repo-card__ext { margin-left: auto; font-size: .8em; color: var(--color-text-muted); }
  .repo-card__desc { font-size: .9rem; line-height: 1.5; }
  .repo-card__topics { display: flex; flex-wrap: wrap; gap: .35rem; }
  .repo-card__topic {
    font-family: var(--font-code); font-size: .68rem; padding: .1rem .5rem; border-radius: 999px;
    border: 1px solid var(--color-border); color: var(--color-text-muted);
  }
  .repo-card__meta {
    display: flex; flex-wrap: wrap; gap: .4rem 1rem;
    font-family: var(--font-code); font-size: .72rem; color: var(--color-text-muted);
  }
  .repo-card__lang { display: inline-flex; align-items: center; gap: .35rem; }
  .repo-card__dot { width: .6rem; height: .6rem; border-radius: 50%; background: var(--color-primary); }
  @media (prefers-reduced-motion: reduce) { .repo-card { transition: none; } }
</style>
