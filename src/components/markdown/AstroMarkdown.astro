---
import type { Root, Content, Heading, List, ListItem, Link, Image, Code, InlineCode, Paragraph, Blockquote } from "mdast";
import { toString } from "mdast-util-to-string";
import { slugifyHeading } from "@lossless-group/lfm";
import CodeBlock from "./CodeBlock.astro";
import Callout from "./Callout.astro";
import MarkdownImage from "./MarkdownImage.astro";
import ImageCarousel from "./ImageCarousel.astro";
import ToolShowcase from "./ToolShowcase.astro";
import SkillPack from "./SkillPack.astro";
import { getSkill, skillUrl } from "../../lib/agent-skills";
import HeadingAnchor from "./HeadingAnchor.astro";
import HoverCard from "./HoverCard.astro";

export interface Props {
  node: Root | Content;
  data?: any;
}

const { node, data } = Astro.props as Props;
const type = (node as any)?.type ?? "root";

function childrenOf(n: any): any[] {
  return Array.isArray(n?.children) ? n.children : [];
}
---

{type === "root" && (
  <>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </>
)}

{type === "paragraph" && (
  <p>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </p>
)}

{type === "text" && <>{(node as any).value}</>}

{type === "strong" && (
  <strong>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </strong>
)}

{type === "emphasis" && (
  <em>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </em>
)}

{type === "heading" && (() => {
  const heading = node as Heading;
  const text = toString(heading);
  // Anchor identity belongs to LFM, not to this renderer. `remarkHeadingIds`
  // (≥0.4.0) stamps `data.id` with a deduped slug and attaches the matching
  // outline at `tree.data.headings`, which is what the ToC renders from.
  // Computing a slug here is what made anchors drift between sites; the
  // fallback calls LFM's own slugifier so there is still exactly one algorithm.
  const id = (heading.data as any)?.id ?? slugifyHeading(text);

  const level = heading.depth ?? 1;
  // Every h2–h4 gets an anchor. On a page with /s/ share pages (it passes
  // data={{ shareBase, shareDepths }}), those depths share the section's own
  // page and card; every other heading copies or shares page#id. Either way
  // the heading text travels with the link.
  const share = data?.shareBase && (data.shareDepths ?? [2, 3]).includes(level)
    ? `${data.shareBase}${id}/`
    : undefined;
  const anchor = level >= 2 && level <= 4;

  if (level === 1) {
    return (
      <h1 id={id}>
        {childrenOf(node).map((child) => (
          <Astro.self node={child} data={data} />
        ))}
      </h1>
    );
  }

  if (level === 2) {
    return (
      <h2 id={id}>
        {childrenOf(node).map((child) => (
          <Astro.self node={child} data={data} />
        ))}
        {anchor && <HeadingAnchor id={id} label={text} shareUrl={share} />}
      </h2>
    );
  }

  if (level === 3) {
    return (
      <h3 id={id}>
        {childrenOf(node).map((child) => (
          <Astro.self node={child} data={data} />
        ))}
        {anchor && <HeadingAnchor id={id} label={text} shareUrl={share} />}
      </h3>
    );
  }

  if (level === 4) {
    return (
      <h4 id={id}>
        {childrenOf(node).map((child) => (
          <Astro.self node={child} data={data} />
        ))}
        {anchor && <HeadingAnchor id={id} label={text} shareUrl={share} />}
      </h4>
    );
  }

  if (level === 5) {
    return (
      <h5 id={id}>
        {childrenOf(node).map((child) => (
          <Astro.self node={child} data={data} />
        ))}
      </h5>
    );
  }

  return (
    <h6 id={id}>
      {childrenOf(node).map((child) => (
        <Astro.self node={child} data={data} />
      ))}
    </h6>
  );
})()}

{type === "list" && (() => {
  const list = node as List;
  const Tag = list.ordered ? "ol" : "ul";
  return (
    <Tag>
      {childrenOf(list).map((child) => (
        <Astro.self node={child} data={data} />
      ))}
    </Tag>
  );
})()}

{type === "listItem" && (
  <li>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </li>
)}

{type === "link" && (() => {
  const link = node as Link;
  const isExternal = link.url?.startsWith('http');
  // Hover cards: a local link to a person or a tool shows that card on hover.
  const smart = link.url?.match(/^\/(people|tools)\/([^/?#]+)\/?$/);
  if (smart) {
    return (
      <HoverCard href={link.url} kind={smart[1] === 'people' ? 'person' : 'tool'} handle={decodeURIComponent(smart[2])}>
        {childrenOf(link).map((child) => (
          <Astro.self node={child} data={data} />
        ))}
      </HoverCard>
    );
  }
  return (
    <a
      href={link.url}
      title={link.title ?? undefined}
      {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
    >
      {childrenOf(link).map((child) => (
        <Astro.self node={child} data={data} />
      ))}
    </a>
  );
})()}

{type === "image" && (() => {
  const img = node as Image;
  return <img src={img.url} alt={img.alt ?? ""} title={img.title ?? undefined} loading="lazy" />;
})()}

{type === "code" && (() => {
  const code = node as Code;
  return <CodeBlock language={code.lang ?? undefined} code={code.value} meta={code.meta ?? undefined} />;
})()}

{type === "inlineCode" && (() => {
  const inline = node as InlineCode;
  return <code>{inline.value}</code>;
})()}

{type === "blockquote" && (() => {
  const block = node as Blockquote;
  return (
    <blockquote>
      {childrenOf(block).map((child) => (
        <Astro.self node={child} data={data} />
      ))}
    </blockquote>
  );
})()}

{type === "thematicBreak" && <hr />}

{type === "table" && (
  <div class="ak-table-wrap">
    <table>
      {childrenOf(node).map((child, idx) => {
        if (idx === 0) {
          return (
            <thead>
              <Astro.self node={child} data={data} />
            </thead>
          );
        }
        return null;
      })}
      <tbody>
        {childrenOf(node).slice(1).map((child) => (
          <Astro.self node={child} data={data} />
        ))}
      </tbody>
    </table>
  </div>
)}

{type === "tableRow" && (
  <tr>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </tr>
)}

{type === "tableCell" && (
  <td>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </td>
)}

{type === "delete" && (
  <del>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </del>
)}

{type === "html" && <Fragment set:html={(node as any).value} />}

{type === "break" && <br />}

{type === "footnoteReference" && (() => {
  const ref: any = node;
  const index = ref.data?.citationIndex ?? ref.identifier;
  const hex = ref.data?.citationHex ?? ref.identifier;
  return (
    <sup class="citation-marker">
      <a href={`#source-${hex}`} title={`Citation ${index}`}>[{index}]</a>
    </sup>
  );
})()}

{type === "footnoteDefinition" && null}

{/* Directive handling: callout + badge */}
{["leafDirective", "containerDirective"].includes(type) && (() => {
  const directive: any = node;
  if (directive.name === "callout") {
    return <Callout node={directive} data={data} />;
  }
  if (directive.name === "image") {
    return <MarkdownImage node={directive} data={data} />;
  }
  // `img-carousel` is a syntactic alias of `image-carousel` — both normalise to
  // the same component, per the LFM polyglot rule (aliases render identically).
  if (directive.name === "image-carousel" || directive.name === "img-carousel") {
    return <ImageCarousel node={directive} data={data} />;
  }
  if (directive.name === "tool-showcase") {
    return <ToolShowcase node={directive} data={data} />;
  }
  // `agent-skills` is an alias of `skill-pack`; both render the same grid.
  if (directive.name === "skill-pack" || directive.name === "agent-skills") {
    return <SkillPack node={directive} data={data} />;
  }
  // Fallback: render children as-is
  return (
    <div>
      {childrenOf(directive).map((child) => (
        <Astro.self node={child} data={data} />
      ))}
    </div>
  );
})()}

{type === "textDirective" && (() => {
  const directive: any = node;
  if (directive.name === "badge") {
    return <span class="ak-badge">{childrenOf(directive).map((child) => toString(child))}</span>;
  }
  // :skill[market-capture-analysis] — an inline reference to a registry skill.
  // Links to the skill on GitHub; the summary rides in the title tooltip.
  if (directive.name === "skill") {
    const label = childrenOf(directive).map((child) => toString(child)).join("").trim();
    const skill = getSkill(directive.attributes?.slug ?? label);
    if (!skill) return <>{label}</>;
    return (
      <a class="ak-skill-ref" href={skillUrl(skill)} title={skill.summary} target="_blank" rel="noopener noreferrer">
        <span class="ak-skill-ref__icon" aria-hidden="true">⚙</span>{directive.attributes?.slug ? label : skill.name}
      </a>
    );
  }
  // Fallback: just render inner text
  return <>{childrenOf(directive).map((child) => toString(child))}</>;
})()}

{/* Fallback for unhandled node types: render children only */}
{![
  "root",
  "paragraph",
  "text",
  "strong",
  "emphasis",
  "heading",
  "list",
  "listItem",
  "link",
  "image",
  "code",
  "inlineCode",
  "blockquote",
  "thematicBreak",
  "table",
  "tableRow",
  "tableCell",
  "delete",
  "html",
  "break",
  "leafDirective",
  "containerDirective",
  "textDirective",
  "footnoteReference",
  "footnoteDefinition",
].includes(type) && (
  <>
    {childrenOf(node).map((child) => (
      <Astro.self node={child} data={data} />
    ))}
  </>
)}

<style>
  .ak-badge {
    display: inline-block;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    background: rgba(59, 130, 246, 0.1);
    color: rgb(96, 165, 250);
  }

  .ak-skill-ref {
    display: inline-flex; align-items: baseline; gap: .25em;
    padding: 0 .4em; border-radius: .35em;
    border: 1px solid var(--color-border);
    font-family: var(--font-code); font-size: .88em;
    color: var(--color-text); text-decoration: none; white-space: nowrap;
  }
  .ak-skill-ref:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .ak-skill-ref__icon { color: var(--color-primary); font-size: .9em; }

  /* Restore list styles stripped by Tailwind preflight */
  ul {
    list-style-type: disc;
    padding-left: 1.5em;
    margin-bottom: 1em;
  }

  ol {
    list-style-type: decimal;
    padding-left: 1.5em;
    margin-bottom: 1em;
  }

  li {
    margin-bottom: 0.25em;
  }

  /* Nested lists */
  li ul {
    list-style-type: circle;
    margin-top: 0.25em;
    margin-bottom: 0.25em;
  }

  li ol {
    margin-top: 0.25em;
    margin-bottom: 0.25em;
  }

  li li ul {
    list-style-type: square;
  }
</style>
