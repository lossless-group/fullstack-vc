---
/* LinkCard — renders the LFM `::link-card{url="…"}` leaf directive as a
   preview card for one web page: image, site, title and a line of
   description, the whole card a link. Everything comes from the directive's
   attributes (url, title, description, image, site), so nothing is fetched at
   request time; without a title it shows the URL's host. */

interface Props {
  node: any;
}

const attrs = (Astro.props.node?.attributes ?? {}) as Record<string, string>;
const url = attrs.url ?? '';
let host = '';
try { host = new URL(url).host.replace(/^www\./, ''); } catch { /* not a URL */ }
const site = attrs.site ?? host;
const title = attrs.title ?? host;
const external = /^https?:\/\//.test(url);
---

{url && (
  <a class="link-card" href={url} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
    {attrs.image && <img class="link-card__image" src={attrs.image} alt="" loading="lazy" decoding="async" />}
    <span class="link-card__body">
      {site && <span class="link-card__site">{site}</span>}
      <span class="link-card__title">{title}{external && <span class="link-card__ext" aria-hidden="true">↗</span>}</span>
      {attrs.description && <span class="link-card__desc">{attrs.description}</span>}
    </span>
  </a>
)}

<style>
  .link-card {
    display: grid; grid-template-columns: minmax(0, 11rem) 1fr; align-items: stretch;
    margin: 1rem 0; border-radius: .75rem; overflow: hidden;
    border: 1px solid var(--color-border); background: var(--color-surface);
    color: var(--color-text); text-decoration: none;
    transition: border-color .15s ease;
  }
  .link-card:not(:has(.link-card__image)) { grid-template-columns: 1fr; }
  .link-card:hover { border-color: var(--color-primary); }
  .link-card__image { width: 100%; height: 100%; min-height: 6.5rem; object-fit: cover; display: block; }
  .link-card__body { display: flex; flex-direction: column; gap: .3rem; padding: .9rem 1.1rem; min-width: 0; }
  .link-card__site {
    font-family: var(--font-code); font-size: .68rem; text-transform: uppercase; letter-spacing: .1em;
    color: var(--color-text-muted);
  }
  .link-card__title { font-weight: 700; font-size: 1rem; line-height: 1.3; }
  .link-card:hover .link-card__title { color: var(--color-primary); }
  .link-card__ext { margin-left: .3rem; font-size: .8em; color: var(--color-text-muted); }
  .link-card__desc { font-size: .88rem; line-height: 1.5; color: var(--color-text-muted); }
  @media (max-width: 30rem) {
    .link-card { grid-template-columns: 1fr; }
    .link-card__image { aspect-ratio: 1200 / 630; min-height: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .link-card { transition: none; } }
</style>
