---
// CodeBlock — fenced code inside LFM-rendered content.
//
// Highlighting happens at build time in lib/code-highlight.ts, which emits
// inline `var(--code-*)` colors. All palette decisions live in theme.css;
// nothing here hardcodes a color.
import { highlightCode, resolveLang } from '../../lib/code-highlight';

export interface Props {
  language?: string;
  code: string;
  meta?: string;
}

const { language, code } = Astro.props as Props;

const resolved = resolveLang(language);
// Show the author's own fence label when they gave one; only fall back to the
// resolved grammar so an unlabeled block doesn't claim to be something it isn't.
const langLabel = language?.trim() ? language.trim().toUpperCase() : undefined;
const html = await highlightCode(code, language);
---

<div class="ak-codeblock-wrap" data-lang={resolved}>
  <div class="ak-codeblock-chrome">
    {langLabel && <span class="ak-codeblock-lang">{langLabel}</span>}
    <button class="ak-codeblock-copy" type="button" aria-label="Copy code to clipboard" data-copy-btn>
      Copy
    </button>
  </div>
  <div class="ak-codeblock" set:html={html} />
</div>

<script>
  // One delegated listener for every code block on the page.
  document.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement)?.closest?.('[data-copy-btn]') as HTMLButtonElement | null;
    if (!btn) return;
    const code = btn.closest('.ak-codeblock-wrap')?.querySelector('pre code')?.textContent ?? '';
    try {
      await navigator.clipboard.writeText(code);
      btn.textContent = 'Copied ✓';
    } catch {
      btn.textContent = 'Press ⌘C';
      const sel = window.getSelection();
      const range = document.createRange();
      const codeEl = btn.closest('.ak-codeblock-wrap')?.querySelector('pre code');
      if (codeEl && sel) {
        range.selectNodeContents(codeEl);
        sel.removeAllRanges();
        sel.addRange(range);
      }
    }
    setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
  });
</script>

<style>
  .ak-codeblock-wrap {
    position: relative;
    margin-bottom: 1.5rem;
    border-radius: 0.5rem;
    /* was var(--border), which is not a token in this system — the border
       silently fell back to currentColor. */
    border: 1px solid var(--code-border);
    overflow: hidden;
  }

  /* A real header row, not an overlay. Absolutely positioning this floated it
     over the first line of code and crowded the right edge. */
  .ak-codeblock-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.625rem;
    padding: 0.375rem 0.625rem 0.375rem 0.875rem;
    background: var(--code-chrome-bg);
    border-bottom: 1px solid var(--code-border);
  }

  /* Keeps Copy hard right when a block has no language label. */
  .ak-codeblock-chrome > :only-child {
    margin-left: auto;
  }

  .ak-codeblock-lang {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--code-chrome-text);
    pointer-events: none;
  }

  .ak-codeblock-copy {
    font-family: var(--font-code, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--code-chrome-text);
    /* Transparent on the chrome bar — a filled background would vanish into
       it, since the bar now uses --code-chrome-bg itself. */
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0.3125rem;
    padding: 0.1875rem 0.5rem;
    cursor: pointer;
    transition: color 120ms ease, background 120ms ease, border-color 120ms ease;
  }
  .ak-codeblock-copy:hover,
  .ak-codeblock-copy:focus-visible {
    color: var(--code-fg);
    background: var(--code-chrome-bg-hover);
    border-color: var(--code-border);
  }

  /* Shiki emits its own <pre>; this wrapper owns layout, that owns color. */
  .ak-codeblock :global(pre.shiki) {
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0;
  }

  .ak-codeblock :global(pre.shiki code) {
    font-family: var(--font-code, ui-monospace, SFMono-Regular, Menlo, Monaco,
      Consolas, "Liberation Mono", "Courier New", monospace);
    display: block;
  }

  /* Shiki wraps each line in <span class="line">, separated by a literal
     newline. Inside a <pre> that newline already breaks the line, so these
     spans MUST stay inline — making them block double-spaces every block. */
  .ak-codeblock :global(pre.shiki .line) {
    display: inline;
  }

  @media (prefers-reduced-motion: reduce) {
    .ak-codeblock-copy { transition: none; }
  }
</style>
