---
/* MobileNav
   Hamburger-driven nav for ≤640px. Sits inside Header.astro alongside the
   ModeToggle and is hidden at desktop widths. Receives the same pre-loaded
   `popdownProjects` and `popdownWorkingGroups` arrays the desktop popdowns
   consume — single source of truth, two consumers.

   Behavior:
     - Click hamburger → toggle drawer + flip aria-expanded.
     - Esc while open → close + return focus to trigger.
     - Click outside [data-mnav] → close.
     - Tap any link → page navigates → drawer DOM is destroyed (MPA).
   The Working Groups and Projects sections are <details>/<summary>
   accordions so the no-JS fallback works (semantic + accessible). */

import type { ProjectEntry } from '../../lib/load-projects';
import type { WorkingGroupEntry } from '../../lib/load-working-groups';
import { projectHref } from '../../lib/load-projects';
import { workingGroupHref } from '../../lib/load-working-groups';

export interface Props {
  popdownProjects: ProjectEntry[];
  popdownWorkingGroups: WorkingGroupEntry[];
}

const { popdownProjects, popdownWorkingGroups } = Astro.props;

// Auth indicator: rendered logged-out by default. The inline <script> in
// Header.astro hits /api/me after hydration and flips ALL
// [data-auth-indicator] elements on the page (including this one) to the
// signed-in state if the user has a valid session cookie.

const activeWGs = popdownWorkingGroups.filter(wg => wg.data.status === 'active');
const proposedWGs = popdownWorkingGroups.filter(wg => wg.data.status === 'proposed');
const activeProjects = popdownProjects.filter(p => p.data.status === 'active');
const proposedProjects = popdownProjects.filter(p => p.data.status === 'proposed');
---

<div class="mnav" data-mnav>
  <button
    type="button"
    class="mnav__trigger"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="mnav-panel"
    aria-label="Open menu"
    data-mnav-trigger
  >
    <span class="mnav__bars" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
  </button>

  <div id="mnav-panel" class="mnav__panel" role="menu" aria-label="Mobile navigation" data-mnav-panel hidden>
    <ul class="mnav__list">
      <li><a class="mnav__link" href="/dojo" role="menuitem">Dojo</a></li>

      <li>
        <details class="mnav__group">
          <summary class="mnav__group-summary">
            <span>Working Groups</span>
            <span class="mnav__chev" aria-hidden="true">▾</span>
          </summary>
          <ul class="mnav__sublist">
            {activeWGs.map(wg => (
              <li>
                <a class="mnav__sublink" href={workingGroupHref(wg)} role="menuitem">
                  <span class="mnav__sublink-icon" aria-hidden="true">{wg.data.icon ?? '◆'}</span>
                  <span>{wg.data.title}</span>
                </a>
              </li>
            ))}
            {proposedWGs.length > 0 && (
              <>
                <li class="mnav__sublist-label">Proposed</li>
                {proposedWGs.map(wg => (
                  <li>
                    <a class="mnav__sublink mnav__sublink--proposed" href={workingGroupHref(wg)} role="menuitem">
                      <span class="mnav__sublink-icon" aria-hidden="true">{wg.data.icon ?? '◇'}</span>
                      <span>{wg.data.title}</span>
                    </a>
                  </li>
                ))}
              </>
            )}
            <li class="mnav__group-foot">
              <a href="/working-groups/" role="menuitem">View all working groups →</a>
            </li>
          </ul>
        </details>
      </li>

      <li>
        <details class="mnav__group">
          <summary class="mnav__group-summary">
            <span>Projects</span>
            <span class="mnav__chev" aria-hidden="true">▾</span>
          </summary>
          <ul class="mnav__sublist">
            {activeProjects.map(p => (
              <li>
                <a class="mnav__sublink" href={projectHref(p)} role="menuitem">
                  <span class="mnav__sublink-icon" aria-hidden="true">{p.data.icon ?? '◆'}</span>
                  <span>{p.data.title}</span>
                </a>
              </li>
            ))}
            {proposedProjects.length > 0 && (
              <>
                <li class="mnav__sublist-label">Proposed</li>
                {proposedProjects.map(p => (
                  <li>
                    <a class="mnav__sublink mnav__sublink--proposed" href={projectHref(p)} role="menuitem">
                      <span class="mnav__sublink-icon" aria-hidden="true">{p.data.icon ?? '◇'}</span>
                      <span>{p.data.title}</span>
                    </a>
                  </li>
                ))}
              </>
            )}
            <li class="mnav__group-foot">
              <a href="/projects/" role="menuitem">View all projects →</a>
            </li>
          </ul>
        </details>
      </li>

      <li><a class="mnav__link" href="/stacks" role="menuitem">Stacks</a></li>
      <li><a class="mnav__link" href="/people" role="menuitem">People</a></li>
      <li><a class="mnav__link" href="/recipes" role="menuitem">Recipes</a></li>
      <li><a class="mnav__link" href="/sessions" role="menuitem">Sessions</a></li>
      <li><a class="mnav__link" href="/changelog" role="menuitem">Changelog</a></li>
      <li><a class="mnav__link" href="/about" role="menuitem">About</a></li>
      <li>
        <a
          class="mnav__link mnav__login"
          href="/login"
          role="menuitem"
          data-auth-indicator
          data-state="out"
          data-has-avatar="false"
          aria-label="Log in"
        >
          <span class="mnav__login-dot" aria-hidden="true"></span>
          <span class="mnav__login-text" data-auth-text>Log in</span>
          <img
            class="mnav__avatar"
            src=""
            alt=""
            data-auth-avatar
            aria-hidden="true"
          />
          <svg
            class="mnav__avatar-fallback"
            data-auth-avatar-fallback
            viewBox="0 0 24 24"
            aria-hidden="true"
            focusable="false"
          >
            <path
              fill="currentColor"
              d="M12 2a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 12c-4.42 0-8 2.24-8 5v1h16v-1c0-2.76-3.58-5-8-5z"
            />
          </svg>
          <span class="mnav__login-signed-in" data-auth-signed-in-text>Signed in</span>
          <span class="mnav__login-partial-text" data-auth-partial-text>Connect more &rarr;</span>
        </a>
      </li>
    </ul>
  </div>
</div>

<script>
  function setOpen(wrap: HTMLElement, open: boolean) {
    const trigger = wrap.querySelector<HTMLButtonElement>('[data-mnav-trigger]');
    const panel = wrap.querySelector<HTMLElement>('[data-mnav-panel]');
    if (!trigger || !panel) return;
    trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    trigger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    panel.hidden = !open;
    wrap.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('mnav-open', open);
  }
  function isOpen(wrap: HTMLElement) {
    return wrap.classList.contains('is-open');
  }
  function init() {
    document.querySelectorAll<HTMLElement>('[data-mnav]').forEach(wrap => {
      const trigger = wrap.querySelector<HTMLButtonElement>('[data-mnav-trigger]');
      const panel = wrap.querySelector<HTMLElement>('[data-mnav-panel]');
      if (!trigger || !panel) return;

      trigger.addEventListener('click', e => {
        e.preventDefault();
        setOpen(wrap, !isOpen(wrap));
      });

      // Esc closes; return focus to trigger.
      wrap.addEventListener('keydown', e => {
        if (e.key === 'Escape' && isOpen(wrap)) {
          e.preventDefault();
          setOpen(wrap, false);
          trigger.focus();
        }
      });

      // Click outside closes.
      document.addEventListener('click', e => {
        if (!isOpen(wrap)) return;
        if (wrap.contains(e.target as Node)) return;
        setOpen(wrap, false);
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>

<style>
  .mnav {
    display: none;
    position: relative;
    align-items: center;
  }
  @media (max-width: 640px) {
    .mnav { display: inline-flex; }
  }

  /* Hamburger button — 36x36 tap target with 3 bars that morph into an X */
  .mnav__trigger {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    color: var(--color-text);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .mnav__trigger:hover,
  .mnav__trigger:focus-visible,
  .mnav.is-open .mnav__trigger {
    color: var(--color-primary);
    border-color: var(--color-border);
    outline: none;
  }
  .mnav__bars {
    position: relative;
    display: inline-block;
    width: 1.125rem;
    height: 0.875rem;
  }
  .mnav__bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transition: transform 200ms ease, opacity 150ms ease, top 200ms ease;
  }
  .mnav__bars span:nth-child(1) { top: 0; }
  .mnav__bars span:nth-child(2) { top: calc(50% - 1px); }
  .mnav__bars span:nth-child(3) { top: calc(100% - 2px); }
  .mnav.is-open .mnav__bars span:nth-child(1) {
    top: calc(50% - 1px);
    transform: rotate(45deg);
  }
  .mnav.is-open .mnav__bars span:nth-child(2) { opacity: 0; }
  .mnav.is-open .mnav__bars span:nth-child(3) {
    top: calc(50% - 1px);
    transform: rotate(-45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .mnav__bars span { transition: none; }
  }

  /* Panel — full-width drawer pinned beneath the sticky header */
  .mnav__panel {
    position: fixed;
    top: 3.5rem;          /* matches the sticky header's bottom edge */
    left: 0;
    right: 0;
    z-index: 49;          /* one below the header (50) so the header stays on top */
    max-height: calc(100vh - 3.5rem);
    overflow-y: auto;
    background: color-mix(in srgb, var(--color-background) 96%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .mnav.is-open .mnav__panel[hidden] { display: block; }
  .mnav.is-open .mnav__panel {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .mnav__panel { transition: none; }
  }

  /* Lock body scroll while open */
  :global(html.mnav-open) {
    overflow: hidden;
  }

  /* List + items */
  .mnav__list {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
  }
  .mnav__link,
  .mnav__group-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;       /* 44px tap target */
    padding: 0.625rem 1.25rem;
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-code);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-bottom: 1px solid var(--color-border);
    cursor: pointer;
  }
  .mnav__link:hover,
  .mnav__link:focus-visible,
  .mnav__group-summary:hover,
  .mnav__group-summary:focus-visible {
    background: color-mix(in srgb, var(--color-primary) 6%, var(--color-surface));
    color: var(--color-primary);
    outline: none;
  }
  .mnav__link--cta {
    color: var(--color-primary);
  }

  /* ── Mobile auth indicator (mirrors Header's pattern) ─────────────── */
  .mnav__login {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .mnav__login-dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    flex: 0 0 auto;
    transition: background-color 200ms ease, box-shadow 200ms ease;
  }
  .mnav__login[data-state="out"] .mnav__login-dot {
    background: #ef4444;
    box-shadow: 0 0 8px 2px rgba(239, 68, 68, 0.45);
    animation: mnav-pulse-out 1.6s ease-in-out infinite;
  }
  .mnav__login[data-state="in"] .mnav__login-dot {
    background: #22c55e;
    box-shadow: 0 0 6px 1px rgba(34, 197, 94, 0.45);
    animation: mnav-pulse-in 2.2s ease-in-out infinite;
  }
  /* Partial: one provider connected — yellow nudge. Tap the row to /login
     and connect the missing provider. (Mobile drawer skips the tooltip
     popover that the desktop indicator uses.) */
  .mnav__login[data-state="partial"] .mnav__login-dot {
    background: #f59e0b;
    box-shadow: 0 0 7px 1.5px rgba(245, 158, 11, 0.5);
    animation: mnav-pulse-partial 1.8s ease-in-out infinite;
  }
  @keyframes mnav-pulse-out {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.55; transform: scale(0.85); }
  }
  @keyframes mnav-pulse-in {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.7; }
  }
  @keyframes mnav-pulse-partial {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.7; transform: scale(0.92); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mnav__login-dot { animation: none; }
  }

  .mnav__login-text,
  .mnav__login-signed-in,
  .mnav__login-partial-text {
    display: none;
  }
  .mnav__login[data-state="out"] .mnav__login-text {
    display: inline;
  }
  .mnav__login[data-state="in"] .mnav__login-signed-in {
    display: inline;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  .mnav__login[data-state="partial"] .mnav__login-partial-text {
    display: inline;
    color: rgb(245, 158, 11);
    font-size: 0.875rem;
  }

  .mnav__avatar,
  .mnav__avatar-fallback {
    display: none;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 50%;
    flex: 0 0 auto;
  }
  .mnav__avatar {
    object-fit: cover;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .mnav__avatar-fallback {
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 1px;
  }
  .mnav__login[data-state="in"][data-has-avatar="true"] .mnav__avatar {
    display: block;
  }
  .mnav__login[data-state="in"]:not([data-has-avatar="true"]) .mnav__avatar-fallback {
    display: block;
  }
  .mnav__group-summary {
    list-style: none;          /* removes the default disclosure triangle */
  }
  .mnav__group-summary::-webkit-details-marker { display: none; }

  .mnav__chev {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    transition: transform 200ms ease;
  }
  .mnav__group[open] .mnav__chev {
    transform: rotate(180deg);
    color: var(--color-primary);
  }
  @media (prefers-reduced-motion: reduce) {
    .mnav__chev { transition: none; }
  }

  /* Sublist (inside <details>) */
  .mnav__sublist {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0;
    background: color-mix(in srgb, var(--color-primary) 4%, var(--color-surface));
  }
  .mnav__sublink {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.5rem;
    padding: 0.5rem 1.25rem 0.5rem 2rem;
    color: var(--color-text);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.9375rem;
  }
  .mnav__sublink:hover,
  .mnav__sublink:focus-visible {
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
    color: var(--color-primary);
    outline: none;
  }
  .mnav__sublink--proposed {
    color: var(--color-text-muted);
  }
  .mnav__sublink-icon {
    color: var(--color-primary);
    width: 1.25rem;
    text-align: center;
  }
  .mnav__sublist-label {
    padding: 0.5rem 1.25rem 0.25rem 2rem;
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
  }
  .mnav__group-foot {
    padding: 0.625rem 1.25rem 0.625rem 2rem;
    border-top: 1px dashed var(--color-border);
  }
  .mnav__group-foot a {
    color: var(--color-primary);
    text-decoration: none;
    font-family: var(--font-code);
    font-size: 0.8125rem;
  }
</style>
