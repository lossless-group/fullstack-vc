---
// ============================================================================
// SocialsFaviconRow.astro — universal social-icon row.
//
// Each platform is an optional prop. Pass a URL to render that platform's
// link; omit it to hide it. The component renders nothing if no platforms
// are passed. This makes the component reusable across sites without each
// site needing to fork it.
//
// Origin: sites/mpstaton-site/src/components/basics/SocialsFaviconRow.astro
// (the mpstaton version hardcoded mpstaton's own URLs; this is the
// generalized successor that sites should adopt going forward).
//
// Hover uses --color-primary so the row tracks the active brand theme
// across light / dark / vibrant modes. If a site wants per-platform brand
// colors (LinkedIn-blue hover, etc.), add a `useBrandColors` prop later.
// ============================================================================

interface Props {
  github?: string;
  linkedin?: string;
  twitter?: string;     // The platform formerly known as Twitter. Renders an X glyph.
  bluesky?: string;
  instagram?: string;
  youtube?: string;
  mastodon?: string;
  /** Bare email address — automatically prefixed with `mailto:`. */
  email?: string;
  /** RSS / Atom feed URL. */
  rss?: string;
  /** Icon size in px. Default 18. */
  size?: number;
  /** Extra class on the wrapping container. */
  class?: string;
}

const {
  github, linkedin, twitter, bluesky, instagram, youtube, mastodon, email, rss,
  size = 18,
  class: extraClass = '',
} = Astro.props;

const links: Array<{ href: string; label: string; icon: string }> = [];

if (github)    links.push({ href: github,    label: 'GitHub',    icon: 'github' });
if (linkedin)  links.push({ href: linkedin,  label: 'LinkedIn',  icon: 'linkedin' });
if (twitter)   links.push({ href: twitter,   label: 'X (Twitter)', icon: 'x' });
if (bluesky)   links.push({ href: bluesky,   label: 'Bluesky',   icon: 'bluesky' });
if (instagram) links.push({ href: instagram, label: 'Instagram', icon: 'instagram' });
if (youtube)   links.push({ href: youtube,   label: 'YouTube',   icon: 'youtube' });
if (mastodon)  links.push({ href: mastodon,  label: 'Mastodon',  icon: 'mastodon' });
if (rss)       links.push({ href: rss,       label: 'RSS feed',  icon: 'rss' });
if (email)     links.push({ href: `mailto:${email}`, label: 'Email', icon: 'email' });
---

{links.length > 0 && (
  <div class:list={['socials-row', extraClass]} role="list" aria-label="Social links">
    {links.map(link => {
      const external = !link.href.startsWith('mailto:');
      return (
        <a
          href={link.href}
          class="socials-row__link"
          aria-label={link.label}
          title={link.label}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
          role="listitem"
        >
          {link.icon === 'github' && (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
            </svg>
          )}
          {link.icon === 'linkedin' && (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          )}
          {link.icon === 'x' && (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
            </svg>
          )}
          {link.icon === 'bluesky' && (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M5.203 3.166c2.756 2.073 5.722 6.276 6.802 8.531 1.08-2.255 4.046-6.458 6.802-8.531C20.795 1.696 24 .56 24 4.234c0 .733-.42 6.156-.667 7.036-.86 3.06-3.98 3.84-6.756 3.367 4.853.826 6.088 3.563 3.422 6.301-5.063 5.196-7.276-1.305-7.842-2.97-.104-.305-.152-.448-.152-.327 0-.121-.049.022-.152.327-.567 1.665-2.78 8.166-7.842 2.97-2.667-2.738-1.43-5.475 3.421-6.301-2.776.473-5.896-.307-6.755-3.367C.42 10.39 0 4.967 0 4.234 0 .56 3.205 1.696 5.203 3.166z"/>
            </svg>
          )}
          {link.icon === 'instagram' && (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C16.67.014 16.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
            </svg>
          )}
          {link.icon === 'youtube' && (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          )}
          {link.icon === 'mastodon' && (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.668-1.67 1.977v6.218H4.822V8.102c0-1.31.337-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.012 1.81 1.012 3.12z"/>
            </svg>
          )}
          {link.icon === 'rss' && (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M6.503 20.752A3.498 3.498 0 0 1 3 24a3.498 3.498 0 0 1-3.5-3.248A3.498 3.498 0 0 1 3 17.252a3.5 3.5 0 0 1 3.503 3.5zM1.677 6.462v4.423c5.32 0 9.825 4.502 9.825 9.825h4.423c0-7.748-6.500-14.248-14.248-14.248zM1.677 0v4.423C12.677 4.423 19.577 11.323 19.577 22.323H24C24 9.873 14.127 0 1.677 0z"/>
            </svg>
          )}
          {link.icon === 'email' && (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="m22 7-10 5L2 7"/>
            </svg>
          )}
        </a>
      );
    })}
  </div>
)}

<style>
  .socials-row {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }
  .socials-row__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: color 150ms ease;
    line-height: 0;            /* prevents extra vertical spacing around inline SVGs */
  }
  .socials-row__link:hover {
    color: var(--color-primary);
  }
  .socials-row__link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }
</style>
