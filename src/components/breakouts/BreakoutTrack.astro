---
import type { BreakoutTrack, BreakoutQuestion, ArtifactField } from '../../data/breakouts/from-yes-to-win';

export interface Props {
  track: BreakoutTrack;
  entryState: string;
  questions: BreakoutQuestion[];
  artifactFields: ArtifactField[];
  showParentLink?: boolean;
}

const {
  track,
  entryState,
  questions,
  artifactFields,
  showParentLink = true,
} = Astro.props;
---

<article class="breakout-track">
  {showParentLink && (
    <a href="/breakouts/from-yes-to-win" class="parent-link">
      ← From Yes to Win
    </a>
  )}

  <header class="track-header">
    <p class="eyebrow">Breakout track</p>
    <h1 class="track-title">{track.title}</h1>
    <p class="track-hook">"{track.hook}"</p>
  </header>

  <section class="block">
    <h2 class="block-title">Where you're starting</h2>
    <p class="entry-state">{entryState}</p>
    <p class="reality">{track.reality}</p>
  </section>

  <section class="block">
    <h2 class="block-title">A starter example</h2>
    <p class="starter">{track.starterExample}</p>
    <details class="agent-hints">
      <summary>Agents that have come up in conversation</summary>
      <ul>
        {track.agentHints.map((hint) => <li>{hint}</li>)}
      </ul>
    </details>
  </section>

  <section class="block">
    <h2 class="block-title">Five questions for the group</h2>
    <ol class="questions">
      {questions.map((q) => (
        <li class={`question ${q.n === 5 ? 'question--closer' : ''}`}>
          <div class="question-n">Q{q.n}</div>
          <div class="question-body">
            <p class="question-prompt">{q.prompt}</p>
            <p class="question-lens">{q.lens}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="time-note">
      12 minutes. Treat the questions as a rail, not a march — Q5 is the only mandatory landing.
    </p>
  </section>

  <section class="block">
    <h2 class="block-title">What you bring back</h2>
    <p class="artifact-intro">
      Same shape across all three tracks. 90 seconds at the end, fill it out together:
    </p>
    <div class="artifact-card">
      {artifactFields.map((field) => (
        <div class="artifact-field">
          <div class="artifact-label">{field.label}</div>
          <div class="artifact-placeholder">{field.placeholder}</div>
        </div>
      ))}
    </div>
  </section>
</article>

<style>
  .breakout-track {
    max-width: 44rem;
    margin: 0 auto;
  }

  .parent-link {
    display: inline-block;
    font-family: var(--font-code);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    text-decoration: none;
  }
  .parent-link:hover {
    color: var(--color-primary);
  }

  .track-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }
  .eyebrow {
    font-family: var(--font-code);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
  }
  .track-title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 1rem;
    line-height: 1.15;
  }
  .track-hook {
    font-size: 1.125rem;
    font-style: italic;
    color: var(--color-text-muted);
    margin: 0;
  }

  .block {
    margin-bottom: 2.5rem;
  }
  .block-title {
    font-family: var(--font-code);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .entry-state {
    font-size: 1rem;
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }
  .reality {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .starter {
    font-size: 1rem;
    color: var(--color-text);
    margin: 0 0 1rem;
  }
  .agent-hints {
    background: var(--fx-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
  }
  .agent-hints summary {
    cursor: pointer;
    font-family: var(--font-code);
    font-size: 0.875rem;
    color: var(--color-text);
  }
  .agent-hints ul {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }
  .agent-hints li {
    margin: 0.375rem 0;
  }

  .questions {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .question {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--fx-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
  }
  .question--closer {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 6%, var(--fx-card-bg));
  }
  .question-n {
    font-family: var(--font-code);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-accent);
  }
  .question-prompt {
    font-size: 1rem;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }
  .question-lens {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0;
  }

  .time-note {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 1.25rem 0 0;
    font-family: var(--font-code);
  }

  .artifact-intro {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
  }
  .artifact-card {
    background: var(--fx-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .artifact-field {
    border-left: 2px solid var(--color-primary);
    padding-left: 0.875rem;
  }
  .artifact-label {
    font-family: var(--font-code);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }
  .artifact-placeholder {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
