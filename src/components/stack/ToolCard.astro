---
/* ToolCard
   Visual reference: lossless.group/toolkit cards (source at
   `code/lossless-monorepo/site/src/components/tool-components/ToolCard.astro`).
   Adapted to FSV semantic tokens, mode-aware. Pure Astro, no JS.

   Accepts a partial tool entry — every field is optional except the slug,
   so hand-pasted Obsidian files with sparse frontmatter still render. */

interface ToolEntryData {
  site_uuid?: string;
  site_name?: string;
  title?: string;
  zinger?: string;
  url?: string;
  tags?: string[];
  og_screenshot_url?: string;
  og_favicon?: string;
  og_image?: string;
  logo_light?: string;
  logo_dark?: string;
  description_site_cp?: string;
  description?: string;
  // Bare-name aliases inherited from Obsidian Tooling frontmatter.
  // Renderer falls back from og_* to these when the og_* form is absent.
  image?: string;
  favicon?: string;
  hero_image_url?: string;
}

interface Props {
  slug: string;
  data: ToolEntryData;
  /** Compact variant — header + image only, no description/tags/cta. */
  small?: boolean;
  /** Optional context strings that ride along on the card (e.g., "Daily driver"). */
  notes?: string;
  intent?: string;
  reason?: string;
  abandoned?: string;
}

const { slug, data, small = false, notes, intent, reason, abandoned } = Astro.props;

const displayName = data.site_name ?? slug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
const tagline = data.zinger ?? data.title ?? '';
const description = data.description_site_cp ?? data.description ?? '';
const screenshot = data.og_screenshot_url ?? data.og_image ?? data.image ?? data.hero_image_url;
const favicon = data.og_favicon ?? data.favicon;
const tags = data.tags ?? [];

// Annotation line — whichever stack tier passed context.
const annotation = notes ?? intent ?? reason ?? (abandoned ? `Moved on ${abandoned}` : '');
---

<article class={`tool-card${small ? ' tool-card--small' : ''}`}>
  {screenshot && !small && (
    <div class="tool-card__media">
      <img src={screenshot} alt="" loading="lazy" decoding="async" />
    </div>
  )}

  <div class="tool-card__body">
    <header class="tool-card__head">
      {favicon && <img class="tool-card__favicon" src={favicon} alt="" loading="lazy" decoding="async" />}
      <div class="tool-card__head-text">
        {data.url ? (
          <a class="tool-card__name" href={data.url} target="_blank" rel="noopener noreferrer">
            {displayName}
            <span class="tool-card__ext" aria-hidden="true">↗</span>
          </a>
        ) : (
          <span class="tool-card__name">{displayName}</span>
        )}
        {tagline && !small && <p class="tool-card__tagline">{tagline}</p>}
      </div>
    </header>

    {!small && description && (
      <p class="tool-card__desc">{description}</p>
    )}

    {!small && annotation && (
      <p class="tool-card__annotation">
        <span class="tool-card__annotation-label">·</span> {annotation}
      </p>
    )}

    {!small && tags.length > 0 && (
      <ul class="tool-card__tags" role="list">
        {tags.slice(0, 4).map(tag => <li class="tool-card__tag">{tag}</li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .tool-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 0.875rem;
    background: var(--fx-card-bg);
    border: 1px solid var(--fx-card-border);
    box-shadow: var(--fx-card-shadow);
    transition: border-color 150ms ease, transform 150ms ease, box-shadow 150ms ease;
  }
  .tool-card:hover {
    border-color: var(--fx-card-border-hover);
    box-shadow: var(--fx-card-shadow-hover);
    transform: translateY(-2px);
  }

  .tool-card__media {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface);
  }
  .tool-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 350ms ease;
  }
  .tool-card:hover .tool-card__media img {
    transform: scale(1.04);
  }

  .tool-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.125rem 1.125rem;
    flex: 1;
  }

  .tool-card__head {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }
  .tool-card__favicon {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 0.25rem;
    flex: 0 0 auto;
    margin-top: 0.125rem;
    background: var(--color-surface);
    object-fit: contain;
  }
  .tool-card__head-text {
    min-width: 0;
    flex: 1;
  }
  .tool-card__name {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3125rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: color 150ms ease;
  }
  a.tool-card__name:hover { color: var(--color-primary); }
  .tool-card__ext {
    font-size: 0.6875em;
    color: var(--color-text-muted);
    transition: color 150ms ease;
  }
  a.tool-card__name:hover .tool-card__ext { color: var(--color-primary); }
  .tool-card__tagline {
    margin: 0.1875rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.35;
  }

  .tool-card__desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tool-card__annotation {
    margin: 0;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--color-primary) 6%, transparent);
    border-left: 2px solid var(--color-primary);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-text);
    font-style: italic;
  }
  .tool-card__annotation-label {
    color: var(--color-primary);
    font-weight: 700;
    font-style: normal;
    margin-right: 0.0625rem;
  }

  .tool-card__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
  }
  .tool-card__tag {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    padding: 0.1875rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }

  /* Small variant — compact, no media/desc/tags. Used in dense grids. */
  .tool-card--small .tool-card__body {
    padding: 0.75rem 0.875rem;
    gap: 0.25rem;
  }
  .tool-card--small .tool-card__name { font-size: 0.9375rem; }
</style>
