---
/**
 * Section__OfferOrAsk — two columns of questions with a "we just connect" rail
 * down the middle. Frames the Dojo as a conduit of participation, not a
 * lecture series.
 *
 * Sized for the Reveal slide canvas. Reads Tier-2 semantic tokens, mode-aware.
 */

interface Side {
  eyebrowTxt: string;
  headingTxt: string;
  questions: string[];
}

interface Props {
  pageEyebrowTxt?: string;
  pageHeadingTxt?: string;
  offer: Side;
  ask: Side;
  /** Center-rail label. Default: "↔ peer learning". */
  conduitTxt?: string;
  /** Center-rail subtext. */
  conduitSubTxt?: string;
}

const {
  pageEyebrowTxt,
  pageHeadingTxt,
  offer,
  ask,
  conduitTxt = '↔ peer learning',
  conduitSubTxt = 'We just facilitate the exchange.',
} = Astro.props;
---

<section class="ooa">
  {(pageEyebrowTxt || pageHeadingTxt) && (
    <header class="ooa__header">
      {pageEyebrowTxt && <p class="ooa__page-eyebrow">{pageEyebrowTxt}</p>}
      {pageHeadingTxt && <h2 class="ooa__page-heading">{pageHeadingTxt}</h2>}
    </header>
  )}

  <div class="ooa__grid">
    <div class="ooa__col ooa__col--offer">
      <p class="ooa__col-eyebrow">{offer.eyebrowTxt}</p>
      <h3 class="ooa__col-heading">{offer.headingTxt}</h3>
      <ul class="ooa__list">
        {offer.questions.map((q) => <li>{q}</li>)}
      </ul>
    </div>

    <div class="ooa__rail" aria-hidden="true">
      <span class="ooa__rail-line"></span>
      <span class="ooa__rail-badge">
        <span class="ooa__rail-label">{conduitTxt}</span>
        {conduitSubTxt && <span class="ooa__rail-sub">{conduitSubTxt}</span>}
      </span>
      <span class="ooa__rail-line"></span>
    </div>

    <div class="ooa__col ooa__col--ask">
      <p class="ooa__col-eyebrow">{ask.eyebrowTxt}</p>
      <h3 class="ooa__col-heading">{ask.headingTxt}</h3>
      <ul class="ooa__list">
        {ask.questions.map((q) => <li>{q}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .ooa {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    width: 100%;
    max-width: 88rem;
    margin: 0 auto;
  }

  .ooa__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
  }
  .ooa__page-eyebrow {
    margin: 0;
    font-family: var(--font-code);
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
  }
  .ooa__page-heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 3rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .ooa__grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  .ooa__col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem 1.75rem;
    border-radius: 0.875rem;
    background: var(--fx-card-bg);
    border: 1px solid var(--fx-card-border);
    box-shadow: var(--fx-card-shadow);
  }
  .ooa__col--ask {
    border-color: color-mix(in srgb, var(--color-primary) 50%, var(--fx-card-border));
  }

  .ooa__col-eyebrow {
    margin: 0;
    font-family: var(--font-code);
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
  }
  .ooa__col-heading {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .ooa__col--ask .ooa__col-heading { color: var(--color-primary); }

  .ooa__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .ooa__list li {
    font-family: var(--font-body);
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--color-text);
    padding-left: 1rem;
    border-left: 2px solid var(--color-border);
  }
  .ooa__col--ask .ooa__list li {
    border-left-color: color-mix(in srgb, var(--color-primary) 60%, transparent);
  }

  /* Center rail: a thin vertical line with a circular badge in the middle.
     The badge sits on top of the line and reads horizontally so the text is
     legible without rotation. */
  .ooa__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 8rem;
    padding: 0 0.5rem;
  }
  .ooa__rail-line {
    flex: 1 0 auto;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-border) 20%,
      var(--color-border) 80%,
      transparent
    );
    min-height: 2rem;
  }
  .ooa__rail-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-primary);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primary) 8%, transparent);
    text-align: center;
    flex: 0 0 auto;
  }
  .ooa__rail-label {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .ooa__rail-sub {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    max-width: 8rem;
    line-height: 1.3;
  }
</style>
