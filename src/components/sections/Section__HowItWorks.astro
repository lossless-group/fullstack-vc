---
/* Section__HowItWorks
   Below-hero explainer for the home page. Frames the Dojo against the
   Kauffman Fellowship + Special Interest Groups (wisdom & network →
   contextual knowledge), and positions FullStack VC as the procedural-skill
   counterpart. Renders a three-tier relationship diagram
   (Dojo → All Hands ‖ Working Groups → Projects).

   Container width matches the hero (max-w-4xl) so the home page reads as a
   single column. The wider Dojo-components breakdown lives in
   Section__DojoComponents and ships on /about.

   Pure semantic tokens. Mode-aware. One optional prop:
     - hideMore: suppresses the "Learn more about the Dojo →" footer link
       (use on /about, where the link would self-reference). */

export interface Props {
  hideMore?: boolean;
}

const { hideMore = false } = Astro.props;
---

<section class="hiw" aria-labelledby="hiw-heading">
  <header class="hiw__header">
    <p class="hiw__eyebrow">How the Dojo works</p>
    <h2 id="hiw-heading" class="hiw__heading">
      Wisdom and network + <span class="hiw__heading-accent">a deliberate tech stack and AI mastery</span> can make you a <span class="hiw__heading-accent"> FullStack VC</span>
    </h2>
    <div class="hiw__intro">
      <p>
        The <strong>Kauffman Fellowship</strong> — and its alumni <strong>Special Interest Groups</strong> —
        offer value that is treasured in venture: <em>contextual</em> knowledge:
        pattern recognition, relationships, exposure to deals and ideas across an unmatched network.
        Wisdom and acces are paramount in venture. Vital, and not going anywhere.
      </p>
      <p>
        But the new VC operating environment creates an opportunity to be amplified by an updated <em>procedural</em> craft — using the rich features of myriad apps. 
      </p>
      <p>
        <strong>Now add AI:</strong> writing the prompts, wiring the agents, managing the context, artifacts and output; querying the data, hooking data up so it appears where it needs to be at the moment it needs to be.... 
        
        Superpowers can now be harnessed to streamline the neverending, overwhelming workflow that is venture. Turning scattered signal into
        a partner-meeting-ready memo, making better decisions, multiplying deal scouting efforts, assuring ambient awareness of portfolio activity, auto-updating materials for LP outreach, and more.  
        <br><br>
        Procedural knowledge emerges from doing - greasy elbows and calloused hands, not just heads and handshakes. It's a different muscle,
        learned by doing alongside peers who are also doing.
      </p>
      <p class="hiw__intro-pop">
        <strong>Dojos</strong> are a deliberate alteration of the SIG format for members of the Kauffman + adjacent VC community come to
        practice that craft together. It's <em>complementary</em> with the Fellowship, Society, and Network SIG activity. 
      </p>
    </div>
  </header>

  <!-- Hierarchy diagram: Dojo → All Hands → (Working Groups → Projects) -->
  <div class="hiw__diagram" role="img" aria-label="Hierarchy: the Dojo orchestrates All Hands; All Hands is the parent of both Working Groups and Projects; Working Groups choose and run Projects.">
    <!-- Tier 1: Dojo -->
    <div class="hiw__tier hiw__tier--top">
      <div class="hiw__node hiw__node--dojo">
        <p class="hiw__node-label">Dojo</p>
        <p class="hiw__node-sub">FullStack VC · community of practice</p>
      </div>
    </div>

    <!-- Tier 2: All Hands (alone, parent of WG + Projects) -->
    <div class="hiw__tier hiw__tier--mid">
      <div class="hiw__node hiw__node--all-hands">
        <p class="hiw__node-label">All Hands</p>
        <p class="hiw__node-sub">Monthly · everyone welcome</p>
      </div>
    </div>

    <!-- Tier 3: Working Groups → Projects (siblings, with arrow showing flow) -->
    <div class="hiw__tier hiw__tier--bot">
      <div class="hiw__node hiw__node--working-groups">
        <p class="hiw__node-label">Working Groups</p>
        <p class="hiw__node-sub">Theme-based · member-led</p>
      </div>

      <div class="hiw__arrow" aria-hidden="true">
        <svg viewBox="0 0 80 16" preserveAspectRatio="none" focusable="false">
          <line x1="0" y1="8" x2="68" y2="8" stroke="currentColor" stroke-width="2" />
          <polygon points="68,2 80,8 68,14" fill="currentColor" />
        </svg>
      </div>

      <div class="hiw__node hiw__node--projects">
        <p class="hiw__node-label">Projects</p>
        <p class="hiw__node-sub">Concrete work · many-to-many</p>
      </div>
    </div>
  </div>

  {!hideMore && (
    <p class="hiw__more">
      <a class="hiw__more-link" href="/about">Learn more about the Dojo <span aria-hidden="true">→</span></a>
    </p>
  )}
</section>

<style>
  .hiw {
    /* 56rem = max-w-4xl, matches the hero's column on /index.astro so margins
       stay uniform down the home page. The wider Dojo-components breakdown
       lives in Section__DojoComponents and ships on /about. */
    max-width: 56rem;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) 1.5rem clamp(4rem, 8vw, 6rem);
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  /* ---------- Header ---------- */
  .hiw__header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 52rem;
  }
  .hiw__eyebrow {
    margin: 0;
    font-family: var(--font-code);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
  }
  .hiw__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-text);
  }
  .hiw__heading-accent {
    background: var(--fx-headline-gradient, none);
    -webkit-background-clip: text;
            background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--color-primary);
  }
  .hiw__intro {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .hiw__intro p {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text);
  }
  .hiw__intro strong {
    color: var(--color-text);
    font-weight: 600;
  }
  .hiw__intro em {
    color: var(--color-primary);
    font-style: italic;
    font-weight: 700;
  }
  :global([data-mode="light"]) .hiw__intro em {
    color: #5b21b6;
  }
  :global([data-mode="dark"]) .hiw__intro em {
    color: #c4b5fd;
  }
  :global([data-mode="vibrant"]) .hiw__intro em {
    color: #caff5c;
  }
  .hiw__intro-pop {
    padding-top: 0.5rem;
    border-top: 1px dashed var(--color-border);
    color: var(--color-text);
  }

  /* ---------- Hierarchy diagram ---------- */
  .hiw__diagram {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;            /* tier spacing controlled by per-tier padding + connectors */
    padding: 2.5rem 1.5rem;
    border-radius: 1rem;
    background: var(--fx-card-bg);
    border: 1px solid var(--fx-card-border);
    box-shadow: var(--fx-card-shadow);
  }
  .hiw__tier {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    width: 100%;
    position: relative;
  }
  /* Tier vertical spacing — the trailing padding leaves room for the connector. */
  .hiw__tier--top { padding-bottom: 2rem; }
  .hiw__tier--mid { padding-bottom: 2rem; }
  .hiw__tier--bot { padding-top: 0; }

  /* ---- Connector lines ---- */
  /* Tier 1 → Tier 2: single vertical line down from Dojo to All Hands. */
  .hiw__tier--top::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.5rem;
    width: 2px;
    height: 1.5rem;
    background: var(--color-primary);
    opacity: 0.55;
    transform: translateX(-50%);
  }
  /* Tier 2 → Tier 3: vertical drop from All Hands, then horizontal branch
     reaching the centers of Working Groups (left) and Projects (right). */
  .hiw__tier--mid::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 2px;
    height: 1rem;
    background: var(--color-primary);
    opacity: 0.55;
    transform: translateX(-50%);
  }
  .hiw__tier--bot::before {
    content: '';
    position: absolute;
    top: -1rem;
    left: 25%;
    right: 25%;
    height: 2px;
    background: var(--color-primary);
    opacity: 0.55;
  }
  /* Drop-down stubs from the horizontal branch to each child node. */
  .hiw__tier--bot .hiw__node--working-groups::before,
  .hiw__tier--bot .hiw__node--projects::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -1rem;
    width: 2px;
    height: 1rem;
    background: var(--color-primary);
    opacity: 0.55;
    transform: translateX(-50%);
  }

  /* Tier nodes (cards) */
  .hiw__node {
    flex: 0 1 auto;
    min-width: 14rem;
    max-width: 22rem;
    padding: 1.125rem 1.5rem;
    border-radius: 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    text-align: center;
    transition: border-color 150ms ease, box-shadow 150ms ease;
    position: relative;
  }
  .hiw__node:hover {
    border-color: var(--fx-card-border-hover);
    box-shadow: var(--fx-card-shadow-hover);
  }
  .hiw__node--dojo {
    border: 1px solid var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 8%, var(--color-surface));
    max-width: 32rem;
  }
  .hiw__node--all-hands { max-width: 26rem; }
  .hiw__node--working-groups { max-width: 18rem; }
  .hiw__node--projects { max-width: 18rem; }

  .hiw__node-label {
    margin: 0 0 0.375rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }
  .hiw__node--dojo .hiw__node-label {
    font-size: 1.375rem;
    color: var(--color-primary);
  }
  .hiw__node-sub {
    margin: 0;
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  /* ---- Arrow connector: Working Groups → Projects ---- */
  .hiw__arrow {
    flex: 0 0 auto;
    width: 4rem;
    height: 1rem;
    color: var(--color-primary);
    opacity: 0.85;
    align-self: center;
  }
  .hiw__arrow svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Mobile: stack Tier 3 vertically; rotate arrow + swap horizontal branch
     for a single vertical line from All Hands. */
  @media (max-width: 640px) {
    .hiw__tier--bot {
      flex-direction: column;
      gap: 1rem;
    }
    /* Hide the horizontal branch + the per-node drop stubs in stacked mode;
       the existing vertical drop from All Hands suffices. */
    .hiw__tier--bot::before { display: none; }
    .hiw__tier--bot .hiw__node--working-groups::before,
    .hiw__tier--bot .hiw__node--projects::before { display: none; }

    /* Arrow becomes a downward connector between WG and Projects. */
    .hiw__arrow {
      width: 1rem;
      height: 2rem;
      transform: rotate(90deg);
    }
  }

  /* ---------- "Learn more" link to /about ---------- */
  .hiw__more {
    margin: 0;
    text-align: center;
  }
  .hiw__more-link {
    font-family: var(--font-code);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-primary);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .hiw__more-link:hover {
    color: var(--color-text);
  }
</style>

