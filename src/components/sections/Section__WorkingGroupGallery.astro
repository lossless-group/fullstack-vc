---
/* Section__WorkingGroupGallery
   Sibling to Section__ProjectGallery — same visual variants and CSS, but the
   data shape is enriched: each entry carries the WorkingGroupEntry plus its
   currently-active projects (pre-joined by the loader). The portfolio /
   mission-brief / lite variant cards add a small chip row showing 1–3 of the
   WG's active projects, which is the headline differentiator vs. project cards.

   Variants:
     - 'portfolio'      — Banner thumbnail + title + lede + leads + tag chips + active-projects chip row.
     - 'mission-brief'  — Number badge + eyebrow + paragraph + cadence/status footer + active-projects chip row.
     - 'lite'           — Compact card, no thumbnail, "join" CTA. For proposed.
     - 'shelf'          — Horizontal list rows. For archived.

   Reads only Tier-2 semantic tokens. Empty list + emptyHide → renders nothing. */

import type { WorkingGroupWithProjects } from '../../lib/load-working-groups';
import { workingGroupHref, workingGroupSlug, statusLabel } from '../../lib/load-working-groups';
import GetInvolvedScale from '../forms/Span__GetInvolvedOptionScale--IconRow.astro';

export type GalleryVariant = 'portfolio' | 'mission-brief' | 'lite' | 'shelf';

export interface Props {
  contextSetterTxt?: string;
  headingTxt?: string;
  introTxt?: string;
  entries: WorkingGroupWithProjects[];   // each is { wg, currentProjects }
  variant?: GalleryVariant;
  emptyHide?: boolean;
}

const {
  contextSetterTxt,
  headingTxt,
  introTxt,
  entries,
  variant = 'portfolio',
  emptyHide = true,
} = Astro.props;

const fmtDate = (d?: Date) =>
  d ? d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' }) : '';
---

{(!emptyHide || entries.length > 0) && (
  <section class={`pgallery pgallery--${variant}`}>
    <header class="pgallery__header">
      {contextSetterTxt && <p class="pgallery__eyebrow">{contextSetterTxt}</p>}
      {headingTxt && <h2 class="pgallery__heading">{headingTxt}</h2>}
      {introTxt && <p class="pgallery__intro">{introTxt}</p>}
    </header>

    {variant === 'portfolio' && (
      <ol class="pgallery__grid pgallery__grid--portfolio">
        {entries.map(({ wg, currentProjects }) => (
          <li class="pcard pcard--portfolio">
            <a class="pcard__hit" href={workingGroupHref(wg)}>
              <div class="pcard__banner" aria-hidden="true">
                {wg.data.thumbnail
                  ? <img class="pcard__banner-img" src={wg.data.thumbnail} alt="" loading="lazy" />
                  : wg.data.hero_image
                    ? <img class="pcard__banner-img" src={wg.data.hero_image} alt="" loading="lazy" />
                    : <div class="pcard__banner-fallback"><span class="pcard__icon">{wg.data.icon ?? '◆'}</span></div>
                }
                <span class="pcard__status" data-status={wg.data.status}>
                  <span class="sr-only">Status: </span>{statusLabel(wg.data.status)}
                </span>
              </div>
              <div class="pcard__body">
                <h3 class="pcard__title">{wg.data.title}</h3>
                <p class="pcard__lede">{wg.data.lede}</p>
                {wg.data.working_group_leads && wg.data.working_group_leads.length > 0 && (
                  <p class="pcard__leads">
                    {wg.data.working_group_leads.map(l => l.name).join(' · ')}
                  </p>
                )}
                {currentProjects.length > 0 && (
                  <p class="pcard__projects">
                    <span class="pcard__projects-label">Active projects · </span>
                    {currentProjects.slice(0, 3).map((p, i) => (
                      <>
                        {i > 0 && <span class="pcard__projects-sep"> · </span>}
                        <span class="pcard__projects-name">{p.data.title}</span>
                      </>
                    ))}
                    {currentProjects.length > 3 && <span class="pcard__projects-more"> +{currentProjects.length - 3}</span>}
                  </p>
                )}
                {wg.data.tags && wg.data.tags.length > 0 && (
                  <ul class="pcard__tags">
                    {wg.data.tags.slice(0, 3).map(t => <li>{t}</li>)}
                  </ul>
                )}
              </div>
            </a>
            <div class="pcard__actions">
              <GetInvolvedScale
                entityKind="working-group"
                entitySlug={workingGroupSlug(wg)}
                entityTitleTxt={wg.data.title}
                size="md"
              />
            </div>
          </li>
        ))}
      </ol>
    )}

    {variant === 'mission-brief' && (
      <ol class="pgallery__grid pgallery__grid--mission">
        {entries.map(({ wg, currentProjects }, i) => (
          <li class="pcard pcard--mission">
            <a class="pcard__hit" href={workingGroupHref(wg)}>
              <div class="pcard__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
              <p class="pcard__brief-eyebrow">{wg.data.category ?? wg.data.working_group_name ?? 'Working Group'}</p>
              <h3 class="pcard__title">{wg.data.title}</h3>
              <p class="pcard__brief-body">{wg.data.summary ?? wg.data.lede}</p>
              {currentProjects.length > 0 && (
                <p class="pcard__projects">
                  <span class="pcard__projects-label">Active · </span>
                  {currentProjects.slice(0, 3).map(p => p.data.title).join(' · ')}
                </p>
              )}
              <div class="pcard__brief-foot">
                {wg.data.cadence && <span class="pcard__cadence">{wg.data.cadence}</span>}
                <span class="pcard__status pcard__status--inline" data-status={wg.data.status}>
                  <span class="sr-only">Status: </span>{statusLabel(wg.data.status)}
                </span>
              </div>
            </a>
            <div class="pcard__actions">
              <GetInvolvedScale
                entityKind="working-group"
                entitySlug={workingGroupSlug(wg)}
                entityTitleTxt={wg.data.title}
                size="md"
              />
            </div>
          </li>
        ))}
      </ol>
    )}

    {variant === 'lite' && (
      <ol class="pgallery__grid pgallery__grid--lite">
        {entries.map(({ wg }) => (
          <li class="pcard pcard--lite">
            <a class="pcard__hit" href={workingGroupHref(wg)}>
              <div class="pcard__lite-head">
                <span class="pcard__icon" aria-hidden="true">{wg.data.icon ?? '◇'}</span>
                <h3 class="pcard__title">{wg.data.title}</h3>
              </div>
              <p class="pcard__lede">{wg.data.lede}</p>
              <span class="pcard__cta">Join the working group →</span>
            </a>
            <div class="pcard__actions pcard__actions--lite">
              <GetInvolvedScale
                entityKind="working-group"
                entitySlug={workingGroupSlug(wg)}
                entityTitleTxt={wg.data.title}
                size="sm"
              />
            </div>
          </li>
        ))}
      </ol>
    )}

    {variant === 'shelf' && (
      <ol class="pgallery__shelf">
        {entries.map(({ wg }) => (
          <li class="pcard pcard--shelf">
            <a class="pcard__hit pcard__hit--row" href={workingGroupHref(wg)}>
              <span class="pcard__shelf-icon" aria-hidden="true">{wg.data.icon ?? '◯'}</span>
              <div class="pcard__shelf-text">
                <h3 class="pcard__title pcard__title--shelf">{wg.data.title}</h3>
                <p class="pcard__lede pcard__lede--shelf">{wg.data.lede}</p>
              </div>
              <div class="pcard__shelf-meta">
                {wg.data.date_initiated && (
                  <span class="pcard__shelf-date">
                    <abbr title="Initiated">init</abbr> {fmtDate(wg.data.date_initiated)}
                  </span>
                )}
                {wg.data.date_archived && (
                  <span class="pcard__shelf-date">
                    <abbr title="Archived">arch</abbr> {fmtDate(wg.data.date_archived)}
                  </span>
                )}
                <span class="pcard__status pcard__status--inline" data-status={wg.data.status}>
                  <span class="sr-only">Status: </span>{statusLabel(wg.data.status)}
                </span>
              </div>
            </a>
          </li>
        ))}
      </ol>
    )}
  </section>
)}

<style>
  .pgallery {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .pgallery__header {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    max-width: 64ch;
  }
  .pgallery__eyebrow {
    margin: 0;
    font-family: var(--font-code);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
  }
  .pgallery__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.625rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .pgallery__intro {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* ---------- Grids ---------- */
  .pgallery__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .pgallery__grid--portfolio {
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .pgallery__grid--portfolio { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1100px) {
    .pgallery__grid--portfolio { grid-template-columns: repeat(3, 1fr); }
  }
  .pgallery__grid--mission {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .pgallery__grid--mission { grid-template-columns: 1fr 1fr; }
  }
  .pgallery__grid--lite {
    grid-template-columns: 1fr;
    gap: 0.875rem;
  }
  @media (min-width: 720px) {
    .pgallery__grid--lite { grid-template-columns: 1fr 1fr 1fr; }
  }

  .pgallery__shelf {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
  }

  /* ---------- Card base ---------- */
  .pcard {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pcard__hit {
    display: block;
    color: inherit;
    text-decoration: none;
    flex: 1 1 auto;
    border-radius: 0.875rem;
    background: var(--fx-card-bg);
    border: 1px solid var(--fx-card-border);
    box-shadow: var(--fx-card-shadow);
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
    overflow: hidden;
  }
  .pcard__actions {
    display: flex;
    justify-content: flex-end;
    flex: 0 0 auto;
  }
  .pcard__actions--lite { justify-content: flex-start; }
  .pcard__hit:hover,
  .pcard__hit:focus-visible {
    border-color: var(--fx-card-border-hover);
    box-shadow: var(--fx-card-shadow-hover);
    transform: translateY(-2px);
    outline: none;
  }
  .pcard__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.01em;
    line-height: 1.25;
  }
  .pcard__lede {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.55;
    font-size: 0.9375rem;
  }

  /* ---------- Status badge ---------- */
  .pcard__status {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: color-mix(in srgb, var(--color-background) 80%, transparent);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .pcard__status::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--badge-color, var(--color-text-muted));
    box-shadow: 0 0 8px var(--badge-color, transparent);
  }
  .pcard__status[data-status="active"]   { --badge-color: var(--color-status-active); }
  .pcard__status[data-status="proposed"] { --badge-color: var(--color-status-proposed); }
  .pcard__status[data-status="archived"] { --badge-color: var(--color-status-archived); }

  .pcard__status--inline {
    position: static;
    background: transparent;
    border: none;
    backdrop-filter: none;
    padding: 0;
    color: var(--color-text-muted);
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Variant: portfolio ---------- */
  .pcard--portfolio .pcard__banner {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .pcard__banner-img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }
  .pcard__banner-fallback {
    width: 100%; height: 100%;
    display: grid; place-items: center;
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--color-primary) 18%, var(--color-surface)),
      color-mix(in srgb, var(--color-secondary) 12%, var(--color-surface)));
  }
  .pcard__icon {
    font-size: 2.5rem;
    line-height: 1;
    filter: drop-shadow(0 2px 6px color-mix(in srgb, var(--color-primary) 30%, transparent));
  }
  .pcard--portfolio .pcard__body {
    padding: 1.125rem 1.125rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pcard__leads {
    margin: 0.25rem 0 0;
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .pcard__tags {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .pcard__tags li {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    padding: 0.1875rem 0.5rem;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--color-primary) 8%, var(--color-surface));
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }

  /* Active-projects chip row — the headline differentiator vs project cards */
  .pcard__projects {
    margin: 0.375rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-text);
  }
  .pcard__projects-label {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
  }
  .pcard__projects-name {
    color: var(--color-primary);
    font-weight: 500;
  }
  .pcard__projects-sep {
    color: var(--color-text-muted);
  }
  .pcard__projects-more {
    color: var(--color-text-muted);
    font-family: var(--font-code);
    font-size: 0.75rem;
  }

  /* ---------- Variant: mission-brief ---------- */
  .pcard--mission .pcard__hit {
    padding: 1.5rem 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    position: relative;
  }
  .pcard__num {
    font-family: var(--font-code);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
    color: var(--color-primary);
    opacity: 0.85;
    letter-spacing: -0.04em;
  }
  .pcard__brief-eyebrow {
    margin: 0;
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
  }
  .pcard__brief-body {
    margin: 0;
    color: var(--color-text);
    line-height: 1.55;
    font-size: 0.9375rem;
  }
  .pcard__brief-foot {
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
  .pcard__cadence { line-height: 1.3; }

  /* ---------- Variant: lite ---------- */
  .pcard--lite .pcard__hit {
    padding: 1.125rem 1.125rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    border-style: dashed;
  }
  .pcard__lite-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pcard__lite-head .pcard__icon {
    font-size: 1.25rem;
    filter: none;
  }
  .pcard__cta {
    margin-top: auto;
    font-family: var(--font-code);
    font-size: 0.8125rem;
    color: var(--color-primary);
  }

  /* ---------- Variant: shelf ---------- */
  .pcard--shelf .pcard__hit {
    border-radius: 0;
    border: none;
    border-bottom: 1px solid var(--color-border);
    background: transparent;
    box-shadow: none;
    padding: 0.875rem 0.5rem;
    transform: none;
  }
  .pcard--shelf .pcard__hit:hover,
  .pcard--shelf .pcard__hit:focus-visible {
    background: var(--color-surface);
    border-color: var(--color-border);
    transform: none;
    box-shadow: none;
  }
  .pcard__hit--row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
  }
  .pcard__shelf-icon {
    font-size: 1.5rem;
    line-height: 1;
    width: 2rem;
    text-align: center;
    color: var(--color-text-muted);
  }
  .pcard__title--shelf {
    font-size: 1rem;
    margin-bottom: 0.125rem;
  }
  .pcard__lede--shelf {
    font-size: 0.875rem;
  }
  .pcard__shelf-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-align: right;
    min-width: 9rem;
  }
  .pcard__shelf-meta abbr {
    color: var(--color-primary);
    text-decoration: none;
    margin-right: 0.25rem;
  }
  @media (max-width: 640px) {
    .pcard__hit--row {
      grid-template-columns: auto 1fr;
    }
    .pcard__shelf-meta {
      grid-column: 2;
      align-items: flex-start;
      flex-direction: row;
      flex-wrap: wrap;
      min-width: 0;
      text-align: left;
    }
  }
</style>
