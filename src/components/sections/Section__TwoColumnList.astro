---
/**
 * Section__TwoColumnList — two parallel lists side-by-side with an optional
 * page heading above and a shared "rule" line below. Designed for thesis /
 * principle slides where two columns are equally weighted (no left vs. right
 * hierarchy). Sized for the Reveal slide canvas; reads Tier-2 semantic tokens.
 */

interface Side {
  headingTxt: string;
  items: string[];
  /** Render items in mono font (code/format/file-type style). Default false. */
  monoItems?: boolean;
}

interface Props {
  pageEyebrowTxt?: string;
  pageHeadingTxt?: string;
  left: Side;
  right: Side;
  /** Single-line takeaway rendered as a centered call-out below the columns. */
  footerTxt?: string;
}

const {
  pageEyebrowTxt,
  pageHeadingTxt,
  left,
  right,
  footerTxt,
} = Astro.props;
---

<section class="tcl">
  {(pageEyebrowTxt || pageHeadingTxt) && (
    <header class="tcl__header">
      {pageEyebrowTxt && <p class="tcl__page-eyebrow">{pageEyebrowTxt}</p>}
      {pageHeadingTxt && <h2 class="tcl__page-heading">{pageHeadingTxt}</h2>}
    </header>
  )}

  <div class="tcl__grid">
    <div class="tcl__col">
      <h3 class="tcl__col-heading">{left.headingTxt}</h3>
      <ul class={`tcl__list${left.monoItems ? ' tcl__list--mono' : ''}`}>
        {left.items.map((it) => <li>{it}</li>)}
      </ul>
    </div>

    <div class="tcl__col">
      <h3 class="tcl__col-heading">{right.headingTxt}</h3>
      <ul class={`tcl__list${right.monoItems ? ' tcl__list--mono' : ''}`}>
        {right.items.map((it) => <li>{it}</li>)}
      </ul>
    </div>
  </div>

  {footerTxt && (
    <p class="tcl__footer">{footerTxt}</p>
  )}
</section>

<style>
  .tcl {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    max-width: 88rem;
    margin: 0 auto;
  }

  .tcl__header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
  }
  .tcl__page-eyebrow {
    margin: 0;
    font-family: var(--font-code);
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
  }
  .tcl__page-heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 3rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .tcl__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .tcl__col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem 2rem;
    border-radius: 0.875rem;
    background: var(--fx-card-bg);
    border: 1px solid var(--fx-card-border);
    box-shadow: var(--fx-card-shadow);
  }
  .tcl__col-heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2.75rem;
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-primary);
  }

  .tcl__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .tcl__list li {
    font-family: var(--font-body);
    font-size: 1.5rem;
    line-height: 1.35;
    color: var(--color-text);
    padding-left: 1rem;
    border-left: 3px solid var(--color-primary);
  }
  .tcl__list--mono li {
    font-family: var(--font-code);
    font-size: 1.375rem;
    letter-spacing: -0.01em;
  }

  .tcl__footer {
    margin: 0.5rem auto 0;
    padding: 0.875rem 1.5rem;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    text-align: center;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text);
    max-width: 60rem;
  }
</style>
