---
import type { BreakoutSession } from '../../data/breakouts/from-yes-to-win';

export interface Props {
  data: BreakoutSession;
  /** URL slug under /breakouts/ for the index page. Defaults to data.parent. */
  basePath?: string;
}

const { data, basePath } = Astro.props;
const root = `/breakouts/${basePath ?? data.parent}`;
---

<section class="breakouts-teaser" aria-labelledby="breakouts-teaser-heading">
  <header class="breakouts-teaser__header">
    <p class="breakouts-teaser__eyebrow">Breakouts</p>
    <h2 id="breakouts-teaser-heading" class="breakouts-teaser__title">
      {data.title}
    </h2>
    <p class="breakouts-teaser__lede">{data.lede}</p>
    <p class="breakouts-teaser__entry-state">{data.entryState}</p>
  </header>

  <div class="breakouts-teaser__grid">
    {data.tracks.map((track) => (
      <a class="breakouts-teaser__card" href={`${root}/${track.slug}`}>
        <div class="breakouts-teaser__card-eyebrow">{track.shortName}</div>
        <div class="breakouts-teaser__card-title">{track.title}</div>
        <div class="breakouts-teaser__card-hook">"{track.hook}"</div>
        <div class="breakouts-teaser__card-reality">{track.reality}</div>
        <div class="breakouts-teaser__card-cta">
          Open track <span aria-hidden="true">→</span>
        </div>
      </a>
    ))}
  </div>

  <footer class="breakouts-teaser__footer">
    <a href={root} class="breakouts-teaser__all-link">
      See all questions, the one-pager artifact, and the host script
      <span aria-hidden="true">→</span>
    </a>
  </footer>
</section>

<style>
  .breakouts-teaser {
    margin: 3rem 0 0;
    padding: 2rem 0 0;
    border-top: 1px solid var(--color-border);
  }

  .breakouts-teaser__header {
    margin-bottom: 2rem;
  }
  .breakouts-teaser__eyebrow {
    font-family: var(--font-code);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-accent);
    margin: 0 0 0.75rem;
  }
  .breakouts-teaser__title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.75rem;
    line-height: 1.15;
  }
  .breakouts-teaser__lede {
    font-size: 1.0625rem;
    color: var(--color-text);
    margin: 0 0 0.75rem;
    line-height: 1.5;
  }
  .breakouts-teaser__entry-state {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
    font-style: italic;
  }

  .breakouts-teaser__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 768px) {
    .breakouts-teaser__grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .breakouts-teaser__card {
    display: block;
    padding: 1.25rem 1.25rem 1rem;
    background: var(--fx-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .breakouts-teaser__card,
  .breakouts-teaser__card * {
    text-decoration: none;
  }
  .breakouts-teaser__card-cta {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .breakouts-teaser__card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }
  .breakouts-teaser__card-eyebrow {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }
  .breakouts-teaser__card-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.625rem;
    line-height: 1.2;
  }
  .breakouts-teaser__card-hook {
    font-size: 0.875rem;
    font-style: italic;
    color: var(--color-text);
    margin-bottom: 0.625rem;
    line-height: 1.4;
  }
  .breakouts-teaser__card-reality {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: 0.875rem;
    line-height: 1.45;
  }
  .breakouts-teaser__card-cta {
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .breakouts-teaser__footer {
    padding-top: 0.5rem;
  }
  .breakouts-teaser__all-link {
    font-family: var(--font-code);
    font-size: 0.875rem;
    color: var(--color-primary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .breakouts-teaser__all-link:hover {
    text-decoration: underline;
  }
</style>
