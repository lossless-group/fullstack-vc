---
/* ProjectMetadataDisplay
   Below-hero metadata strip on /projects/[slug]/.
   Renders working-group leads + members, cadence, RSVP CTA, external link icons,
   and a "last activity" timestamp. Pure semantic tokens. */

import type { ProjectEntry } from '../../lib/load-projects';
import { statusLabel } from '../../lib/load-projects';
import { resolvePeople } from '../../lib/resolve-people';
import PersonCardBare from '../people/PersonCard--Bare.astro';

export interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const d = project.data;

// Resolve leads against the participants collection so registered members
// (mpstaton, etc.) auto-pick up their avatar/firm/profile without each
// project file restating those values. TBD entries stay TBD.
const resolvedLeads = await resolvePeople(d.working_group_leads);
// Show a placeholder lead card on proposed projects with no roster yet.
const leadsToRender =
  resolvedLeads.length > 0
    ? resolvedLeads
    : d.status === 'proposed'
      ? [{ name: 'TBD', isTbd: true }]
      : [];

const fmtDate = (date?: Date) =>
  date ? date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : null;

const links = d.links ?? {};
const linkRows: { key: string; label: string; href?: string; glyph: string }[] = [
  { key: 'repo',   label: 'Repo',   href: links.repo,   glyph: '⌘' },
  { key: 'site',   label: 'Site',   href: links.site,   glyph: '◉' },
  { key: 'demo',   label: 'Demo',   href: links.demo,   glyph: '▶' },
  { key: 'figma',  label: 'Figma',  href: links.figma,  glyph: '◇' },
  { key: 'spec',   label: 'Spec',   href: links.spec,   glyph: '§' },
  { key: 'notes',  label: 'Notes',  href: links.notes,  glyph: '✎' },
];
const visibleLinks = linkRows.filter(l => !!l.href);

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map(part => part[0])
    .filter(Boolean)
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

<aside class="pmeta">
  <div class="pmeta__row pmeta__row--status">
    <span class="pmeta__status" data-status={d.status}>
      <span class="sr-only">Status: </span>{statusLabel(d.status)}
    </span>
    {d.cadence && <span class="pmeta__cadence">{d.cadence}</span>}
    {d.date_last_activity && (
      <span class="pmeta__activity">
        Last activity · <time datetime={d.date_last_activity.toISOString().slice(0, 10)}>{fmtDate(d.date_last_activity)}</time>
      </span>
    )}
  </div>

  {(leadsToRender.length || d.working_group_members?.length) && (
    <div class="pmeta__row pmeta__row--people">
      {leadsToRender.length > 0 && (
        <div class="pmeta__people">
          <p class="pmeta__people-label">Leads</p>
          <ul class="pmeta__leads" role="list">
            {leadsToRender.map(l => (
              <li>
                <PersonCardBare
                  name={l.name}
                  firm={l.firm}
                  role={l.role}
                  avatar={l.avatar}
                  profile={l.profile}
                  tbd={l.isTbd}
                />
              </li>
            ))}
          </ul>
        </div>
      )}

      {d.working_group_members?.length && (
        <div class="pmeta__people">
          <p class="pmeta__people-label">Participants</p>
          <ul class="pmeta__avatars">
            {d.working_group_members.map(m => (
              <li class="pmeta__person">
                {m.avatar
                  ? <img class="pmeta__avatar" src={m.avatar} alt="" />
                  : <span class="pmeta__avatar pmeta__avatar--initials">{initials(m.name)}</span>
                }
                <span class="pmeta__person-text">
                  <span class="pmeta__person-name">{m.name}</span>
                  {m.role && <span class="pmeta__person-role">{m.role}</span>}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )}

  {(visibleLinks.length > 0 || d.rsvp_url) && (
    <div class="pmeta__row pmeta__row--actions">
      {visibleLinks.length > 0 && (
        <ul class="pmeta__links" aria-label="External links">
          {visibleLinks.map(l => (
            <li>
              <a class="pmeta__link" href={l.href} target="_blank" rel="noopener noreferrer">
                <span class="pmeta__link-glyph" aria-hidden="true">{l.glyph}</span>
                <span>{l.label}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
      {d.rsvp_url && (
        <a class="pmeta__rsvp" href={d.rsvp_url} target="_blank" rel="noopener noreferrer">
          RSVP for next session →
        </a>
      )}
    </div>
  )}

  {d.scope && (
    <div class="pmeta__row pmeta__row--scope">
      <p class="pmeta__scope-label">Scope</p>
      <p class="pmeta__scope-text">{d.scope}</p>
    </div>
  )}
</aside>

<style>
  .pmeta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem 1.25rem 1.5rem;
    border-radius: 0.875rem;
    background: var(--fx-card-bg);
    border: 1px solid var(--fx-card-border);
    box-shadow: var(--fx-card-shadow);
  }
  .pmeta__row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }
  .pmeta__row--people {
    align-items: flex-start;
    gap: 2rem;
  }
  .pmeta__row--actions {
    justify-content: space-between;
    border-top: 1px dashed var(--color-border);
    padding-top: 1rem;
  }
  .pmeta__row--scope {
    flex-direction: column;
    align-items: flex-start;
    border-top: 1px dashed var(--color-border);
    padding-top: 1rem;
    gap: 0.375rem;
  }

  .pmeta__status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    font-family: var(--font-code);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    background: color-mix(in srgb, var(--color-primary) 8%, var(--color-surface));
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }
  .pmeta__status::before {
    content: '';
    width: 0.5rem; height: 0.5rem;
    border-radius: 999px;
    background: var(--badge-color, var(--color-text-muted));
    box-shadow: 0 0 8px var(--badge-color, transparent);
  }
  .pmeta__status[data-status="active"]   { --badge-color: var(--color-status-active); }
  .pmeta__status[data-status="proposed"] { --badge-color: var(--color-status-proposed); }
  .pmeta__status[data-status="archived"] { --badge-color: var(--color-status-archived); }

  .pmeta__cadence,
  .pmeta__activity {
    font-family: var(--font-code);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
  .pmeta__activity time { color: var(--color-text); }

  .pmeta__people-label,
  .pmeta__scope-label {
    margin: 0 0 0.5rem;
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
  }
  .pmeta__avatars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }
  /* Leads use the full PersonCard--Bare; stack vertically with a small gap
     since each card carries its own border + halo. */
  .pmeta__leads {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pmeta__person {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pmeta__avatar {
    width: 2rem; height: 2rem;
    border-radius: 999px;
    object-fit: cover;
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--color-primary) 25%, var(--color-surface)),
      color-mix(in srgb, var(--color-secondary) 18%, var(--color-surface)));
    border: 1px solid var(--color-border);
    display: grid;
    place-items: center;
    color: var(--color-text);
    font-family: var(--font-code);
    font-size: 0.6875rem;
    font-weight: 600;
    flex-shrink: 0;
  }
  .pmeta__person-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .pmeta__person-name {
    color: var(--color-text);
    font-size: 0.875rem;
    text-decoration: none;
  }
  a.pmeta__person-name:hover { color: var(--color-primary); }
  .pmeta__person-role {
    color: var(--color-text-muted);
    font-family: var(--font-code);
    font-size: 0.6875rem;
  }

  .pmeta__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pmeta__link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-family: var(--font-code);
    font-size: 0.75rem;
    text-decoration: none;
    transition: border-color 150ms ease, color 150ms ease;
  }
  .pmeta__link:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .pmeta__link-glyph { color: var(--color-primary); }

  .pmeta__rsvp {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.875rem;
    border-radius: 0.5rem;
    background: var(--color-primary);
    color: var(--color__bone);
    font-family: var(--font-code);
    font-size: 0.8125rem;
    text-decoration: none;
    box-shadow: var(--fx-card-shadow);
    transition: box-shadow 150ms ease, transform 150ms ease;
  }
  .pmeta__rsvp:hover {
    box-shadow: var(--fx-card-shadow-hover);
    transform: translateY(-1px);
  }

  .pmeta__scope-text {
    margin: 0;
    color: var(--color-text);
    line-height: 1.55;
  }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
