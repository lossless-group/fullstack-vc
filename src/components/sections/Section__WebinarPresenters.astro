---
/* Section__WebinarPresenters
   Presenter showcase used inside the webinar detail card. Wraps a list of
   PersonCard--Bare entries (the canonical person row) with a section
   header and a hosts line below. Visual chrome lives here; the row card
   lives in src/components/people/PersonCard--Bare.astro. */

import PersonCardBare from '../people/PersonCard--Bare.astro';
import { resolvePeople } from '../../lib/resolve-people';

interface Presenter {
  name: string;
  firm?: string;
  role?: string;
  headshot?: string;
  linkedin?: string;
  topic?: string;
}
interface Props {
  presenters: Presenter[];
  hosts?: string[];
}

const { presenters, hosts = [] } = Astro.props;

// Pipe presenter blocks through the resolver so anyone in the participants
// collection (e.g. mpstaton with a github_avatar) auto-fills name → avatar
// without having to paste a URL into session frontmatter.
const resolved = await resolvePeople(
  presenters.map(p => ({
    name: p.name,
    firm: p.firm,
    role: p.role,
    avatar: p.headshot,
    profile: p.linkedin,
  }))
);
const withTopics = resolved.map((r, i) => ({ ...r, topic: presenters[i].topic }));
---

<section class="wpres" aria-labelledby="wpres-heading">
  <header class="wpres__head">
    <p class="wpres__eyebrow">With</p>
    <h2 id="wpres-heading" class="wpres__heading">Speed-demo presenters</h2>
  </header>

  <ul class="wpres__list" role="list">
    {withTopics.map(p => (
      <li>
        <PersonCardBare
          name={p.name}
          firm={p.firm}
          role={p.role}
          avatar={p.avatar}
          profile={p.profile}
          topic={p.topic}
          tbd={p.isTbd}
        />
      </li>
    ))}
  </ul>

  {hosts.length > 0 && (
    <p class="wpres__hosts">
      <span class="wpres__hosts-label">Hosted by</span>
      <span class="wpres__hosts-names">{hosts.join(' & ')}</span>
    </p>
  )}
</section>

<style>
  .wpres {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0 0 1.75rem;
    padding: 1.25rem;
    border-radius: 0.75rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .wpres__head {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .wpres__eyebrow {
    margin: 0;
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }
  .wpres__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .wpres__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .wpres__hosts {
    margin: 0.25rem 0 0;
    padding-top: 0.625rem;
    border-top: 1px dashed var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
    font-size: 0.875rem;
  }
  .wpres__hosts-label {
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }
  .wpres__hosts-names {
    color: var(--color-text);
  }
</style>
