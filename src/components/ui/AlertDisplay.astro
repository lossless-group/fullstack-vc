---
/* AlertDisplay
   Inline announcement bar with a primary-tinted gradient and an "×"
   dismiss button. Sits above whatever section/page it's mounted in.
   Dismissal is per-id and per-session (sessionStorage), so the user
   never sees the same alert twice in one browsing session but does
   see it again on a future visit.

   Content can come via the default slot (HTML / nested components) or
   the `text` prop (string-only fallback). The slot wins when both are
   provided.

   Props:
     - id: stable string used as the dismiss key (required)
     - text: string fallback when no slot content is supplied
     - variant: visual tone — 'announce' (default), 'info', 'warning'
     - align: 'left' | 'center' (default 'left')

   The component is SSR-safe: it always renders the markup, then a
   small inline script hides it on hydration if dismissed. */

export interface Props {
  id: string;
  text?: string;
  variant?: 'announce' | 'info' | 'warning';
  align?: 'left' | 'center';
}

const { id, text, variant = 'announce', align = 'left' } = Astro.props;
const hasSlot = Astro.slots.has('default');
---

<aside
  class:list={['alert', `alert--${variant}`, `alert--${align}`]}
  data-alert-id={id}
  role="status"
  aria-live="polite"
>
  <div class="alert__inner">
    <div class="alert__content">
      {hasSlot ? <slot /> : text}
    </div>
    <button
      type="button"
      class="alert__dismiss"
      aria-label="Dismiss alert"
      data-alert-dismiss
    >
      <span aria-hidden="true">×</span>
    </button>
  </div>
</aside>

<script>
  function init() {
    document.querySelectorAll<HTMLElement>('[data-alert-id]').forEach((el) => {
      const id = el.dataset.alertId;
      if (!id) return;
      const key = `alert-dismissed:${id}`;
      try {
        if (sessionStorage.getItem(key) === '1') {
          el.hidden = true;
          return;
        }
      } catch {
        /* sessionStorage may be unavailable (private mode); fall through */
      }
      const btn = el.querySelector<HTMLButtonElement>('[data-alert-dismiss]');
      btn?.addEventListener('click', () => {
        try { sessionStorage.setItem(key, '1'); } catch { /* noop */ }
        el.hidden = true;
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>

<style>
  .alert {
    border-radius: 0.625rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
    color: var(--color-text);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-primary) 10%, transparent),
      var(--fx-card-shadow);
  }
  /* Variant: announce — primary→secondary gradient (the default; "pop"). */
  .alert--announce {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-primary) 14%, var(--color-surface)),
      color-mix(in srgb, var(--color-secondary, var(--color-primary)) 10%, var(--color-surface))
    );
  }
  /* Variant: info — single primary tint, lighter weight. */
  .alert--info {
    background: color-mix(in srgb, var(--color-primary) 8%, var(--color-surface));
    border-color: color-mix(in srgb, var(--color-primary) 25%, var(--color-border));
  }
  /* Variant: warning — amber tint that survives all three modes. */
  .alert--warning {
    background: color-mix(in srgb, #f59e0b 14%, var(--color-surface));
    border-color: color-mix(in srgb, #f59e0b 45%, var(--color-border));
  }

  .alert__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 0.75rem;
    padding: 0.875rem 0.875rem 0.875rem 1.125rem;
  }
  .alert--center .alert__content { text-align: center; }

  .alert__content {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text);
  }
  .alert__content :global(strong) {
    color: var(--color-primary);
    font-weight: 600;
  }
  .alert__content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .alert__content :global(a:hover) { color: var(--color-text); }

  .alert__dismiss {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.375rem;
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-text-muted);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 150ms ease, background 150ms ease, border-color 150ms ease;
    flex-shrink: 0;
  }
  .alert__dismiss:hover,
  .alert__dismiss:focus-visible {
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-primary) 12%, transparent);
    border-color: var(--color-border);
    outline: none;
  }
</style>
