---
/* JumboPopdown__More
   Sibling to JumboPopdown__WorkingGroups and JumboPopdown__Projects.
   Surfaces secondary destinations (Stacks, People) under a single "More"
   trigger. Static items — no collection backing. Conforms to
   context-v/blueprints/Jumbotron-Popdown-Patterns.md.

   Behavior — same shape as the other JumboPopdowns (copied):
     - Hover-open + click-toggle (touch-friendly).
     - Esc closes; arrow keys cycle through items inside the menu.
     - role="menu" + role="menuitem" for AT navigation.
     - Respects prefers-reduced-motion. */

export interface Props {
  triggerLabelTxt?: string;
}

const { triggerLabelTxt = 'More' } = Astro.props;

const items = [
  {
    href: '/stacks',
    icon: '▣',
    title: 'Stacks',
    desc: "Browse the community's tools — what's adopted, what's aspirational, what's been set aside.",
  },
  {
    href: '/people',
    icon: '◉',
    title: 'People',
    desc: 'Kauffman Fellows in the dojo — find by handle, firm, or by what they\'re building with.',
  },
];
---

<div class="jpop" data-jpop>
  <button
    type="button"
    class="jpop__trigger"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="jpop-more-panel"
    data-jpop-trigger
  >
    {triggerLabelTxt}
    <span class="jpop__chevron" aria-hidden="true">▾</span>
  </button>

  <div
    id="jpop-more-panel"
    class="jpop__panel"
    role="menu"
    aria-label="More"
    data-jpop-panel
    hidden
  >
    <div class="jpop__panel-inner">
      <header class="jpop__head">
        <p class="jpop__eyebrow">Community Browse</p>
        <p class="jpop__lede">More ways to navigate the dojo.</p>
      </header>

      <a class="jpop__topline" role="menuitem" href="/about">
        <span class="jpop__topline-label">About</span>
        <span class="jpop__topline-desc">Who runs the dojo, why it exists, and how to get in touch.</span>
        <span class="jpop__topline-arrow" aria-hidden="true">→</span>
      </a>

      <ul class="jpop__grid">
        {items.map(item => (
          <li>
            <a class="jpop__item" role="menuitem" href={item.href}>
              <span class="jpop__item-icon" aria-hidden="true">{item.icon}</span>
              <span class="jpop__item-text">
                <span class="jpop__item-title">{item.title}</span>
                <span class="jpop__item-desc">{item.desc}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<script>
  type Wrap = HTMLElement;

  function setOpen(wrap: Wrap, open: boolean) {
    const trigger = wrap.querySelector<HTMLButtonElement>('[data-jpop-trigger]');
    const panel = wrap.querySelector<HTMLElement>('[data-jpop-panel]');
    if (!trigger || !panel) return;
    trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    panel.hidden = !open;
    wrap.classList.toggle('is-open', open);
  }

  function isOpen(wrap: Wrap): boolean {
    return wrap.classList.contains('is-open');
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-jpop]').forEach((wrap) => {
      const trigger = wrap.querySelector<HTMLButtonElement>('[data-jpop-trigger]');
      const panel = wrap.querySelector<HTMLElement>('[data-jpop-panel]');
      if (!trigger || !panel) return;

      let hoverTimer: number | undefined;

      const open = () => setOpen(wrap, true);
      const close = () => setOpen(wrap, false);
      const toggle = () => (isOpen(wrap) ? close() : open());

      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        toggle();
      });

      const matchesPointerFine = window.matchMedia('(pointer: fine)').matches;
      if (matchesPointerFine) {
        wrap.addEventListener('mouseenter', () => {
          window.clearTimeout(hoverTimer);
          hoverTimer = window.setTimeout(open, 80);
        });
        wrap.addEventListener('mouseleave', () => {
          window.clearTimeout(hoverTimer);
          hoverTimer = window.setTimeout(close, 160);
        });
      }

      wrap.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen(wrap)) {
          e.preventDefault();
          close();
          trigger.focus();
          return;
        }
        if (!isOpen(wrap)) return;
        const items = Array.from(panel.querySelectorAll<HTMLElement>('[role="menuitem"]'));
        if (items.length === 0) return;
        const idx = items.indexOf(document.activeElement as HTMLElement);
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          e.preventDefault();
          const next = items[(idx + 1 + items.length) % items.length] ?? items[0];
          next.focus();
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const prev = items[(idx - 1 + items.length) % items.length] ?? items[items.length - 1];
          prev.focus();
        } else if (e.key === 'Home') {
          e.preventDefault();
          items[0]?.focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          items[items.length - 1]?.focus();
        }
      });

      document.addEventListener('click', (e) => {
        if (!isOpen(wrap)) return;
        if (wrap.contains(e.target as Node)) return;
        close();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>

<style>
  .jpop {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .jpop__trigger {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--color-text-muted);
    font-family: var(--font-code);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: color 150ms ease;
  }
  .jpop__trigger:hover,
  .jpop__trigger:focus-visible,
  .jpop.is-open .jpop__trigger {
    color: var(--color-text);
    outline: none;
  }
  .jpop__chevron {
    font-size: 0.75rem;
    transition: transform 200ms ease;
  }
  .jpop.is-open .jpop__chevron {
    transform: translateY(1px) rotate(180deg);
    color: var(--color-primary);
  }

  .jpop__panel {
    position: absolute;
    top: calc(100% + 0.625rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 80;
    min-width: 32rem;
    max-width: min(48rem, calc(100vw - 2rem));
    border-radius: 1rem;
    background: var(--fx-card-bg);
    border: 1px solid var(--fx-card-border);
    box-shadow: var(--fx-card-shadow-hover);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    overflow: hidden;
    opacity: 0;
    transform: translate(-50%, -6px);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .jpop.is-open .jpop__panel[hidden] { display: block; }
  .jpop.is-open .jpop__panel {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  @media (prefers-reduced-motion: reduce) {
    .jpop__panel { transition: none; }
  }

  .jpop__panel-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
  }
  .jpop__head { display: flex; flex-direction: column; gap: 0.25rem; }
  .jpop__eyebrow {
    margin: 0;
    font-family: var(--font-code);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
  }
  .jpop__lede {
    margin: 0;
    color: var(--color-text);
    font-size: 0.9375rem;
  }

  /* Thin top line — single inline row above the grid. No card chrome.
     Reads as a quiet utility link, not a peer of the People/Stacks tiles. */
  .jpop__topline {
    display: inline-flex;
    align-items: baseline;
    gap: 0.625rem;
    padding: 0.125rem 0;
    margin-bottom: -0.25rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.8125rem;
    line-height: 1.3;
    transition: color 120ms ease;
  }
  .jpop__topline:hover,
  .jpop__topline:focus-visible {
    color: var(--color-text);
    outline: none;
  }
  .jpop__topline-label {
    font-family: var(--font-code);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    flex: 0 0 auto;
  }
  .jpop__topline-desc {
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  .jpop__topline-arrow {
    font-family: var(--font-code);
    color: var(--color-text-muted);
    flex: 0 0 auto;
    transition: transform 150ms ease, color 150ms ease;
  }
  .jpop__topline:hover .jpop__topline-arrow,
  .jpop__topline:focus-visible .jpop__topline-arrow {
    color: var(--color-primary);
    transform: translateX(2px);
  }

  .jpop__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .jpop__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.625rem;
    padding: 0.625rem 0.75rem;
    border-radius: 0.625rem;
    color: var(--color-text);
    text-decoration: none;
    border: 1px solid transparent;
    transition: background 120ms ease, border-color 120ms ease, transform 120ms ease;
  }
  .jpop__item:hover,
  .jpop__item:focus-visible {
    background: color-mix(in srgb, var(--color-primary) 8%, var(--color-surface));
    border-color: var(--color-border);
    outline: none;
  }
  .jpop__item-icon {
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--color-primary);
    flex-shrink: 0;
  }
  .jpop__item-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .jpop__item-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-text);
  }
  .jpop__item-desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 720px) {
    .jpop__panel {
      position: fixed;
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      transform: none;
      max-width: 100%;
      min-width: 0;
      border-radius: 1rem 1rem 0 0;
    }
    .jpop.is-open .jpop__panel { transform: none; }
    .jpop__grid { grid-template-columns: 1fr; }
  }
</style>
