---
// Scroll-snap deck container with keyboard nav and reveal-on-intersect.
// Each child <section> becomes a slide.
//
// Keyboard:
//   ↓ / Space / PageDown → next section
//   ↑ / Shift+Space / PageUp → previous section
//   Home → first; End → last
//   F → toggle fullscreen
//   C → toggle chrome
//   Esc → exit fullscreen / restore chrome
//
// Reveal: any descendant with [data-reveal] gains .is-visible when it enters
// the viewport. Use --delay (ms) for stagger.
//
// Mode-safe: composes the site's two-tier token system + three-mode runtime
// from theme.css. Toggling mode at the site level retints the deck live.

import BoilerPlateHTML from "./BoilerPlateHTML.astro";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  themeClass?: string;
  /** Optional chrome (header) rendered above the scroll container. */
  hideChrome?: boolean;
}

const {
  title = "FullStack VC · Deck",
  description = "Section-composed deck for the Agentic VC Dojo.",
  noindex = true,
  themeClass = "theme-default",
  hideChrome = false,
} = Astro.props;
---

<BoilerPlateHTML
  title={title}
  description={description}
  noindex={noindex}
  themeClass={themeClass}
>
  <div class="deck-root" data-deck-root>
    {!hideChrome && (
      <header class="deck-chrome" data-deck-chrome>
        <slot name="chrome">
          <a href="/sessions" class="deck-chrome__back">← All sessions</a>
          <span class="deck-chrome__title">{title}</span>
          <span class="deck-chrome__spacer" aria-hidden="true"></span>
        </slot>
      </header>
    )}

    <main class="deck-scroll" data-deck-scroll tabindex="0">
      <slot />
    </main>

    <aside class="deck-counter" aria-label="Slide position">
      <span data-deck-current>1</span><span class="deck-counter__sep">/</span><span data-deck-total>?</span>
    </aside>

    <button
      type="button"
      class="deck-jump-trigger"
      data-deck-jump-trigger
      aria-controls="deck-jump-panel"
      aria-expanded="false"
      aria-label="Jump to a slide"
      title="Jump to a slide"
    >
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M2 3h12M2 8h12M2 13h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/>
      </svg>
      <span class="deck-jump-trigger__label">Jump</span>
    </button>

    <aside
      id="deck-jump-panel"
      class="deck-jump-panel"
      data-deck-jump-panel
      aria-label="Slide index"
      hidden
    >
      <header class="deck-jump-panel__head">
        <h2 class="deck-jump-panel__title">Jump to a slide</h2>
        <button type="button" class="deck-jump-panel__close" data-deck-jump-close aria-label="Close slide index">×</button>
      </header>
      <ol class="deck-jump-panel__list" data-deck-jump-list></ol>
    </aside>

    <nav class="deck-controls" aria-hidden="true">
      <span class="deck-controls__hint">↑↓ navigate · F fullscreen · C chrome · J jump · Esc reset</span>
    </nav>
  </div>

  <script>
    import "../utils/theme-switcher.js";
    import "../utils/mode-switcher.js";

    // Wait for DOM ready
    function init() {
      const scroll = document.querySelector<HTMLElement>("[data-deck-scroll]");
      const chrome = document.querySelector<HTMLElement>("[data-deck-chrome]");
      const root = document.querySelector<HTMLElement>("[data-deck-root]");
      const currentEl = document.querySelector<HTMLElement>("[data-deck-current]");
      const totalEl = document.querySelector<HTMLElement>("[data-deck-total]");

      if (!scroll) return;

      const sections = Array.from(scroll.querySelectorAll<HTMLElement>(":scope > section"));
      if (sections.length === 0) return;

      if (totalEl) totalEl.textContent = String(sections.length);

      let activeIndex = 0;

      // Track which section is centered in viewport
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting && entry.intersectionRatio > 0.5) {
              const idx = sections.indexOf(entry.target as HTMLElement);
              if (idx !== -1) {
                activeIndex = idx;
                if (currentEl) currentEl.textContent = String(idx + 1);
                entry.target.classList.add("is-active");
                refreshActiveJumpItem();
              }
            } else {
              entry.target.classList.remove("is-active");
            }
          }
        },
        { root: scroll, threshold: [0.5, 0.75] }
      );
      sections.forEach((s) => io.observe(s));

      // Reveal-on-intersect for [data-reveal]
      const revealIo = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealIo.unobserve(entry.target);
            }
          }
        },
        { root: scroll, threshold: 0.2 }
      );
      scroll
        .querySelectorAll<HTMLElement>("[data-reveal]")
        .forEach((el) => revealIo.observe(el));

      // Keyboard nav
      function go(delta: number) {
        const next = Math.max(0, Math.min(sections.length - 1, activeIndex + delta));
        sections[next]?.scrollIntoView({ behavior: "smooth", block: "start" });
      }
      function goTo(idx: number) {
        const target = Math.max(0, Math.min(sections.length - 1, idx));
        sections[target]?.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      // ── Jump panel: titles list + open/close ─────────────────────────────
      const jumpTrigger = document.querySelector<HTMLButtonElement>("[data-deck-jump-trigger]");
      const jumpPanel = document.querySelector<HTMLElement>("[data-deck-jump-panel]");
      const jumpList = document.querySelector<HTMLElement>("[data-deck-jump-list]");
      const jumpClose = document.querySelector<HTMLButtonElement>("[data-deck-jump-close]");

      function deriveSlideTitle(section: HTMLElement): string {
        // Order of precedence:
        //   1. data-slide-title attribute (explicit author control)
        //   2. .slide-eyebrow text (the orienting label)
        //   3. .slide-headline text (the big title)
        //   4. fallback "Slide N"
        const explicit = section.dataset.slideTitle?.trim();
        if (explicit) return explicit;
        const eyebrow = section.querySelector<HTMLElement>(".slide-eyebrow");
        if (eyebrow?.textContent?.trim()) return eyebrow.textContent.trim();
        const headline = section.querySelector<HTMLElement>(".slide-headline");
        if (headline?.textContent?.trim()) {
          // Strip aggressive whitespace + truncate to a reasonable jump-list length.
          const t = headline.textContent.trim().replace(/\s+/g, " ");
          return t.length > 80 ? t.slice(0, 77) + "…" : t;
        }
        return `Slide ${sections.indexOf(section) + 1}`;
      }

      function populateJumpList() {
        if (!jumpList) return;
        jumpList.innerHTML = "";
        sections.forEach((section, idx) => {
          const li = document.createElement("li");
          li.className = "deck-jump-item";
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "deck-jump-item__btn";
          btn.dataset.index = String(idx);
          btn.innerHTML = `
            <span class="deck-jump-item__title">${deriveSlideTitle(section).replace(/[<>&"]/g, (c) => ({"<":"&lt;",">":"&gt;","&":"&amp;",'"':"&quot;"}[c]!))}</span>
            <span class="deck-jump-item__num">${idx + 1}</span>
          `;
          btn.addEventListener("click", () => {
            goTo(idx);
            closeJumpPanel();
          });
          li.appendChild(btn);
          jumpList.appendChild(li);
        });
      }

      function refreshActiveJumpItem() {
        if (!jumpList) return;
        jumpList.querySelectorAll<HTMLElement>(".deck-jump-item__btn").forEach((btn, i) => {
          btn.classList.toggle("is-active", i === activeIndex);
        });
      }

      function openJumpPanel() {
        if (!jumpPanel || !jumpTrigger) return;
        populateJumpList();
        refreshActiveJumpItem();
        jumpPanel.hidden = false;
        jumpPanel.classList.add("is-open");
        jumpTrigger.setAttribute("aria-expanded", "true");
        // Focus the active item if present, else the first item.
        const target = jumpList?.querySelector<HTMLElement>(".deck-jump-item__btn.is-active")
          ?? jumpList?.querySelector<HTMLElement>(".deck-jump-item__btn");
        target?.focus({ preventScroll: true });
      }

      function closeJumpPanel() {
        if (!jumpPanel || !jumpTrigger) return;
        jumpPanel.classList.remove("is-open");
        jumpPanel.hidden = true;
        jumpTrigger.setAttribute("aria-expanded", "false");
        jumpTrigger.focus({ preventScroll: true });
      }

      function isJumpOpen(): boolean {
        return !!jumpPanel && !jumpPanel.hidden;
      }

      jumpTrigger?.addEventListener("click", () => {
        if (isJumpOpen()) closeJumpPanel();
        else openJumpPanel();
      });
      jumpClose?.addEventListener("click", closeJumpPanel);
      // Click outside the panel closes it.
      document.addEventListener("click", (e) => {
        if (!isJumpOpen()) return;
        const target = e.target as Node;
        if (jumpPanel?.contains(target)) return;
        if (jumpTrigger?.contains(target)) return;
        closeJumpPanel();
      });

      function isInputFocused(): boolean {
        const el = document.activeElement;
        if (!el) return false;
        const tag = el.tagName;
        return tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || (el as HTMLElement).isContentEditable;
      }

      window.addEventListener("keydown", (e) => {
        if (isInputFocused()) return;
        // If the jump panel is open, restrict to closing it on Escape and
        // letting native button focus + Enter handle item selection.
        if (isJumpOpen()) {
          if (e.key === "Escape") {
            e.preventDefault();
            closeJumpPanel();
          }
          return;
        }
        switch (e.key) {
          case "ArrowDown":
          case "PageDown":
            e.preventDefault();
            go(1);
            break;
          case " ":
            e.preventDefault();
            go(e.shiftKey ? -1 : 1);
            break;
          case "ArrowUp":
          case "PageUp":
            e.preventDefault();
            go(-1);
            break;
          case "Home":
            e.preventDefault();
            goTo(0);
            break;
          case "End":
            e.preventDefault();
            goTo(sections.length - 1);
            break;
          case "f":
          case "F":
            e.preventDefault();
            if (document.fullscreenElement) {
              document.exitFullscreen();
            } else {
              root?.requestFullscreen();
            }
            break;
          case "c":
          case "C":
            e.preventDefault();
            root?.classList.toggle("chrome-hidden");
            break;
          case "j":
          case "J":
            e.preventDefault();
            openJumpPanel();
            break;
          case "Escape":
            if (document.fullscreenElement) document.exitFullscreen();
            root?.classList.remove("chrome-hidden");
            break;
        }
      });

      // Double-click navigation: top half = prev, bottom half = next
      scroll.addEventListener("dblclick", (e) => {
        const rect = scroll.getBoundingClientRect();
        if (e.clientY < rect.top + rect.height / 2) {
          go(-1);
        } else {
          go(1);
        }
      });

      // Focus scroll container so PageUp/PageDown work without prior click
      scroll.focus({ preventScroll: true });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  </script>

  <style is:global>
    /* ── Root: full-viewport flex column ────────────────────────────────── */
    .deck-root {
      height: 100vh;
      display: flex;
      flex-direction: column;
      background: var(--color-bg);
      color: var(--color-text);
    }

    /* ── Chrome: thin top header ────────────────────────────────────────── */
    .deck-chrome {
      flex: 0 0 auto;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 1rem;
      padding: 0.625rem 1.25rem;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-bg);
      font-family: var(--font-code, system-ui);
      font-size: 0.8125rem;
      letter-spacing: 0.04em;
      color: var(--color-text-muted);
      z-index: 10;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .deck-root.chrome-hidden .deck-chrome {
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
    }
    .deck-chrome__back {
      color: var(--color-text-muted);
      text-decoration: none;
    }
    .deck-chrome__back:hover {
      color: var(--color-primary);
    }
    .deck-chrome__title {
      text-align: center;
      color: var(--color-text);
      font-family: var(--font-display, system-ui);
      font-size: 0.875rem;
    }
    .deck-chrome__spacer {
      /* Keep the 3-column grid balanced after moving the counter out */
      width: 7rem;
    }

    /* Slide counter — separate from chrome so toggling C keeps it visible.
       Top-right so it visually pairs with the chrome header but survives
       the chrome toggle. */
    .deck-counter {
      position: fixed;
      top: 0.625rem;
      right: 1rem;
      display: inline-flex;
      align-items: baseline;
      gap: 0.125rem;
      padding: 0.375rem 0.75rem;
      background: color-mix(in srgb, var(--color-bg) 95%, transparent);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      font-family: var(--font-code, system-ui);
      font-size: 0.9375rem;
      font-weight: 700;
      color: var(--color-accent);
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.04em;
      z-index: 11;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      box-shadow: 0 2px 8px -2px rgba(0, 0, 0, 0.25);
      pointer-events: none;
    }
    .deck-counter__sep {
      opacity: 0.45;
      margin: 0 0.125rem;
      color: var(--color-text-muted);
      font-weight: 400;
    }
    .deck-counter [data-deck-total] {
      color: var(--color-text-muted);
      font-weight: 400;
    }

    /* Jump trigger — small button below the counter, always visible.
       Same pattern as the counter (top-right, survives chrome toggle). */
    .deck-jump-trigger {
      position: fixed;
      top: calc(0.625rem + 2.5rem); /* under the counter */
      right: 1rem;
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.375rem 0.625rem;
      background: color-mix(in srgb, var(--color-bg) 95%, transparent);
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
      font-family: var(--font-code, system-ui);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: var(--color-text);
      cursor: pointer;
      z-index: 11;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      box-shadow: 0 2px 8px -2px rgba(0, 0, 0, 0.25);
      transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
    }
    .deck-jump-trigger:hover,
    .deck-jump-trigger:focus-visible {
      border-color: var(--color-accent);
      color: var(--color-accent);
      outline: none;
      transform: translateY(-1px);
    }
    .deck-jump-trigger[aria-expanded="true"] {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
    .deck-jump-trigger svg {
      width: 0.875rem;
      height: 0.875rem;
    }
    .deck-jump-trigger__label {
      text-transform: uppercase;
    }

    /* Jump panel — slides in from the right, full height. */
    .deck-jump-panel {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(360px, 90vw);
      background: var(--color-bg);
      border-left: 1px solid var(--color-border);
      box-shadow: -8px 0 32px -8px rgba(0, 0, 0, 0.35);
      z-index: 100;
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform 0.2s ease;
    }
    .deck-jump-panel.is-open {
      transform: translateX(0);
    }
    .deck-jump-panel[hidden] {
      display: none;
    }
    .deck-jump-panel__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--color-border);
    }
    .deck-jump-panel__title {
      font-family: var(--font-display, system-ui);
      font-size: 0.9375rem;
      font-weight: 700;
      color: var(--color-text);
      margin: 0;
    }
    .deck-jump-panel__close {
      width: 1.75rem;
      height: 1.75rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 1px solid var(--color-border);
      border-radius: 0.375rem;
      color: var(--color-text-muted);
      font-size: 1.25rem;
      line-height: 1;
      cursor: pointer;
      transition: color 0.15s ease, border-color 0.15s ease;
    }
    .deck-jump-panel__close:hover {
      color: var(--color-accent);
      border-color: var(--color-accent);
    }
    .deck-jump-panel__list {
      list-style: none;
      padding: 0.5rem;
      margin: 0;
      flex: 1 1 auto;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
    }

    .deck-jump-item {
      display: block;
    }
    .deck-jump-item__btn {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 0.75rem;
      width: 100%;
      padding: 0.625rem 0.875rem;
      background: transparent;
      border: 1px solid transparent;
      border-radius: 0.375rem;
      color: var(--color-text);
      font-family: inherit;
      font-size: 0.875rem;
      text-align: left;
      cursor: pointer;
      transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }
    .deck-jump-item__btn:hover,
    .deck-jump-item__btn:focus-visible {
      background: var(--fx-card-bg);
      border-color: var(--color-border);
      outline: none;
    }
    .deck-jump-item__btn.is-active {
      background: color-mix(in srgb, var(--color-accent) 12%, transparent);
      border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
      color: var(--color-accent);
    }
    .deck-jump-item__title {
      line-height: 1.35;
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .deck-jump-item__num {
      font-family: var(--font-code, system-ui);
      font-size: 0.75rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      color: var(--color-text-muted);
      padding: 0.125rem 0.5rem;
      border: 1px solid var(--color-border);
      border-radius: 0.25rem;
      min-width: 2rem;
      text-align: center;
    }
    .deck-jump-item__btn.is-active .deck-jump-item__num {
      color: var(--color-accent);
      border-color: color-mix(in srgb, var(--color-accent) 50%, var(--color-border));
    }

    /* ── Scroll container: snap each section ─────────────────────────────── */
    .deck-scroll {
      flex: 1 1 auto;
      overflow-y: scroll;
      scroll-snap-type: y mandatory;
      scroll-behavior: smooth;
      outline: none;
    }
    .deck-scroll > section {
      scroll-snap-align: start;
      scroll-snap-stop: always;
      min-height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 4rem clamp(1.5rem, 5vw, 5rem);
      position: relative;
    }

    /* ── Controls hint: bottom-right ─────────────────────────────────────── */
    .deck-controls {
      position: fixed;
      bottom: 0.75rem;
      right: 1rem;
      font-family: var(--font-code, system-ui);
      font-size: 0.6875rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-text-muted);
      opacity: 0.5;
      pointer-events: none;
      z-index: 10;
      transition: opacity 0.2s ease;
    }
    .deck-controls:hover { opacity: 1; }
    .deck-root.chrome-hidden .deck-controls { opacity: 0; }

    /* ── Reveal-on-intersect ──────────────────────────────────────────────── */
    [data-reveal] {
      opacity: 0;
      transform: translateY(12px);
      transition: opacity 0.5s ease-out, transform 0.5s ease-out;
      transition-delay: var(--delay, 0ms);
    }
    [data-reveal].is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      [data-reveal] {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }

    /* ── Slide typography helpers (deck-scoped, compose theme.css tokens) ── */
    .slide-eyebrow {
      font-family: var(--font-code, system-ui);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--color-accent);
      margin: 0 0 1.25rem;
    }
    .slide-headline {
      font-family: var(--font-display, system-ui);
      font-size: clamp(2rem, 5.5vw, 4.5rem);
      font-weight: 700;
      line-height: 1.05;
      color: var(--color-text);
      margin: 0 0 1.5rem;
      max-width: 30ch;
    }
    .slide-subhead {
      font-family: var(--font-display, system-ui);
      font-size: clamp(1.125rem, 2.2vw, 1.625rem);
      font-weight: 400;
      line-height: 1.4;
      color: var(--color-text-muted);
      margin: 0 0 2rem;
      max-width: 60ch;
    }
    .slide-body {
      font-size: clamp(1rem, 1.4vw, 1.125rem);
      line-height: 1.6;
      color: var(--color-text);
      max-width: 65ch;
    }
    .slide-caption {
      font-family: var(--font-code, system-ui);
      font-size: 0.875rem;
      color: var(--color-text-muted);
      letter-spacing: 0.02em;
    }
    .slide-footnote {
      font-family: var(--font-code, system-ui);
      font-size: 0.75rem;
      color: var(--color-text-muted);
      letter-spacing: 0.05em;
      position: absolute;
      bottom: 1.5rem;
      left: clamp(1.5rem, 5vw, 5rem);
      right: clamp(1.5rem, 5vw, 5rem);
      display: flex;
      justify-content: space-between;
      gap: 1rem;
    }
  </style>
</BoilerPlateHTML>
