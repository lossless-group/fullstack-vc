---
import { Font } from 'astro:assets';
import Analytics from '../components/Analytics.astro';

export interface Props {
  title?: string;
  description?: string;
  themeClass?: string;
  favicon?: string;
  noindex?: boolean;
  /**
   * Path to the OG/Twitter card image, relative to the site root (e.g. `/og-default.png`).
   * Resolved against `Astro.site` to produce the absolute URL social platforms require.
   * Generate the default image with `pnpm --filter fullstack-vc gen:og`.
   */
  image?: string;
  ogType?: 'website' | 'article';
}

const {
  title = "FullStack VC",
  description = "Agentic VC Dojo — a learning community for venture capitalists building with AI.",
  themeClass = "theme-default",
  favicon = "/favicon.svg",
  noindex = false,
  image = "/og-default.jpg",
  ogType = "website",
} = Astro.props;

// Social platforms require absolute URLs. Astro.site is set in astro.config.mjs;
// fall back to the request origin so dev previews still emit valid tags.
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.origin;
const ogImage = new URL(image, siteOrigin + '/').toString();
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin + '/').toString();
---

<!DOCTYPE html>
<html lang="en" class={themeClass}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" href={favicon} type="image/svg+xml" />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Astro Fonts API — emits @font-face + the --font__* CSS variables
       that theme.css's semantic tokens reference. Above-the-fold fonts
       (Inter, Space Grotesk) are preloaded; mono is lazy. -->
  <Font cssVariable="--font__inter" preload />
  <Font cssVariable="--font__space-grotesk" preload />
  <Font cssVariable="--font__jetbrains-mono" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:secure_url" content={ogImage} />
  <meta property="og:image:type" content={ogImage.endsWith('.png') ? 'image/png' : 'image/jpeg'} />
  <meta property="og:image:width" content="1280" />
  <meta property="og:image:height" content="720" />
  <meta property="og:site_name" content="FullStack VC" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Pre-paint mode application to avoid FOUC -->
  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem('mode');
        var valid = ['light', 'dark', 'vibrant'];
        var mode = valid.indexOf(stored) >= 0 ? stored : 'dark';
        document.documentElement.setAttribute('data-mode', mode);
        if (mode === 'dark' || mode === 'vibrant') {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {
        document.documentElement.setAttribute('data-mode', 'dark');
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <Analytics />
</head>
<body>
  <slot />
</body>
</html>
