---
import { Font } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import { SITE_CARD_KEY, shareKeyForPath } from '../lib/share-cards';

export interface Props {
  title?: string;
  description?: string;
  themeClass?: string;
  favicon?: string;
  noindex?: boolean;
  /**
   * Share card key (src/lib/share-cards.ts). Omit it: a page's key is its own
   * URL path, and pages without a card get the universal site card. Pass it
   * only where the path isn't the key (the /s/ section share pages).
   */
  shareKey?: string;
  /** @deprecated Share images now come from the build-time cards; ignored. */
  image?: string;
  /** @deprecated See `image`. */
  imageWidth?: number;
  /** @deprecated See `image`. */
  imageHeight?: number;
  ogType?: 'website' | 'article';
}

const {
  title = "FullStack VC",
  description = "Agentic VC Dojo — a learning community for venture capitalists building with AI.",
  themeClass = "theme-default",
  favicon = "/favicon.svg",
  noindex = false,
  shareKey,
  ogType = "website",
} = Astro.props;

// Social platforms require absolute URLs. Astro.site is set in astro.config.mjs;
// fall back to the request origin so dev previews still emit valid tags.
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? Astro.url.origin;
// Share images (blueprint: Share-Every-Page-and-Section-With-Its-Own-OG-Image):
// one og:image, the tall 3:4 card chat apps show large; the wide card goes in
// twitter:image only. Never two og:image tags. The site card keeps the
// hand-made illustration as its wide image.
const cardKey = shareKey ?? await shareKeyForPath(Astro.url.pathname);
const ogImage = new URL(`/og/tall/${cardKey}.jpg`, siteOrigin + '/').toString();
const twitterImage = new URL(cardKey === SITE_CARD_KEY ? '/og-default.jpg' : `/og/wide/${cardKey}.jpg`, siteOrigin + '/').toString();
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin + '/').toString();
---

<!DOCTYPE html>
<html lang="en" class={themeClass}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" href={favicon} type="image/svg+xml" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  <link
    rel="alternate"
    type="text/markdown"
    href="/llms.txt"
    title="llms.txt for this site"
  />

  <!-- Astro Fonts API — emits @font-face + the --font__* CSS variables
       that theme.css's semantic tokens reference. Above-the-fold fonts
       (Inter, Space Grotesk) are preloaded; mono is lazy. -->
  <Font cssVariable="--font__inter" preload />
  <Font cssVariable="--font__space-grotesk" preload />
  <Font cssVariable="--font__jetbrains-mono" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:secure_url" content={ogImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1080" />
  <meta property="og:image:height" content="1440" />
  <meta property="og:image:alt" content={title} />
  <meta property="og:site_name" content="FullStack VC" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={twitterImage} />
  <meta name="twitter:image:alt" content={title} />

  <!-- Pre-paint mode application to avoid FOUC -->
  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem('mode');
        var valid = ['light', 'dark', 'vibrant'];
        var mode = valid.indexOf(stored) >= 0 ? stored : 'dark';
        document.documentElement.setAttribute('data-mode', mode);
        if (mode === 'dark' || mode === 'vibrant') {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {
        document.documentElement.setAttribute('data-mode', 'dark');
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
  <Analytics />
</head>
<body>
  <slot />
</body>
</html>
