---
import BoilerPlateHTML from './BoilerPlateHTML.astro';
import Header from '../components/basics/Header.astro';
import Footer from '../components/basics/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  themeClass?: string;
  noindex?: boolean;
  containerClass?: string;
  hideChrome?: boolean;
  /** Override the OG/Twitter card image for this page (path from site root). */
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  themeClass = 'theme-default',
  noindex = false,
  containerClass = '',
  hideChrome = false,
  image,
  imageWidth,
  imageHeight,
  ogType,
} = Astro.props;
---

<BoilerPlateHTML
  title={title}
  description={description}
  themeClass={themeClass}
  noindex={noindex}
  image={image}
  imageWidth={imageWidth}
  imageHeight={imageHeight}
  ogType={ogType}
>
  <div class="min-h-screen flex flex-col">
    {!hideChrome && <Header />}
    <main class={`flex-1 ${containerClass}`}>
      <slot />
    </main>
    {!hideChrome && <Footer />}
  </div>

  <!-- Boot the switchers — no-op on SSR, hydrates client-side -->
  <script>
    import '../utils/theme-switcher.js';
    import '../utils/mode-switcher.js';
  </script>
</BoilerPlateHTML>
