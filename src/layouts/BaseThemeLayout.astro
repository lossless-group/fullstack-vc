---
import BoilerPlateHTML from './BoilerPlateHTML.astro';
import Header from '../components/basics/Header.astro';
import Footer from '../components/basics/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  themeClass?: string;
  noindex?: boolean;
  containerClass?: string;
  hideChrome?: boolean;
  /** Override the OG/Twitter card image for this page (path from site root). */
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  themeClass = 'theme-default',
  noindex = false,
  containerClass = '',
  hideChrome = false,
  image,
  imageWidth,
  imageHeight,
  ogType,
} = Astro.props;
---

<BoilerPlateHTML
  title={title}
  description={description}
  themeClass={themeClass}
  noindex={noindex}
  image={image}
  imageWidth={imageWidth}
  imageHeight={imageHeight}
  ogType={ogType}
>
  <div class="min-h-screen flex flex-col">
    {!hideChrome && <Header />}
    {/* `w-full min-w-0` is load-bearing, not decorative.
        Callers pass `mx-auto` in containerClass to centre the column — but an
        auto cross-axis margin on a flex item DISABLES `align-items: stretch`,
        so <main> stopped filling its parent and sized to fit-content instead,
        growing to its max-content width. Measured: 637px <main> inside a 500px
        viewport, with html/body/wrapper all correctly at 500 and nothing
        inside main exceeding its content box.
        `w-full` restores a definite width; `max-w-*` still caps it and
        `mx-auto` still centres it once there's free space. `min-w-0` covers the
        separate flex case where a wide descendant refuses to shrink. */}
    <main class={`flex-1 w-full min-w-0 ${containerClass}`}>
      <slot />
    </main>
    {!hideChrome && <Footer />}
  </div>

  <!-- Boot the switchers — no-op on SSR, hydrates client-side -->
  <script>
    import '../utils/theme-switcher.js';
    import '../utils/mode-switcher.js';
  </script>
</BoilerPlateHTML>
