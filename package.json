{
  "name": "fullstack-vc",
  "type": "module",
  "version": "0.0.4",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --remote",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "gen:banners": "node --experimental-strip-types --env-file=.env scripts/generate-changelog-banners.ts",
    "gen:og": "node --experimental-strip-types --env-file=.env scripts/generate-og-image.ts",
    "gen:content-banners": "node --experimental-strip-types --env-file=.env scripts/generate-content-banners-on-dir.ts",
    "gen:webinar-survey": "node --experimental-strip-types scripts/build-webinar-survey.ts",
    "sync:session": "astro db execute scripts/sync-session.ts",
    "seed:production": "astro db execute scripts/seed-production.ts --remote",
    "seed:test": "astro db execute scripts/seed-test-session.ts --remote",
    "set-poll-status": "astro db execute scripts/set-poll-status.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/db": "^0.21.0",
    "@astrojs/svelte": "^8.0.5",
    "@astrojs/vercel": "^10.0.5",
    "@lossless-group/lfm": "npm:@jsr/lossless-group__lfm@^0.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.7",
    "jose": "^6.2.2",
    "mdast-util-to-string": "^4.0.0",
    "svelte": "^5.55.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0"
  }
}
