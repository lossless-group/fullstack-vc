# ============================================================================
# fullstack-vc env template — copy to .env and fill in. .env is gitignored.
# Vercel: same names go into Project Settings → Environment Variables.
# ============================================================================

# JWT signing secret for the OAuth session cookie.
# Generate with: openssl rand -base64 32
JWT_SIGNING_SECRET=

# GitHub OAuth App — for "Log in with GitHub" user identity.
# Created at https://github.com/organizations/lossless-group/settings/applications
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# LinkedIn OAuth App — for "Log in with LinkedIn" user identity.
# Created at https://www.linkedin.com/developers/apps
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=

# GitHub App — for the bot that commits stack files.
# Created at https://github.com/organizations/lossless-group/settings/apps
# Required permissions: Contents: Read and write. Install on `fullstack-vc` only.
# (Client ID / Client Secret are NOT used — they're for user-OAuth flows on
#  the App, which we don't run. App Auth uses the App ID + Private Key.)
GITHUB_STACKS_APP_ID=
GITHUB_STACKS_INSTALLATION_ID=
# Paste the entire PEM, including BEGIN/END markers. Newlines may be literal
# \n in some env-var UIs; the lib normalizes those before signing.
GITHUB_STACKS_PRIVATE_KEY=

# Optional fallback: a fine-grained PAT with Contents: read+write on the repo.
# Used only if the GitHub App credentials above are not all set.
# GITHUB_BOT_TOKEN=

# Optional: target a non-main branch for stack commits during dev so the
# launch surface doesn't pollute main. Defaults to "main" if unset.
# GITHUB_TARGET_BRANCH=stack-update-test

# Optional overrides — usually left at defaults.
# GITHUB_REPO_OWNER=lossless-group
# GITHUB_REPO_NAME=fullstack-vc
